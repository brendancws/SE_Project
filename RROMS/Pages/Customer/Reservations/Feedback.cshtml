@page "{id:int}"
@model RROMS.Pages.Customer.Reservations.FeedbackModel
@{
    ViewData["Title"] = "Dining Feedback";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Dining Feedback</h2>
            <p class="text-muted mb-0">
                Share feedback about your completed dining experience.
            </p>
        </div>

        <a asp-page="/Customer/Reservations/Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">
            @Model.BookingReference
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Reservation Date
                    </small>

                    <strong>
                        @Model.ReservationDate.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Reservation Time
                    </small>

                    <strong>
                        @Model.ReservationTime.ToString(@"hh\:mm")
                    </strong>
                </div>

                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Table
                    </small>

                    <strong>@Model.TableNumber</strong>
                </div>
            </div>
        </div>
    </div>

    @if (Model.AlreadySubmitted)
    {
        <div class="alert alert-success">
            Feedback has already been submitted for this reservation.
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="h5 mb-3">Your Feedback</h3>

                <p class="mb-2">
                    <strong>Rating:</strong>
                    @Model.ExistingRating / 5
                </p>

                <p class="mb-2">
                    <strong>Submitted:</strong>
                    @(Model.ExistingSubmittedAt?.ToString(
                        "dd MMM yyyy, HH:mm") ?? "-")
                </p>

                <p class="mb-0">
                    <strong>Comment:</strong>
                    @(string.IsNullOrWhiteSpace(Model.ExistingComment)
                        ? "No written comment."
                        : Model.ExistingComment)
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                Rate Your Experience
            </div>

            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <fieldset class="mb-4">
                        <legend class="form-label fw-semibold">
                            Overall Rating
                        </legend>

                        <div class="rating-options">
                            @for (int rating = 1; rating <= 5; rating++)
                            {
                                string ratingId = $"rating-{rating}";

                                <div class="form-check form-check-inline">
                                    <input asp-for="Rating"
                                           class="form-check-input"
                                           type="radio"
                                           value="@rating"
                                           id="@ratingId" />

                                    <label class="form-check-label"
                                           for="@ratingId">
                                        @rating ★
                                    </label>
                                </div>
                            }
                        </div>

                        <span asp-validation-for="Rating"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            1 star means poor and 5 stars means excellent.
                        </div>
                    </fieldset>

                    <div class="mb-3">
                        <label asp-for="Comment"
                               class="form-label fw-semibold">
                            Comment
                            <span class="text-muted fw-normal">
                                (optional)
                            </span>
                        </label>

                        <textarea asp-for="Comment"
                                  class="form-control"
                                  rows="5"
                                  maxlength="1000"
                                  placeholder="Tell us about the food, service, or overall dining experience.">
                        </textarea>

                        <div class="d-flex justify-content-between mt-1">
                            <span asp-validation-for="Comment"
                                  class="text-danger small">
                            </span>

                            <span class="text-muted small">
                                Maximum 1,000 characters
                            </span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Submit Feedback
                        </button>

                        <a asp-page="/Customer/Reservations/Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<style>
    .rating-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rating-options .form-check {
        margin: 0;
        padding: 10px 14px 10px 36px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: white;
    }

    .rating-options .form-check:has(input:checked) {
        border-color: #f59e0b;
        background: #fffbeb;
    }

    .rating-options label {
        cursor: pointer;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}