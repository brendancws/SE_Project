@page
@model RROMS.Pages.Customer.Reservations.IndexModel
@{
    ViewData["Title"] = "My Reservations";

    int totalReservations =
        Model.MyReservations.Count;

    int activeReservations =
        Model.MyReservations.Count(reservation =>
            Model.CanCancel(reservation));

    int confirmedReservations =
        Model.MyReservations.Count(reservation =>
            string.Equals(
                reservation.Status,
                "Confirmed",
                StringComparison.OrdinalIgnoreCase));

    int cancelledReservations =
        Model.MyReservations.Count(reservation =>
            string.Equals(
                reservation.Status,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase));
}

<div class="container py-4">
<header class="reservations-header">
    <div>
        <span class="reservations-eyebrow">
            Dining Reservations
        </span>

        <h1>My Reservations</h1>

        <p>
            Manage upcoming visits, track confirmation updates,
            and review your previous bookings.
        </p>
    </div>

    <a asp-page="/Customer/Reservations/Create"
       class="book-table-button">
        <span aria-hidden="true">+</span>
        Book a Table
    </a>
</header>

<section class="reservation-summary-grid"
         aria-label="Reservation overview">

    <article class="reservation-summary-card">
        <span class="summary-label">
            Total Bookings
        </span>

        <strong>@totalReservations</strong>

        <small>
            All reservation records
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Active Bookings
        </span>

        <strong>@activeReservations</strong>

        <small>
            Upcoming and editable
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Confirmed
        </span>

        <strong>@confirmedReservations</strong>

        <small>
            Confirmed by the restaurant
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Cancelled
        </span>

        <strong>@cancelledReservations</strong>

        <small>
            Cancelled reservations
        </small>
    </article>
</section>

    <div class="card border-0 bg-light mb-4 no-print">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold">
                    Live reservation tracking:
                </span>

                <span class="text-success">
                    On
                </span>

                <span class="text-muted small ms-2">
                    Last checked:
                    <span id="lastReservationStatusCheck">
                        Not checked yet
                    </span>
                </span>
            </div>

            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    onclick="window.location.reload()">
                Refresh Full Page
            </button>
        </div>

        <div id="reservationStatusChangeNotice"
             class="alert alert-info mt-3 mb-0 d-none"
             role="status">
            <strong>Reservation status updated.</strong>
            Refresh the full page to update table details
            and available actions.

            <button type="button"
                    class="btn btn-sm btn-primary ms-2"
                    onclick="window.location.reload()">
                Refresh Full Page
            </button>
        </div>

        <div id="reservationStatusPollingError"
             class="alert alert-warning mt-3 mb-0 d-none"
             role="status">
            Live reservation updates are temporarily unavailable.
            Use Refresh Full Page to check the latest information.
        </div>
    </div>
</div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @Model.StatusMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["FeedbackMessage"] is string feedbackMessage &&
     !string.IsNullOrWhiteSpace(feedbackMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @feedbackMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.MyReservations.Any())
    {
        <div class="alert alert-info">
            You have no reservations yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Table</th>
                            <th>Guests</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reservation in Model.MyReservations)
                        {
                            string badgeClass =
                                (reservation.Status ?? "Pending")
                                .ToLowerInvariant() switch
                                {
                                    "confirmed" => "bg-success",
                                    "pending" => "bg-warning text-dark",
                                    "cancelled" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                            <tr data-reservation-id="@reservation.ReservationID"
    data-current-status="@(reservation.Status ?? "Pending")">
                                <td>
                                    @reservation.Date.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @reservation.Time.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    @(reservation.Table?.TableNumber ?? "-")
                                </td>

                                <td>
                                    @reservation.NumberOfGuests
                                </td>

                                <td>
                                    <span class="badge @badgeClass reservation-status-badge">
    @(reservation.Status ?? "Pending")
</span>

<div class="reservation-status-explanation small mt-1">
    @switch ((reservation.Status ?? "Pending").ToLowerInvariant())
    {
        case "confirmed":
            <span class="text-success">
                Reservation confirmed.
            </span>
            break;

        case "cancelled":
            <span class="text-danger">
                Reservation cancelled.
            </span>
            break;

        default:
            <span class="text-muted">
                Awaiting staff confirmation.
            </span>
            break;
    }
</div>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-page="/Customer/Reservations/Confirmation"
                                           asp-route-id="@reservation.ReservationID"
                                           class="btn btn-sm btn-outline-secondary">
                                            Confirmation
                                        </a>

                                        @if (Model.CanLeaveFeedback(reservation))
{
    <a asp-page="/Customer/Reservations/Feedback"
       asp-route-id="@reservation.ReservationID"
       class="btn btn-sm btn-outline-success">
        Leave Feedback
    </a>
}
else if (Model.HasSubmittedFeedback(reservation))
{
    <a asp-page="/Customer/Reservations/Feedback"
       asp-route-id="@reservation.ReservationID"
       class="btn btn-sm btn-outline-success">
        View Feedback
    </a>
}

                                        @if (Model.CanCancel(reservation))
                                        {
                                            <a asp-page="/Customer/Reservations/Edit"
                                               asp-route-id="@reservation.ReservationID"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form id="cancelReservationForm-@reservation.ReservationID"
                                                  method="post"
                                                  asp-page-handler="Cancel"
                                                  asp-route-id="@reservation.ReservationID">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#cancelReservationModal-@reservation.ReservationID">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>

                                    @if (Model.CanCancel(reservation))
                                    {
                                        <div class="modal fade"
                                             id="cancelReservationModal-@reservation.ReservationID"
                                             tabindex="-1"
                                             aria-labelledby="cancelReservationModalLabel-@reservation.ReservationID"
                                             aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title"
                                                            id="cancelReservationModalLabel-@reservation.ReservationID">
                                                            Cancel reservation
                                                        </h5>

                                                        <button type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal"
                                                                aria-label="Close">
                                                        </button>
                                                    </div>

                                                    <div class="modal-body">
                                                        Cancel this reservation on
                                                        @reservation.Date.ToString("dd MMM yyyy")
                                                        at
                                                        @reservation.Time.ToString(@"hh\:mm")?
                                                    </div>

                                                    <div class="modal-footer">
                                                        <button type="button"
                                                                class="btn btn-outline-secondary"
                                                                data-bs-dismiss="modal">
                                                            Keep reservation
                                                        </button>

                                                        <button type="submit"
                                                                class="btn btn-danger"
                                                                form="cancelReservationForm-@reservation.ReservationID">
                                                            Yes, cancel reservation
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .reservations-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .reservations-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #d97706;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .reservations-header h1 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 32px;
        font-weight: 800;
    }

    .reservations-header p {
        max-width: 700px;
        margin: 0;
        color: #6b7280;
        line-height: 1.55;
    }

    .book-table-button {
        min-height: 44px;
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 10px 17px;
        border: 1px solid #f59e0b;
        border-radius: 10px;
        color: #111827;
        background: #f59e0b;
        font-weight: 750;
        text-decoration: none;
    }

    .book-table-button:hover {
        border-color: #d97706;
        color: white;
        background: #d97706;
    }

    .book-table-button span {
        font-size: 20px;
        line-height: 1;
    }

    .reservation-summary-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .reservation-summary-card {
        min-width: 0;
        padding: 19px;
        border: 1px solid #e5e7eb;
        border-radius: 15px;
        background: white;
        box-shadow:
            0 8px 22px rgba(31, 41, 55, 0.05);
    }

    .reservation-summary-card span,
    .reservation-summary-card strong,
    .reservation-summary-card small {
        display: block;
    }

    .summary-label {
        margin-bottom: 6px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .reservation-summary-card strong {
        color: #111827;
        font-size: 25px;
        font-weight: 800;
    }

    .reservation-summary-card small {
        margin-top: 4px;
        color: #9ca3af;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 1100px) {
        .reservation-summary-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .reservations-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .book-table-button {
            width: 100%;
        }

        .reservation-summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

    @section Scripts {
    <script>
        (function () {
            const lastCheckElement =
                document.getElementById(
                    "lastReservationStatusCheck"
                );

            const changeNotice =
                document.getElementById(
                    "reservationStatusChangeNotice"
                );

            const pollingError =
                document.getElementById(
                    "reservationStatusPollingError"
                );

            function badgeClassFor(status) {
                switch ((status || "").toLowerCase()) {
                    case "confirmed":
                        return "bg-success";
                    case "pending":
                        return "bg-warning text-dark";
                    case "cancelled":
                        return "bg-danger";
                    default:
                        return "bg-secondary";
                }
            }

            function explanationFor(status) {
                switch ((status || "").toLowerCase()) {
                    case "confirmed":
                        return {
                            text: "Reservation confirmed.",
                            className: "text-success"
                        };

                    case "cancelled":
                        return {
                            text: "Reservation cancelled.",
                            className: "text-danger"
                        };

                    default:
                        return {
                            text: "Awaiting staff confirmation.",
                            className: "text-muted"
                        };
                }
            }

            function updateReservationRow(
                row,
                newStatus
            ) {
                const oldStatus =
                    row.dataset.currentStatus;

                const badge =
                    row.querySelector(
                        ".reservation-status-badge"
                    );

                const explanationContainer =
                    row.querySelector(
                        ".reservation-status-explanation"
                    );

                badge.textContent = newStatus;

                badge.className =
                    "badge reservation-status-badge " +
                    badgeClassFor(newStatus);

                const explanation =
                    explanationFor(newStatus);

                explanationContainer.innerHTML =
                    '<span class="' +
                    explanation.className +
                    '">' +
                    explanation.text +
                    '</span>';

                row.dataset.currentStatus = newStatus;

                return oldStatus !== newStatus;
            }

            async function pollReservationStatuses() {
                try {
                    const response = await fetch(
                        "?handler=Statuses",
                        {
                            headers: {
                                "Accept": "application/json"
                            },
                            cache: "no-store"
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            "Reservation status request failed."
                        );
                    }

                    const statuses =
                        await response.json();

                    let anyChanged = false;

                    statuses.forEach(function (item) {
                        const row =
                            document.querySelector(
                                '[data-reservation-id="' +
                                item.reservationId +
                                '"]'
                            );

                        if (!row) {
                            return;
                        }

                        if (updateReservationRow(
                            row,
                            item.status
                        )) {
                            anyChanged = true;
                        }
                    });

                    lastCheckElement.textContent =
                        new Date()
                            .toLocaleTimeString();

                    pollingError.classList.add("d-none");

                    if (anyChanged) {
                        changeNotice.classList.remove(
                            "d-none"
                        );
                    }
                } catch (error) {
                    pollingError.classList.remove(
                        "d-none"
                    );
                }
            }

            pollReservationStatuses();

            window.setInterval(
                pollReservationStatuses,
                10000
            );
        })();
    </script>
}