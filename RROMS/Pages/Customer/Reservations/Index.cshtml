@page
@model RROMS.Pages.Customer.Reservations.IndexModel
@{
    ViewData["Title"] = "My Reservations";

    int totalReservations =
        Model.MyReservations.Count;

    int activeReservations =
        Model.MyReservations.Count(reservation =>
            Model.CanCancel(reservation));

    int confirmedReservations =
        Model.MyReservations.Count(reservation =>
            string.Equals(
                reservation.Status,
                "Confirmed",
                StringComparison.OrdinalIgnoreCase));

    int cancelledReservations =
        Model.MyReservations.Count(reservation =>
            string.Equals(
                reservation.Status,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase));
}

<div class="container py-4">
<header class="reservations-header">
    <div>
        <span class="reservations-eyebrow">
            Dining Reservations
        </span>

        <h1>My Reservations</h1>

        <p>
            Manage upcoming visits, track confirmation updates,
            and review your previous bookings.
        </p>
    </div>

    <a asp-page="/Customer/Reservations/Create"
       class="book-table-button">
        <span aria-hidden="true">+</span>
        Book a Table
    </a>
</header>

<section class="reservation-summary-grid"
         aria-label="Reservation overview">

    <article class="reservation-summary-card">
        <span class="summary-label">
            Total Bookings
        </span>

        <strong>@totalReservations</strong>

        <small>
            All reservation records
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Active Bookings
        </span>

        <strong>@activeReservations</strong>

        <small>
            Upcoming and editable
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Confirmed
        </span>

        <strong>@confirmedReservations</strong>

        <small>
            Confirmed by the restaurant
        </small>
    </article>

    <article class="reservation-summary-card">
        <span class="summary-label">
            Cancelled
        </span>

        <strong>@cancelledReservations</strong>

        <small>
            Cancelled reservations
        </small>
    </article>
</section>

    <div class="card border-0 bg-light mb-4 no-print">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold">
                    Live reservation tracking:
                </span>

                <span class="text-success">
                    On
                </span>

                <span class="text-muted small ms-2">
                    Last checked:
                    <span id="lastReservationStatusCheck">
                        Not checked yet
                    </span>
                </span>
            </div>

            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    onclick="window.location.reload()">
                Refresh Full Page
            </button>
        </div>

        <div id="reservationStatusChangeNotice"
             class="alert alert-info mt-3 mb-0 d-none"
             role="status">
            <strong>Reservation status updated.</strong>
            Refresh the full page to update reservation details
and available actions.

            <button type="button"
                    class="btn btn-sm btn-primary ms-2"
                    onclick="window.location.reload()">
                Refresh Full Page
            </button>
        </div>

        <div id="reservationStatusPollingError"
             class="alert alert-warning mt-3 mb-0 d-none"
             role="status">
            Live reservation updates are temporarily unavailable.
            Use Refresh Full Page to check the latest information.
        </div>
    </div>
</div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @Model.StatusMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["FeedbackMessage"] is string feedbackMessage &&
     !string.IsNullOrWhiteSpace(feedbackMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @feedbackMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.MyReservations.Any())
{
    <section class="reservations-empty-state">
        <div class="empty-reservation-icon" aria-hidden="true">
            🍽️
        </div>

        <h2>No reservations yet</h2>

        <p>
            Your upcoming table reservations will appear here.
            Book your first table to start planning your visit.
        </p>

        <a asp-page="/Customer/Reservations/Create"
           class="book-table-button">
            <span aria-hidden="true">+</span>
            Book a Table
        </a>
    </section>
}
    else
    {
    <section class="reservation-list-section">
        <div class="reservation-list-heading">
            <div>
                <span class="reservations-eyebrow">
                    Booking History
                </span>

                <h2>Your Reservations</h2>
            </div>

            <span class="reservation-count">
                @totalReservations
                @(totalReservations == 1 ? "booking" : "bookings")
            </span>
        </div>

        <div class="reservation-card-list">
            @foreach (var reservation in Model.MyReservations)
            {
                string status =
                    reservation.Status ?? "Pending";

                string statusClass =
                    status.ToLowerInvariant() switch
                    {
                        "confirmed" => "confirmed",
                        "pending" => "pending",
                        "cancelled" => "cancelled",
                        _ => "other"
                    };

                string statusExplanation =
                    status.ToLowerInvariant() switch
                    {
                        "confirmed" =>
                            "Your table has been confirmed.",

                        "cancelled" =>
                            "This reservation was cancelled.",

                        _ =>
                            "Awaiting confirmation from the restaurant."
                    };

                string explanationClass =
                    status.ToLowerInvariant() switch
                    {
                        "confirmed" => "text-success",
                        "cancelled" => "text-danger",
                        _ => "text-muted"
                    };

                <article class="reservation-card"
                         data-reservation-id="@reservation.ReservationID"
                         data-current-status="@status">

                    <div class="reservation-date-block">
                        <strong>
                            @reservation.Date.ToString("dd")
                        </strong>

                        <span>
                            @reservation.Date.ToString("MMM")
                        </span>
                    </div>

                    <div class="reservation-card-content">
                        <div class="reservation-card-top">
                            <div>
                                <span class="reservation-reference">
                                    RESERVATION #@reservation.ReservationID
                                </span>

                                <h3>
                                    @reservation.Date.ToString("dddd, dd MMMM yyyy")
                                </h3>
                            </div>

                            <div class="reservation-status-area">
                                <span class="status-pill @statusClass reservation-status-badge">
                                    @status
                                </span>

                                <div class="reservation-status-explanation @explanationClass">
                                    @statusExplanation
                                </div>
                            </div>
                        </div>

                        <div class="reservation-details-grid">
                            <div class="reservation-detail">
                                <span class="detail-label">
                                    Time
                                </span>

                                <strong>
                                    @reservation.Time.ToString(@"hh\:mm")
                                </strong>
                            </div>

                            <div class="reservation-detail">
                                <span class="detail-label">
                                    Table
                                </span>

                                <strong>
                                    @(reservation.Table?.TableNumber ?? "-")
                                </strong>
                            </div>

                            <div class="reservation-detail">
                                <span class="detail-label">
                                    Guests
                                </span>

                                <strong>
                                    @reservation.NumberOfGuests
                                </strong>
                            </div>

                            <div class="reservation-detail">
                                <span class="detail-label">
                                    Reference
                                </span>

                                <strong>
                                    #@reservation.ReservationID
                                </strong>
                            </div>
                        </div>

                        <div class="reservation-card-actions">
                            <a asp-page="/Customer/Reservations/Confirmation"
                               asp-route-id="@reservation.ReservationID"
                               class="reservation-action confirmation">
                                Confirmation
                            </a>

                            @if (Model.CanLeaveFeedback(reservation))
                            {
                                <a asp-page="/Customer/Reservations/Feedback"
                                   asp-route-id="@reservation.ReservationID"
                                   class="reservation-action feedback">
                                    Leave Feedback
                                </a>
                            }
                            else if (Model.HasSubmittedFeedback(reservation))
                            {
                                <a asp-page="/Customer/Reservations/Feedback"
                                   asp-route-id="@reservation.ReservationID"
                                   class="reservation-action feedback">
                                    View Feedback
                                </a>
                            }

                            @if (Model.CanCancel(reservation))
                            {
                                <a asp-page="/Customer/Reservations/Edit"
                                   asp-route-id="@reservation.ReservationID"
                                   class="reservation-action edit">
                                    Edit
                                </a>

                                <form id="cancelReservationForm-@reservation.ReservationID"
                                      method="post"
                                      asp-page-handler="Cancel"
                                      asp-route-id="@reservation.ReservationID">

                                    <button type="button"
                                            class="reservation-action cancel"
                                            data-bs-toggle="modal"
                                            data-bs-target="#cancelReservationModal-@reservation.ReservationID">
                                        Cancel
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    @if (Model.CanCancel(reservation))
                    {
                        <div class="modal fade"
                             id="cancelReservationModal-@reservation.ReservationID"
                             tabindex="-1"
                             aria-labelledby="cancelReservationModalLabel-@reservation.ReservationID"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content text-start">
                                    <div class="modal-header">
                                        <h5 class="modal-title"
                                            id="cancelReservationModalLabel-@reservation.ReservationID">
                                            Cancel reservation
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close">
                                        </button>
                                    </div>

                                    <div class="modal-body">
                                        Cancel this reservation on
                                        @reservation.Date.ToString("dd MMM yyyy")
                                        at
                                        @reservation.Time.ToString(@"hh\:mm")?
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                data-bs-dismiss="modal">
                                            Keep reservation
                                        </button>

                                        <button type="submit"
                                                class="btn btn-danger"
                                                form="cancelReservationForm-@reservation.ReservationID">
                                            Yes, cancel reservation
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}
</div>

