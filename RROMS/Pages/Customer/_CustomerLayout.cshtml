@{
    string currentPage =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dineflow</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
    :root {
        --customer-navy-950: #111827;
        --customer-navy-900: #182333;
        --customer-navy-800: #1f2937;
        --customer-navy-700: #374151;
        --customer-amber-500: #f59e0b;
        --customer-amber-600: #d97706;
        --customer-page: #f4f6f8;
        --customer-surface: #ffffff;
        --customer-border: #e5e7eb;
        --customer-text: #111827;
        --customer-muted: #6b7280;
        --customer-danger: #dc3545;
        --customer-sidebar-width: 250px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        min-height: 100%;
    }

    body {
        min-height: 100vh;
        margin: 0;
        background: var(--customer-page);
        color: var(--customer-text);
        font-family:
            "Segoe UI",
            Arial,
            Helvetica,
            sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    a,
    button,
    input,
    select,
    textarea {
        transition:
            color 0.18s ease,
            background-color 0.18s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease,
            transform 0.18s ease;
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
        outline: 3px solid rgba(245, 158, 11, 0.3);
        outline-offset: 2px;
    }

    .customer-wrapper {
        display: flex;
        min-height: 100vh;
    }

    .customer-sidebar {
        position: fixed;
        inset: 0 auto 0 0;
        z-index: 1000;
        width: var(--customer-sidebar-width);
        padding: 28px 18px 22px;
        overflow-y: auto;
        color: white;
        background:
            linear-gradient(
                180deg,
                var(--customer-navy-900) 0%,
                var(--customer-navy-800) 100%
            );
        box-shadow: 8px 0 30px rgba(17, 24, 39, 0.08);
    }

    .customer-logo {
        padding: 0 10px;
        margin-bottom: 30px;
        color: white;
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .customer-logo span {
        color: var(--customer-amber-500);
    }

    .customer-nav {
        display: flex;
        min-height: calc(100vh - 92px);
        flex-direction: column;
    }

    .customer-nav a,
    .customer-logout-btn {
        display: flex;
        width: 100%;
        min-height: 46px;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        margin-bottom: 6px;
        border: 1px solid transparent;
        border-radius: 11px;
        color: #d1d5db;
        background: transparent;
        font-family: inherit;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.2;
        text-align: left;
        text-decoration: none;
    }

    .customer-nav a:hover,
    .customer-logout-btn:hover {
        color: white;
        background: rgba(255, 255, 255, 0.08);
    }

    .customer-nav a.active {
        color: #111827;
        background: var(--customer-amber-500);
        box-shadow: 0 8px 18px rgba(245, 158, 11, 0.18);
        font-weight: 700;
    }

    .customer-nav a span,
    .customer-logout-btn span {
        width: 20px;
        display: inline-flex;
        flex: 0 0 20px;
        justify-content: center;
        font-size: 16px;
    }

    .customer-nav-divider {
        margin: 16px 0;
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        opacity: 1;
    }

    .customer-logout-form {
        margin-top: auto;
    }

    .customer-logout-btn {
        border: none;
        cursor: pointer;
    }

    .customer-main {
        width: calc(100% - var(--customer-sidebar-width));
        min-width: 0;
        margin-left: var(--customer-sidebar-width);
    }

    .customer-topbar {
        position: sticky;
        top: 0;
        z-index: 900;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 12px 32px;
        border-bottom: 1px solid var(--customer-border);
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 4px 18px rgba(31, 41, 55, 0.035);
        backdrop-filter: blur(10px);
    }

    .customer-topbar-title {
        color: var(--customer-navy-900);
        font-weight: 750;
    }

    .customer-page-content {
        width: 100%;
        max-width: 1680px;
        padding: 30px;
        margin: 0 auto;
    }

    .topbar-account-area {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .notification-bell-link {
        position: relative;
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--customer-border);
        border-radius: 50%;
        color: var(--customer-navy-700);
        background: #f9fafb;
        text-decoration: none;
    }

    .notification-bell-link:hover {
        border-color: #fcd34d;
        color: var(--customer-navy-950);
        background: #fff7ed;
        transform: translateY(-1px);
    }

    .notification-bell-icon {
        font-size: 19px;
        line-height: 1;
    }

    .notification-count-badge {
        position: absolute;
        top: -5px;
        right: -6px;
        min-width: 20px;
        height: 20px;
        padding: 0 5px;
        border: 2px solid white;
        border-radius: 999px;
        color: white;
        background: var(--customer-danger);
        font-size: 11px;
        font-weight: 800;
        line-height: 16px;
        text-align: center;
    }

    .notification-count-badge.d-none {
        display: none !important;
    }

    .profile-area {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .profile-area small {
        color: var(--customer-muted) !important;
        font-size: 12px;
    }

    .profile-area strong {
        display: inline-block;
        max-width: 190px;
        color: var(--customer-text);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .profile-circle {
        width: 40px;
        height: 40px;
        display: flex;
        flex: 0 0 40px;
        align-items: center;
        justify-content: center;
        border: 2px solid #f3f4f6;
        border-radius: 50%;
        color: white;
        background: var(--customer-navy-900);
        font-weight: 800;
    }

    .customer-page-content .card {
        border-color: var(--customer-border);
        border-radius: 16px;
    }

    .customer-page-content .shadow-sm,
    .customer-page-content .shadow {
        box-shadow: 0 8px 24px rgba(31, 41, 55, 0.06) !important;
    }

    .customer-page-content .form-control,
    .customer-page-content .form-select {
        min-height: 42px;
        border-color: #d1d5db;
        border-radius: 9px;
    }

    .customer-page-content textarea.form-control {
        min-height: auto;
    }

    .customer-page-content .form-control:focus,
    .customer-page-content .form-select:focus {
        border-color: var(--customer-amber-500);
        box-shadow: 0 0 0 0.2rem rgba(245, 158, 11, 0.14);
    }

    .customer-page-content .btn {
        border-radius: 9px;
        font-weight: 650;
    }

    .customer-page-content .table {
        margin-bottom: 0;
    }

    .customer-page-content .table thead th {
        color: #4b5563;
        background: #f9fafb;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .customer-page-content .table td,
    .customer-page-content .table th {
        vertical-align: middle;
    }

    .customer-page-content .alert {
        border-radius: 12px;
    }

    .customer-page-content .badge {
        padding: 0.45em 0.7em;
        border-radius: 999px;
        font-weight: 700;
    }

    .text-danger ul,
    .alert-danger ul {
        padding-left: 0;
        margin-bottom: 0;
        list-style: none;
    }

    @@media (max-width: 1100px) {
        :root {
            --customer-sidebar-width: 220px;
        }

        .customer-page-content {
            padding: 24px;
        }
    }

    @@media (max-width: 800px) {
        :root {
            --customer-sidebar-width: 190px;
        }

        .customer-sidebar {
            padding-right: 12px;
            padding-left: 12px;
        }

        .customer-topbar {
            padding-right: 20px;
            padding-left: 20px;
        }

        .customer-page-content {
            padding: 20px;
        }

        .profile-area > div:first-child {
            display: none;
        }
    }
</style>
</head>

<body>

    <div class="customer-wrapper">

        <aside class="customer-sidebar">

            <div class="customer-logo">
                Dine<span>flow</span>
            </div>

            <nav class="customer-nav">

                <a asp-page="/Customer/Dashboard/Index"
   class="@(currentPage.StartsWith("/Customer/Dashboard")
       ? "active" : "")">
                    <span aria-hidden="true">🏠</span>
                    Home
                </a>

                <a asp-page="/Customer/Menu/Index"
   class="@(currentPage.StartsWith("/Customer/Menu")
       ? "active" : "")">
                    <span aria-hidden="true">📖</span>
                    Menu
                </a>

                <a asp-page="/Customer/Reservations/Index"
   class="@(currentPage.StartsWith("/Customer/Reservations")
       ? "active" : "")">
                    <span aria-hidden="true">📅</span>
                    My Reservations
                </a>

                <a asp-page="/Customer/Orders/Index"
   class="@(currentPage.StartsWith("/Customer/Orders")
       ? "active" : "")">
                    <span aria-hidden="true">🍽️</span>
                    My Orders
                </a>

                <a asp-page="/Customer/History/Index"
   class="@(currentPage.StartsWith("/Customer/History")
       ? "active" : "")">
                    <span aria-hidden="true">🧾</span>
                    History
                </a>

                <a asp-page="/Customer/Help/Index"
   class="@(currentPage.StartsWith("/Customer/Help")
       ? "active" : "")">
    <span aria-hidden="true">💬</span>
    Help Assistant
</a>

                <a asp-page="/Customer/Profile/Index"
   class="@(currentPage.StartsWith("/Customer/Profile")
       ? "active" : "")">
                    <span aria-hidden="true">👤</span>
                    Profile
                </a>

                <hr class="customer-nav-divider" />

                <form method="post"
      asp-page="/Customer/Logout"
      class="customer-logout-form">
    <button type="submit"
            class="customer-logout-btn">
        <span aria-hidden="true">🚪</span>
        Logout
    </button>
</form>

            </nav>

        </aside>

        <main class="customer-main">

            <div class="customer-topbar">

                <div class="customer-topbar-title">
    Customer Portal
</div>

                <div class="topbar-account-area">
    <a asp-page="/Customer/Notifications/Index"
       class="notification-bell-link"
       aria-label="View notifications"
       title="Notifications">

        <span class="notification-bell-icon"
              aria-hidden="true">
            🔔
        </span>

        <span id="customerNotificationCount"
              class="notification-count-badge d-none"
              aria-label="No unread notifications">
            0
        </span>
    </a>

    <div class="profile-area">
        <div>
            <small class="text-muted">
                Signed in as
            </small>
            <br />

            <strong>
                @(User.Identity?.Name ?? "Customer")
            </strong>
        </div>

        @{
            var displayName = User.Identity?.Name;
            var initial = string.IsNullOrWhiteSpace(displayName)
                ? "C"
                : displayName.Trim()
                    .Substring(0, 1)
                    .ToUpperInvariant();
        }

        <div class="profile-circle">
            @initial
        </div>
    </div>
</div>

            </div>

            <div class="customer-page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (function () {
        const badge =
            document.getElementById(
                "customerNotificationCount"
            );

        if (!badge) {
            return;
        }

        async function updateNotificationCount() {
            try {
                const response = await fetch(
                    "/Customer/Notifications/Index?handler=UnreadCount",
                    {
                        headers: {
                            "Accept": "application/json"
                        },
                        cache: "no-store"
                    }
                );

                if (!response.ok) {
                    return;
                }

                const result = await response.json();
                const count =
                    Number(result.unreadCount) || 0;

                if (count <= 0) {
                    badge.textContent = "0";
                    badge.classList.add("d-none");

                    badge.setAttribute(
                        "aria-label",
                        "No unread notifications"
                    );

                    return;
                }

                badge.textContent =
                    count > 99
                        ? "99+"
                        : count.toString();

                badge.classList.remove("d-none");

                badge.setAttribute(
                    "aria-label",
                    count === 1
                        ? "1 unread notification"
                        : count + " unread notifications"
                );
            }
            catch (error) {
                // Preserve the last displayed count if polling fails.
            }
        }

        updateNotificationCount();

        window.setInterval(
            updateNotificationCount,
            30000
        );
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
