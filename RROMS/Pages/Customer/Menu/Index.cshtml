@page
@model RROMS.Pages.Customer.Menu.IndexModel
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Menu";

    var categories = Model.MenuItems
        .GroupBy(item => new
        {
            item.CategoryID,
            CategoryName =
                item.Category?.CategoryName ?? "Uncategorised"
        })
        .OrderBy(group => group.Key.CategoryName)
        .ToList();

    int availableCount =
        Model.MenuItems.Count(item =>
            item.Availability == true);
}

<div class="menu-page">
    <section class="menu-hero">
        <div>
            <span class="menu-eyebrow">
                Dineflow Menu
            </span>

            <h1>Discover your next favourite dish</h1>

            <p>
                Explore freshly prepared dishes, refreshing drinks,
                and restaurant favourites available to order.
            </p>

            <div class="menu-hero-meta">
                <span>
                    @Model.MenuItems.Count menu items
                </span>

                <span aria-hidden="true">•</span>

                <span>
                    @availableCount currently available
                </span>
            </div>
        </div>

        <a asp-page="/Customer/Cart/Index"
           class="menu-cart-button">
            <span aria-hidden="true">🛒</span>

            <span>
                <strong>View Cart</strong>
                <small>
                    @Model.CartItemCount
                    @(Model.CartItemCount == 1 ? "item" : "items")
                </small>
            </span>
        </a>
    </section>

    @if (TempData["CartMessage"] is string cartMessage &&
         !string.IsNullOrWhiteSpace(cartMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <strong>Added to cart.</strong>
            @cartMessage

            <a asp-page="/Customer/Cart/Index"
               class="alert-link ms-2">
                View Cart (@Model.CartItemCount)
            </a>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["CartError"] is string cartError &&
         !string.IsNullOrWhiteSpace(cartError))
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <strong>Unable to update cart.</strong>
            @cartError

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.MenuItems.Any())
    {
        <section class="menu-empty-state">
            <div class="menu-empty-icon"
                 aria-hidden="true">
                🍽️
            </div>

            <h2>Our menu is being prepared</h2>

            <p>
                No dishes are available to display right now.
                Please check again later.
            </p>
        </section>
    }
    else
    {
        <nav class="category-navigation"
             aria-label="Menu categories">
            <span class="category-navigation-label">
                Browse by category
            </span>

            <div class="category-chip-list">
                @foreach (var category in categories)
                {
                    string categoryAnchor =
                        $"category-{category.Key.CategoryID}";

                    <a href="#@categoryAnchor"
                       class="category-chip">
                        @category.Key.CategoryName

                        <span>
                            @category.Count()
                        </span>
                    </a>
                }
            </div>
        </nav>

        <div class="menu-category-list">
            @foreach (var category in categories)
            {
                string categoryAnchor =
                    $"category-{category.Key.CategoryID}";

                var categoryInfo =
                    category.FirstOrDefault()?.Category;

                <section id="@categoryAnchor"
                         class="menu-category-section">
                    <div class="category-heading">
                        <div>
                            <span class="category-kicker">
                                Menu Category
                            </span>

                            <h2>
                                @category.Key.CategoryName
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(
                                categoryInfo?.Description))
                            {
                                <p>
                                    @categoryInfo.Description
                                </p>
                            }
                        </div>

                        <span class="category-count">
                            @category.Count()
                            @(category.Count() == 1
                                ? "item"
                                : "items")
                        </span>
                    </div>

                    <div class="menu-grid">
                        @foreach (var item in category)
                        {
                            bool isAvailable =
                                item.Availability == true;

                            <article id="menu-item-@item.MenuItemID"
                                     class="menu-item-card @(isAvailable ? "" : "unavailable-item")"
                                     data-menu-item-card>
                                <div class="menu-item-visual">
                                    @if (!string.IsNullOrWhiteSpace(
                                        item.ImageURL))
                                    {
                                        <img src="@item.ImageURL"
                                             alt="@item.Name"
                                             class="menu-item-image"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                        <div class="menu-image-placeholder"
                                             style="display:none;"
                                             aria-hidden="true">
                                            <span>
                                                @GetMenuInitials(item.Name)
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="menu-image-placeholder"
                                             aria-hidden="true">
                                            <span>
                                                @GetMenuInitials(item.Name)
                                            </span>
                                        </div>
                                    }

                                    <div class="availability-overlay">
                                        @if (item.Availability == true)
                                        {
                                            <span class="availability-pill available">
                                                Available
                                            </span>
                                        }
                                        else if (item.Availability == false)
                                        {
                                            <span class="availability-pill unavailable">
                                                Unavailable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="availability-pill unknown">
                                                Availability pending
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="menu-item-content">
                                    <div class="menu-item-heading">
                                        <h3>@item.Name</h3>

                                        <strong class="menu-price">
                                            RM
                                            @item.Price.ToString(
                                                "0.00",
                                                CultureInfo.InvariantCulture)
                                        </strong>
                                    </div>

                                    <p class="menu-description">
                                        @(string.IsNullOrWhiteSpace(
                                            item.Description)
                                            ? "A Dineflow restaurant selection."
                                            : item.Description)
                                    </p>

                                    <div class="menu-item-footer">
                                        @if (isAvailable)
                                        {
                                            <form method="post"
                                                  asp-page="/Customer/Cart/Index"
                                                  asp-page-handler="Add"
                                                  class="add-to-cart-form js-add-to-cart-form">
                                                <input type="hidden"
                                                       name="menuItemId"
                                                       value="@item.MenuItemID" />

                                                <div class="quantity-control">
                                                    <label for="quantity-@item.MenuItemID">
                                                        Qty
                                                    </label>

                                                    <input id="quantity-@item.MenuItemID"
                                                           type="number"
                                                           name="quantity"
                                                           value="1"
                                                           min="1"
                                                           max="20"
                                                           inputmode="numeric"
                                                           class="form-control" />
                                                </div>

                                                <button type="submit"
                                                        class="add-cart-button">
                                                    <span aria-hidden="true">
                                                        +
                                                    </span>

                                                    Add to Cart
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="unavailable-message">
                                                <span aria-hidden="true">
                                                    ⓘ
                                                </span>

                                                This item cannot currently be ordered.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@functions {
    private static string GetMenuInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "DF";
        }

        string[] words = name
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(0, Math.Min(2, words[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(
            words.Take(2)
                .Select(word =>
                    char.ToUpperInvariant(word[0])));
    }
}

<style>
    html {
        scroll-behavior: smooth;
    }

    .menu-page {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .menu-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        padding: 36px 40px;
        border-radius: 22px;
        color: white;
        background:
            radial-gradient(
                circle at 90% 20%,
                rgba(245, 158, 11, 0.32),
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #111827 0%,
                #1f2937 62%,
                #4b3b2a 100%
            );
        box-shadow:
            0 18px 42px rgba(31, 41, 55, 0.14);
    }

    .menu-eyebrow,
    .category-kicker {
        display: block;
        margin-bottom: 8px;
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .menu-hero h1 {
        max-width: 720px;
        margin: 0 0 12px;
        font-size: 35px;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .menu-hero p {
        max-width: 720px;
        margin: 0;
        color: #d1d5db;
        line-height: 1.65;
    }

    .menu-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 18px;
        color: #f3f4f6;
        font-size: 14px;
    }

    .menu-cart-button {
        display: flex;
        min-width: 180px;
        align-items: center;
        gap: 13px;
        padding: 14px 18px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 14px;
        color: #111827;
        background: #f59e0b;
        box-shadow:
            0 12px 28px rgba(245, 158, 11, 0.2);
        text-decoration: none;
    }

    .menu-cart-button:hover {
        color: #111827;
        background: #fbbf24;
        transform: translateY(-2px);
    }

    .menu-cart-button > span:first-child {
        font-size: 25px;
    }

    .menu-cart-button strong,
    .menu-cart-button small {
        display: block;
    }

    .menu-cart-button small {
        margin-top: 2px;
        color: #78350f;
        font-size: 12px;
    }

    .category-navigation {
        position: sticky;
        top: 84px;
        z-index: 100;
        padding: 17px 20px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.97);
        box-shadow:
            0 8px 24px rgba(31, 41, 55, 0.06);
        backdrop-filter: blur(8px);
    }

    .category-navigation-label {
        display: block;
        margin-bottom: 10px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .category-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .category-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        color: #374151;
        background: #f9fafb;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
    }

    .category-chip:hover {
        border-color: #f59e0b;
        color: #92400e;
        background: #fff7ed;
    }

    .category-chip span {
        min-width: 21px;
        padding: 2px 6px;
        border-radius: 999px;
        color: #92400e;
        background: #fef3c7;
        font-size: 11px;
        text-align: center;
    }

    .menu-category-list {
        display: flex;
        flex-direction: column;
        gap: 44px;
    }

    .menu-category-section {
        scroll-margin-top: 165px;
    }

    .category-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .category-heading h2 {
        margin: 0;
        color: #111827;
        font-size: 25px;
        font-weight: 800;
    }

    .category-heading p {
        max-width: 760px;
        margin: 7px 0 0;
        color: #6b7280;
    }

    .category-count {
        padding: 7px 12px;
        border-radius: 999px;
        color: #4b5563;
        background: #e5e7eb;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .menu-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .menu-item-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: white;
        box-shadow:
            0 9px 26px rgba(31, 41, 55, 0.06);
        transition:
            transform 0.18s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .menu-item-card:hover {
        transform: translateY(-3px);
        border-color: #fcd34d;
        box-shadow:
            0 16px 34px rgba(31, 41, 55, 0.1);
    }

    .menu-item-card.unavailable-item {
        opacity: 0.74;
    }

    .menu-item-card.unavailable-item:hover {
        transform: none;
        border-color: #e5e7eb;
        box-shadow:
            0 9px 26px rgba(31, 41, 55, 0.06);
    }

    .menu-item-visual {
        position: relative;
        height: 180px;
        overflow: hidden;
        background:
            linear-gradient(
                135deg,
                #fff7ed 0%,
                #fef3c7 100%
            );
    }

    .menu-item-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .menu-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #92400e;
        background:
            radial-gradient(
                circle at 28% 22%,
                rgba(255, 255, 255, 0.9),
                transparent 26%
            ),
            linear-gradient(
                135deg,
                #ffedd5 0%,
                #fde68a 100%
            );
    }

    .menu-image-placeholder span {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(146, 64, 14, 0.16);
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.62);
        font-size: 24px;
        font-weight: 850;
        letter-spacing: 0.04em;
    }

    .availability-overlay {
        position: absolute;
        top: 14px;
        right: 14px;
    }

    .availability-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        box-shadow:
            0 4px 14px rgba(31, 41, 55, 0.12);
    }

    .availability-pill.available {
        color: #065f46;
        background: #d1fae5;
    }

    .availability-pill.unavailable {
        color: #991b1b;
        background: #fee2e2;
    }

    .availability-pill.unknown {
        color: #92400e;
        background: #fef3c7;
    }

    .menu-item-content {
        display: flex;
        min-height: 250px;
        flex-direction: column;
        padding: 20px;
    }

    .menu-item-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .menu-item-heading h3 {
        margin: 0;
        color: #111827;
        font-size: 19px;
        font-weight: 800;
    }

    .menu-price {
        color: #b45309;
        font-size: 16px;
        white-space: nowrap;
    }

    .menu-description {
        margin: 11px 0 20px;
        color: #6b7280;
        line-height: 1.55;
    }

    .menu-item-footer {
        margin-top: auto;
    }

    .add-to-cart-form {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .quantity-control {
        width: 82px;
        flex: 0 0 82px;
    }

    .quantity-control label {
        display: block;
        margin-bottom: 5px;
        color: #6b7280;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .quantity-control .form-control {
        min-height: 43px;
        text-align: center;
    }

    .add-cart-button {
        min-height: 43px;
        display: inline-flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid #f59e0b;
        border-radius: 9px;
        color: #111827;
        background: #f59e0b;
        font-weight: 750;
    }

    .add-cart-button:hover {
        border-color: #d97706;
        color: white;
        background: #d97706;
    }

    .add-cart-button span {
        font-size: 20px;
        line-height: 1;
    }

    .unavailable-message {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 13px;
        border-radius: 10px;
        color: #6b7280;
        background: #f3f4f6;
        font-size: 13px;
    }

    .menu-empty-state {
        padding: 70px 30px;
        border: 1px dashed #d1d5db;
        border-radius: 18px;
        background: white;
        text-align: center;
    }

    .menu-empty-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #fff7ed;
        font-size: 29px;
    }

    .menu-empty-state h2 {
        margin-bottom: 9px;
        font-size: 22px;
        font-weight: 800;
    }

    .menu-empty-state p {
        max-width: 520px;
        margin: 0 auto;
        color: #6b7280;
    }

    @@media (max-width: 1250px) {
        .menu-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 850px) {
        .menu-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 28px;
        }

        .menu-cart-button {
            width: 100%;
        }

        .menu-grid {
            grid-template-columns: 1fr;
        }

        .category-navigation {
            position: static;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            if ("scrollRestoration" in history) {
                history.scrollRestoration = "manual";
            }

            const restoreFlagKey =
                "dineflow.menu.restore";

            const anchorKey =
                "dineflow.menu.anchor";

            if (
                sessionStorage.getItem(
                    restoreFlagKey
                ) === "1"
            ) {
                const anchorId =
                    sessionStorage.getItem(
                        anchorKey
                    );

                if (anchorId) {
                    const anchor =
                        document.getElementById(
                            anchorId
                        );

                    if (anchor) {
                        anchor.scrollIntoView({
                            block: "center",
                            behavior: "auto"
                        });
                    }
                }

                sessionStorage.removeItem(
                    restoreFlagKey
                );

                sessionStorage.removeItem(
                    anchorKey
                );
            }

            document
                .querySelectorAll(
                    ".js-add-to-cart-form"
                )
                .forEach(function (form) {
                    form.addEventListener(
                        "submit",
                        function () {
                            const card =
                                form.closest(
                                    "[data-menu-item-card]"
                                );

                            if (card && card.id) {
                                sessionStorage.setItem(
                                    anchorKey,
                                    card.id
                                );
                            }

                            sessionStorage.setItem(
                                restoreFlagKey,
                                "1"
                            );
                        }
                    );
                });
        })();
    </script>
}