@page
@model RROMS.Pages.Customer.Menu.IndexModel
@using System.Linq
@using System.Globalization

@{
    ViewData["Title"] = "Menu";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="mb-2">Our Menu</h1>
        <p class="text-muted mb-4">
            Browse our dishes, prices and current availability.
        </p>
    </div>
    <a asp-page="/Customer/Cart/Index" class="btn btn-outline-primary">View Cart (@Model.CartItemCount)</a>
</div>

@if (TempData["CartMessage"] is string cartMessage && !string.IsNullOrEmpty(cartMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @cartMessage
        <a asp-page="/Customer/Cart/Index" class="alert-link ms-2">View Cart (@Model.CartItemCount)</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["CartError"] is string cartError && !string.IsNullOrEmpty(cartError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @cartError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.MenuItems.Count == 0)
{
    <div class="alert alert-info" role="status">
        No menu items are available to display yet.
    </div>
}
else
{
    var categories = Model.MenuItems
        .GroupBy(item => new
        {
            item.CategoryID,
            CategoryName = item.Category?.CategoryName ?? "Uncategorised"
        })
        .OrderBy(group => group.Key.CategoryName);

    foreach (var category in categories)
    {
        <section class="mb-5">
            <h2 class="h4 mb-3">@category.Key.CategoryName</h2>

            <div class="row">
                @foreach (var item in category)
                {
                    <div class="col-12 col-md-6 col-xl-4 mb-4">
                        <article id="menu-item-@item.MenuItemID" class="card h-100 shadow-sm" data-menu-item-card>
                            <div class="card-body d-flex flex-column">
                                <h3 class="h5 card-title">@item.Name</h3>

                                <p class="card-text text-muted">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "No description provided."
                                        : item.Description)
                                </p>

                                <div class="mt-auto">
                                    <p class="fw-bold mb-2">
                                        Price: RM @item.Price.ToString("0.00", CultureInfo.InvariantCulture)
                                    </p>

                                    @if (item.Availability == true)
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>

                                        <form method="post" asp-page="/Customer/Cart/Index" asp-page-handler="Add"
                                              class="d-flex gap-2 mt-3 js-add-to-cart-form">
                                            <input type="hidden" name="menuItemId" value="@item.MenuItemID" />
                                            <input type="number" name="quantity" value="1" min="1" max="20"
                                                   class="form-control form-control-sm" style="width: 80px;" />
                                            <button type="submit" class="btn btn-sm btn-primary">Add to cart</button>
                                        </form>
                                    }
                                    else if (item.Availability == false)
                                    {
                                        <span class="badge bg-secondary">
                                            Unavailable
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Availability not specified
                                        </span>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    }
}

@section Scripts {
    <script>
        (function () {
            // Stop the browser's own scroll-position memory from fighting with ours
            if ("scrollRestoration" in history) {
                history.scrollRestoration = "manual";
            }

            const restoreFlagKey = "dineflow.menu.restore";
            const anchorKey = "dineflow.menu.anchor";

            if (sessionStorage.getItem(restoreFlagKey) === "1") {
                const anchorId = sessionStorage.getItem(anchorKey);
                if (anchorId) {
                    const anchor = document.getElementById(anchorId);
                    if (anchor) {
                        anchor.scrollIntoView({ block: "center", behavior: "auto" });
                    }
                }

                sessionStorage.removeItem(restoreFlagKey);
                sessionStorage.removeItem(anchorKey);
            }

            document.querySelectorAll(".js-add-to-cart-form").forEach(function (form) {
                form.addEventListener("submit", function () {
                    const card = form.closest("[data-menu-item-card]");
                    if (card && card.id) {
                        sessionStorage.setItem(anchorKey, card.id);
                    }
                    sessionStorage.setItem(restoreFlagKey, "1");
                });
            });
        })();
    </script>
}