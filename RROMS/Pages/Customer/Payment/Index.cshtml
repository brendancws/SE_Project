@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const cardRadio =
                document.getElementById(
                    "methodCard"
                );

            const cashRadio =
                document.getElementById(
                    "methodCash"
                );

            const cardFields =
                document.getElementById(
                    "cardFields"
                );

            const cashFields =
                document.getElementById(
                    "cashFields"
                );

            const cardMethodCard =
                document.getElementById(
                    "cardMethodCard"
                );

            const cashMethodCard =
                document.getElementById(
                    "cashMethodCard"
                );

            const paymentForm =
                document.getElementById(
                    "paymentForm"
                );

            const payButton =
                document.getElementById(
                    "payButton"
                );

            const cardNumberInput =
                document.getElementById(
                    "cardNumberInput"
                );

            if (
                !cardRadio ||
                !cashRadio ||
                !cardFields ||
                !cashFields ||
                !paymentForm ||
                !payButton
            ) {
                return;
            }

            function togglePaymentMethod() {
                const cardSelected =
                    cardRadio.checked;

                cardFields.style.display =
                    cardSelected
                        ? "block"
                        : "none";

                cashFields.style.display =
                    cardSelected
                        ? "none"
                        : "flex";

                cardMethodCard?.classList.toggle(
                    "selected",
                    cardSelected
                );

                cashMethodCard?.classList.toggle(
                    "selected",
                    !cardSelected
                );

                payButton.innerHTML =
                    cardSelected
                        ? '<span id="payButtonText">' +
                          'Pay RM @formattedTotal' +
                          '</span>' +
                          '<span aria-hidden="true">→</span>'
                        : '<span id="payButtonText">' +
                          'Place Order, Pay on Arrival' +
                          '</span>' +
                          '<span aria-hidden="true">→</span>';
            }

            cardRadio.addEventListener(
                "change",
                togglePaymentMethod
            );

            cashRadio.addEventListener(
                "change",
                togglePaymentMethod
            );

            togglePaymentMethod();

            paymentForm.addEventListener(
                "submit",
                function () {
                    if (!paymentForm.checkValidity()) {
                        return;
                    }

                    payButton.disabled = true;

                    payButton.innerHTML =
                        '<span class="spinner-border ' +
                        'spinner-border-sm" role="status" ' +
                        'aria-hidden="true"></span>' +
                        '<span>Processing payment...</span>';
                }
            );

            if (cardNumberInput) {
                cardNumberInput.addEventListener(
                    "input",
                    function () {
                        const digitsOnly =
                            cardNumberInput.value
                                .replace(/\D/g, "")
                                .slice(0, 16);

                        const formatted =
                            digitsOnly
                                .match(/.{1,4}/g)
                                ?.join(" ")
                            ?? digitsOnly;

                        cardNumberInput.value =
                            formatted;
                    }
                );
            }
        })();
    </script>
}