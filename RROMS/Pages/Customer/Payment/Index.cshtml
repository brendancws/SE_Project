@page
@using System.Globalization
@model RROMS.Pages.Customer.Payment.IndexModel
@{
    ViewData["Title"] = "Payment";
}

<div class="container py-4" style="max-width: 600px;">
    <h2 class="mb-4">Payment</h2>

    @if (Model.SelectedReservation == null)
    {
        <div class="alert alert-danger">Reservation not found.</div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Your Order</div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Booking: @Model.SelectedReservation.Date.ToString("dd MMM yyyy") at @Model.SelectedReservation.Time.ToString(@"hh\:mm")
                    - Table @(Model.SelectedReservation.Table?.TableNumber ?? "-")
                </p>

                <table class="table table-sm mb-2">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    @line.Name
                                    @if (!line.IsAvailable)
                                    {
                                        <span class="badge bg-secondary ms-1">Unavailable</span>
                                    }
                                </td>
                                <td>@line.Quantity</td>
                                <td class="text-end">RM @line.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <p class="fw-bold mb-0 text-end">
                    Amount due: RM @Model.Total.ToString("0.00", CultureInfo.InvariantCulture)
                </p>
            </div>
        </div>

        @if (Model.HasUnavailable)
        {
            <div class="alert alert-warning">
                Some items in your cart are no longer available. Please go back to your cart to remove them.
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ResultMessage))
        {
            <div class="alert @(Model.LastAttemptSucceeded == false ? "alert-danger" : "alert-info")">
                @Model.ResultMessage
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Choose Payment Method</div>
            <div class="card-body">
                <form method="post" novalidate id="paymentForm">
                    <input type="hidden" asp-for="ReservationId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Method" id="methodCard" value="Card" checked />
                            <label class="form-check-label" for="methodCard">
                                Card (simulated)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Method" id="methodCash" value="Cash" />
                            <label class="form-check-label" for="methodCash">
                                Cash on arrival
                            </label>
                        </div>
                    </div>

                    <div id="cardFields" class="mb-3">
                        <label asp-for="CardNumber" class="form-label">Card Number</label>
                        <input asp-for="CardNumber" class="form-control" placeholder="e.g. 0000 0000 0000 0000 (any digits)"
                               id="cardNumberInput" maxlength="19" inputmode="numeric" autocomplete="off" />
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>
                        <p class="text-muted small mt-1">
                            This is a simulated payment. No real card is charged.
                            Demo mode: a card number ending in <strong>0000</strong> will simulate a failed payment.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" id="payButton">
                            Pay RM @Model.Total.ToString("0.00", CultureInfo.InvariantCulture)
                        </button>
                        <a asp-page="/Customer/Cart/Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const cardRadio = document.getElementById("methodCard");
            const cashRadio = document.getElementById("methodCash");
            const cardFields = document.getElementById("cardFields");

            function toggleCardFields() {
                cardFields.style.display = cardRadio.checked ? "block" : "none";
            }

            cardRadio.addEventListener("change", toggleCardFields);
            cashRadio.addEventListener("change", toggleCardFields);
            toggleCardFields();

            const paymentForm = document.getElementById("paymentForm");
            const payButton = document.getElementById("payButton");

            paymentForm.addEventListener("submit", function () {
                payButton.disabled = true;
                payButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing payment...';
            });

            const cardNumberInput = document.getElementById("cardNumberInput");

            if (cardNumberInput) {
                cardNumberInput.addEventListener("input", function () {
                    let digitsOnly = cardNumberInput.value.replace(/\D/g, "").slice(0, 16);
                    let formatted = digitsOnly.match(/.{1,4}/g)?.join(" ") ?? digitsOnly;
                    cardNumberInput.value = formatted;
                });
            }
        })();
    </script>
}