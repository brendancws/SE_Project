@page
@model RROMS.Pages.Customer.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_CustomerAuthLayout";
}

<div class="auth-form-card">
    <header class="auth-form-header">
        <span class="auth-eyebrow">
            Customer Portal
        </span>

        <h2>Welcome back</h2>

        <p>
            Sign in to manage your reservations, orders,
            payments, and dining preferences.
        </p>
    </header>

    <form method="post"
          novalidate
          class="customer-auth-form">

        <input type="hidden"
               asp-for="ReturnUrl" />

        <div asp-validation-summary="All"
             class="auth-validation-summary"
             role="alert">
        </div>

        <div class="auth-field">
            <label asp-for="Email">
                Email Address
            </label>

            <div class="auth-input-wrapper">
                <span class="auth-input-icon"
                      aria-hidden="true">
                    @@
                </span>

                <input asp-for="Email"
                       type="email"
                       class="form-control auth-input"
                       placeholder="you@example.com"
                       autocomplete="email"
                       inputmode="email" />
            </div>

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>
        </div>

        <div class="auth-field">
            <div class="auth-label-row">
                <label asp-for="Password">
                    Password
                </label>
            </div>

            <div class="auth-input-wrapper">
                <span class="auth-input-icon"
                      aria-hidden="true">
                    ●
                </span>

                <input asp-for="Password"
                       type="password"
                       class="form-control auth-input password-input"
                       id="loginPassword"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <button type="button"
                        class="password-toggle"
                        data-password-toggle="loginPassword"
                        aria-label="Show password">
                    Show
                </button>
            </div>

            <span asp-validation-for="Password"
                  class="text-danger small">
            </span>
        </div>

        <button type="submit"
                class="auth-submit-button">
            Sign In
            <span aria-hidden="true">→</span>
        </button>
    </form>

    <div class="auth-divider">
        <span>New to Dineflow?</span>
    </div>

    <div class="auth-alternate-action">
        <p>
            Create an account to book tables, order food,
            and keep your dining records together.
        </p>

        <a asp-page="./Register"
           class="auth-secondary-link">
            Create Customer Account
        </a>
    </div>

    <footer class="auth-security-note">
        <span aria-hidden="true">◆</span>

        <p>
            Your account information is used only to support
            your Dineflow customer experience.
        </p>
    </footer>
</div>

<style>
    .auth-form-card {
        padding: 38px;
        border: 1px solid rgba(229, 231, 235, 0.8);
        border-radius: 20px;
        background: white;
        box-shadow:
            0 18px 45px rgba(31, 41, 55, 0.12);
    }

    .auth-form-header {
        margin-bottom: 26px;
    }

    .auth-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #d97706;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .auth-form-header h2 {
        margin: 0 0 9px;
        color: #111827;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .auth-form-header p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.6;
    }

    .customer-auth-form {
        display: grid;
        gap: 19px;
    }

    .auth-validation-summary {
        padding: 13px 14px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        color: #991b1b;
        background: #fef2f2;
        font-size: 12px;
    }

    .auth-validation-summary.validation-summary-valid {
        display: none;
    }

    .auth-validation-summary ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .auth-validation-summary li + li {
        margin-top: 4px;
    }

    .auth-field label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 12px;
        font-weight: 750;
    }

    .auth-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .auth-input-wrapper {
        position: relative;
    }

    .auth-input-icon {
        position: absolute;
        top: 50%;
        left: 14px;
        z-index: 2;
        color: #9ca3af;
        font-size: 12px;
        font-weight: 800;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .auth-input {
        min-height: 48px;
        padding-left: 43px;
        border-color: #d1d5db;
        border-radius: 10px;
        color: #111827;
        background: #ffffff;
        font-size: 13px;
    }

    .auth-input::placeholder {
        color: #9ca3af;
    }

    .auth-input:focus {
        border-color: #f59e0b;
        box-shadow:
            0 0 0 0.2rem rgba(245, 158, 11, 0.15);
    }

    .password-input {
        padding-right: 70px;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 9px;
        min-width: 48px;
        padding: 5px 8px;
        border: 0;
        border-radius: 7px;
        color: #92400e;
        background: #fff7ed;
        font-size: 9px;
        font-weight: 800;
        transform: translateY(-50%);
    }

    .password-toggle:hover {
        color: white;
        background: #d97706;
    }

    .auth-submit-button {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: 3px;
        padding: 10px 18px;
        border: 1px solid #f59e0b;
        border-radius: 10px;
        color: #111827;
        background: #f59e0b;
        font-size: 13px;
        font-weight: 800;
    }

    .auth-submit-button:hover {
        border-color: #d97706;
        color: white;
        background: #d97706;
    }

    .auth-submit-button span {
        font-size: 17px;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 13px;
        margin: 25px 0 18px;
        color: #9ca3af;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .auth-divider::before,
    .auth-divider::after {
        height: 1px;
        flex: 1;
        content: "";
        background: #e5e7eb;
    }

    .auth-alternate-action {
        text-align: center;
    }

    .auth-alternate-action p {
        max-width: 390px;
        margin: 0 auto 13px;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.55;
    }

    .auth-secondary-link {
        min-height: 42px;
        display: inline-flex;
        width: 100%;
        align-items: center;
        justify-content: center;
        padding: 9px 15px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        color: #374151 !important;
        background: white;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .auth-secondary-link:hover {
        border-color: #f59e0b;
        color: #92400e !important;
        background: #fff7ed;
    }

    .auth-security-note {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 21px;
        padding-top: 17px;
        border-top: 1px solid #f3f4f6;
        color: #9ca3af;
    }

    .auth-security-note span {
        flex-shrink: 0;
        color: #059669;
        font-size: 9px;
    }

    .auth-security-note p {
        margin: 0;
        font-size: 10px;
        line-height: 1.5;
    }

    @@media (max-width: 560px) {
        .auth-form-card {
            padding: 27px 22px;
            border-radius: 16px;
        }

        .auth-form-header h2 {
            font-size: 25px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            document
                .querySelectorAll(
                    "[data-password-toggle]"
                )
                .forEach(function (button) {
                    button.addEventListener(
                        "click",
                        function () {
                            const inputId =
                                button.getAttribute(
                                    "data-password-toggle"
                                );

                            const input =
                                document.getElementById(
                                    inputId
                                );

                            if (!input) {
                                return;
                            }

                            const shouldShow =
                                input.type === "password";

                            input.type =
                                shouldShow
                                    ? "text"
                                    : "password";

                            button.textContent =
                                shouldShow
                                    ? "Hide"
                                    : "Show";

                            button.setAttribute(
                                "aria-label",
                                shouldShow
                                    ? "Hide password"
                                    : "Show password"
                            );
                        }
                    );
                });
        })();
    </script>
}