@page
@model RROMS.Pages.Customer.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_CustomerAuthLayout";
}

<div class="auth-form-card">

    <header class="auth-form-header">

        <span class="auth-eyebrow">
            Account Recovery
        </span>

        <h2>Forgot your password?</h2>

        <p>
            Enter your email address and we'll send
            a secure password reset link.
        </p>

    </header>

    <form method="post"
          novalidate
          class="customer-auth-form">

        <div asp-validation-summary="All"
             class="auth-validation-summary"
             role="alert">
        </div>

        <div class="auth-field">

            <label asp-for="Email">
                Email Address
            </label>

            <div class="auth-input-wrapper">

                <span class="auth-input-icon">
                    @@
                </span>

                <input asp-for="Email"
                       type="email"
                       class="form-control auth-input"
                       placeholder="you@example.com"
                       autocomplete="email" />

            </div>

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>

        </div>

        <button type="submit"
                class="auth-submit-button">

            Send Reset Link

            <span aria-hidden="true">→</span>

        </button>

    </form>

    <div class="auth-divider">
        <span>Remembered your password?</span>
    </div>

    <a asp-page="./Login"
       class="auth-secondary-link">

        Back to Sign In

    </a>

    <footer class="auth-security-note">

        <span aria-hidden="true">
            ◆
        </span>

        <p>
            Password reset links expire automatically
            after 30 minutes for security purposes.
        </p>

    </footer>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
