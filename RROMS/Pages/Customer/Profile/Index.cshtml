@page
@model RROMS.Pages.Customer.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile";

    string customerInitials =
        GetCustomerInitials(Model.Input.Name);
}

<div class="container py-4 profile-page">
    <header class="profile-header">
        <div>
            <span class="profile-eyebrow">
                Customer Account
            </span>

            <h1>My Profile</h1>

            <p>
                Manage your personal details, dining preferences,
                special requests, and account password.
            </p>
        </div>

        <a asp-page="/Customer/Dashboard/Index"
           class="profile-dashboard-link">
            Back to Dashboard
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="profile-success-message"
             role="status">

            <div class="success-message-icon"
                 aria-hidden="true">
                ✓
            </div>

            <div>
                <strong>Changes saved</strong>
                <span>@Model.StatusMessage</span>
            </div>

            <button type="button"
                    class="success-message-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                ×
            </button>
        </div>
    }

    <div class="profile-layout">
        <aside class="profile-sidebar">
            <section class="profile-identity-card">
                <div class="profile-avatar"
                     aria-hidden="true">
                    @customerInitials
                </div>

                <h2>
                    @(string.IsNullOrWhiteSpace(Model.Input.Name)
                        ? "Customer"
                        : Model.Input.Name)
                </h2>

                <p>@Model.Email</p>

                <span class="account-status">
                    Active Customer
                </span>
            </section>

            <section class="account-information-card">
                <div class="sidebar-card-heading">
                    <span class="profile-eyebrow">
                        Account
                    </span>

                    <h2>Account Information</h2>
                </div>

                <div class="account-detail">
                    <span>Email Address</span>
                    <strong>@Model.Email</strong>
                    <small>Used to sign in to Dineflow</small>
                </div>

                <div class="account-detail">
                    <span>Member Since</span>

                    <strong>
                        @(Model.DateRegistered?.ToString(
                            "dd MMMM yyyy")
                            ?? "Not recorded")
                    </strong>

                    <small>Your Dineflow registration date</small>
                </div>

                <div class="account-security-note">
                    <span class="security-note-icon"
                          aria-hidden="true">
                        🔒
                    </span>

                    <p>
                        Your email address cannot be changed from this
                        page. Your password can be updated securely
                        below.
                    </p>
                </div>
            </section>
        </aside>

        <main class="profile-content">
            <section class="profile-form-card">
                <div class="profile-card-heading">
                    <div class="profile-heading-icon"
                         aria-hidden="true">
                        P
                    </div>

                    <div>
                        <span>Profile Details</span>
                        <h2>Personal Information</h2>
                    </div>
                </div>

                <form method="post"
                      novalidate
                      class="profile-form">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger validation-summary">
                    </div>

                    <section class="profile-form-section">
                        <div class="form-section-heading">
                            <h3>Contact Details</h3>

                            <p>
                                Keep your personal information accurate
                                so the restaurant can contact you when
                                necessary.
                            </p>
                        </div>

                        <div class="profile-fields-grid">
                            <div class="profile-field full-width">
                                <label asp-for="Input.Name"
                                       class="form-label">
                                </label>

                                <span class="required-indicator"
                                      aria-hidden="true">
                                    *
                                </span>

                                <input asp-for="Input.Name"
                                       class="form-control profile-input"
                                       autocomplete="name" />

                                <span asp-validation-for="Input.Name"
                                      class="text-danger small">
                                </span>

                                <small class="field-help">
                                    Enter the name used for your
                                    reservations and orders.
                                </small>
                            </div>

                            <div class="profile-field full-width">
                                <label asp-for="Input.Phone"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.Phone"
                                       class="form-control profile-input"
                                       placeholder="e.g. 012-345 6789"
                                       autocomplete="tel" />

                                <span asp-validation-for="Input.Phone"
                                      class="text-danger small">
                                </span>

                                <small class="field-help">
                                    Digits, spaces, dashes, and an
                                    optional leading + are accepted.
                                </small>
                            </div>

                            <div class="profile-field full-width">
                                <label asp-for="Input.Address"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Input.Address"
                                          class="form-control profile-input"
                                          rows="3"
                                          autocomplete="street-address"
                                          placeholder="Enter your address">
                                </textarea>

                                <span asp-validation-for="Input.Address"
                                      class="text-danger small">
                                </span>
                            </div>
                        </div>
                    </section>

                    <section class="profile-form-section dining-section">
                        <div class="form-section-heading">
                            <h3>Dining Preferences</h3>

                            <p>
                                Save general dining preferences and
                                requests that may help the restaurant
                                prepare for your visits.
                            </p>
                        </div>

                        <div class="profile-fields-grid">
                            <div class="profile-field full-width">
                                <label asp-for="Input.DiningPreference"
                                       class="form-label">
                                </label>

                                <input asp-for="Input.DiningPreference"
                                       class="form-control profile-input"
                                       list="diningPreferenceOptions"
                                       placeholder="e.g. Vegetarian, Halal, No seafood" />

                                <datalist id="diningPreferenceOptions">
                                    <option value="Vegetarian"></option>
                                    <option value="Vegan"></option>
                                    <option value="Halal"></option>
                                    <option value="No seafood"></option>
                                    <option value="Window seat"></option>
                                    <option value="Non-smoking area"></option>
                                </datalist>

                                <span asp-validation-for="Input.DiningPreference"
                                      class="text-danger small">
                                </span>

                                <small class="field-help">
                                    Select a suggestion or enter your
                                    own preference.
                                </small>
                            </div>

                            <div class="profile-field full-width">
                                <label asp-for="Input.SpecialRequest"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Input.SpecialRequest"
                                          class="form-control profile-input"
                                          rows="4"
                                          placeholder="Allergies, accessibility needs, celebrations...">
                                </textarea>

                                <span asp-validation-for="Input.SpecialRequest"
                                      class="text-danger small">
                                </span>

                                <small class="field-help">
                                    These are general account
                                    preferences. Confirm critical
                                    requirements directly with the
                                    restaurant when necessary.
                                </small>
                            </div>
                        </div>
                    </section>

                    <div class="profile-actions">
                        <button type="submit"
                                class="save-profile-button">
                            Save Profile Changes
                        </button>

                        <a asp-page="/Customer/Profile/Index"
                           class="cancel-profile-link">
                            Reset Form
                        </a>
                    </div>
                </form>
            </section>

            <section class="password-card">
                <div class="profile-card-heading password-heading">
                    <div class="profile-heading-icon password-icon"
                         aria-hidden="true">
                        🔒
                    </div>

                    <div>
                        <span>Account Security</span>
                        <h2>Change Password</h2>
                    </div>
                </div>

                <form method="post"
      asp-page="/Customer/Profile/Index"
      asp-page-handler="ChangePassword"
      novalidate
      class="password-form"
      id="changePasswordForm">

                    <div asp-validation-summary="All"
     class="alert alert-danger validation-summary"
     id="passwordValidationSummary">
</div>

                    <div class="password-introduction">
                        <strong>Protect your Dineflow account</strong>

                        <p>
                            Enter your current password before choosing
                            a new password with at least eight
                            characters.
                        </p>
                    </div>

                    <div class="password-fields-grid">
                        <div class="profile-field full-width">
                            <label asp-for="PasswordInput.CurrentPassword"
                                   class="form-label">
                            </label>

                            <div class="password-input-wrapper">
                                <input asp-for="PasswordInput.CurrentPassword"
                                       class="form-control profile-input"
                                       autocomplete="current-password" />

                                <button type="button"
                                        class="password-toggle"
                                        data-password-toggle="PasswordInput_CurrentPassword"
                                        aria-label="Show current password">
                                    Show
                                </button>
                            </div>

                            <span asp-validation-for="PasswordInput.CurrentPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="profile-field">
                            <label asp-for="PasswordInput.NewPassword"
                                   class="form-label">
                            </label>

                            <div class="password-input-wrapper">
                                <input asp-for="PasswordInput.NewPassword"
                                       class="form-control profile-input"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        data-password-toggle="PasswordInput_NewPassword"
                                        aria-label="Show new password">
                                    Show
                                </button>
                            </div>

                            <span asp-validation-for="PasswordInput.NewPassword"
                                  class="text-danger small">
                            </span>

                            <small class="field-help">
                                Use at least eight characters.
                            </small>
                        </div>

                        <div class="profile-field">
                            <label asp-for="PasswordInput.ConfirmPassword"
                                   class="form-label">
                            </label>

                            <div class="password-input-wrapper">
                                <input asp-for="PasswordInput.ConfirmPassword"
                                       class="form-control profile-input"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        data-password-toggle="PasswordInput_ConfirmPassword"
                                        aria-label="Show password confirmation">
                                    Show
                                </button>
                            </div>

                            <span asp-validation-for="PasswordInput.ConfirmPassword"
                                  class="text-danger small">
                            </span>
                        </div>
                    </div>

                    <div class="password-guidance">
                        <div>
                            <span aria-hidden="true">✓</span>
                            <p>Minimum of eight characters</p>
                        </div>

                        <div>
                            <span aria-hidden="true">✓</span>
                            <p>
                                Must differ from your current password
                            </p>
                        </div>

                        <div>
                            <span aria-hidden="true">✓</span>
                            <p>
                                Confirmation must match the new
                                password
                            </p>
                        </div>
                    </div>

                    <div class="password-actions">
                        <button type="submit"
                                class="change-password-button">
                            Change Password
                        </button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@functions {
    private static string GetCustomerInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "CU";
        }

        string[] words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(2, words[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(
            words.Take(2)
                .Select(word =>
                    char.ToUpperInvariant(word[0])));
    }
}

<style>
