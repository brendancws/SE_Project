        margin: 0;
        font-size: 11px;
        line-height: 1.5;
    }

    .password-input-wrapper {
        position: relative;
    }

    .password-input-wrapper .profile-input {
        padding-right: 63px;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 8px;
        min-width: 45px;
        padding: 5px 7px;
        border: 0;
        border-radius: 6px;
        color: #2563eb;
        background: #eff6ff;
        font-size: 9px;
        font-weight: 800;
        transform: translateY(-50%);
