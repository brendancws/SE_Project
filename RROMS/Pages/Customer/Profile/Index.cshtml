@page
@model RROMS.Pages.Customer.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile";
    // Use the SAME Layout line as Pages/Customer/Menu/Index.cshtml (if it sets one)
}

<div class="container py-4">
    <h2 class="mb-4">My Profile</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Account info (read-only) -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Account Information</div>
                <div class="card-body">
                    <p class="mb-1 text-muted small">Email (login)</p>
                    <p class="fw-semibold">@Model.Email</p>

                    <p class="mb-1 text-muted small">Member since</p>
                    <p class="fw-semibold mb-0">
                        @(Model.DateRegistered?.ToString("dd MMM yyyy") ?? "Not recorded")
                    </p>
                </div>
            </div>
        </div>

        <!-- Editable profile form -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Edit Profile</div>
                <div class="card-body">
                    <form method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <h6 class="text-muted mb-3">Personal Details</h6>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Input.Name" class="form-control" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" placeholder="e.g. 012-345 6789" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <textarea asp-for="Input.Address" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger small"></span>
                        </div>

                        <h6 class="text-muted mb-3">Dining Preferences</h6>

                        <div class="mb-3">
                            <label asp-for="Input.DiningPreference" class="form-label"></label>
                            <input asp-for="Input.DiningPreference" class="form-control"
                                   list="diningPreferenceOptions"
                                   placeholder="e.g. Vegetarian, Halal, No seafood" />
                            <datalist id="diningPreferenceOptions">
                                <option value="Vegetarian"></option>
                                <option value="Vegan"></option>
                                <option value="Halal"></option>
                                <option value="No seafood"></option>
                                <option value="Window seat"></option>
                                <option value="Non-smoking area"></option>
                            </datalist>
                            <span asp-validation-for="Input.DiningPreference" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.SpecialRequest" class="form-label"></label>
                            <textarea asp-for="Input.SpecialRequest" class="form-control" rows="3"
                                      placeholder="Allergies, accessibility needs, celebrations..."></textarea>
                            <span asp-validation-for="Input.SpecialRequest" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-page="/Customer/Profile/Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}