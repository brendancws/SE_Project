        color: #059669;
        font-weight: 900;
    }

    .password-guidance p {
        margin: 0;
    }

    .change-password-button {
        border-color: #2563eb;
        color: white;
        background: #2563eb;
    }

    .change-password-button:hover {
        border-color: #1d4ed8;
        background: #1d4ed8;
    }

    @@media (max-width: 960px) {
        .profile-layout {
            grid-template-columns: 1fr;
        }

        .profile-sidebar {
            grid-template-columns:
                minmax(0, 0.75fr)
                minmax(0, 1.25fr);
        }
    }

    @@media (max-width: 700px) {
        .profile-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-dashboard-link {
            width: 100%;
        }

        .profile-sidebar {
            grid-template-columns: 1fr;
        }

        .profile-fields-grid,
        .password-fields-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .profile-actions,
        .password-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .save-profile-button,
        .change-password-button,
        .cancel-profile-link {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .profile-success-message {
            grid-template-columns:
                34px minmax(0, 1fr);
        }

        .success-message-close {
            grid-column: 1 / -1;
            justify-self: end;
        }

        .profile-form,
        .password-form {
            padding: 19px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            document
                .querySelectorAll(
                    "[data-password-toggle]"
                )
                .forEach(function (button) {
                    button.addEventListener(
                        "click",
                        function () {
                            const inputId =
                                button.getAttribute(
                                    "data-password-toggle"
                                );

                            const input =
                                document.getElementById(
                                    inputId
                                );

                            if (!input) {
                                return;
                            }

                            const shouldShow =
                                input.type === "password";

                            input.type =
                                shouldShow
                                    ? "text"
                                    : "password";

                            button.textContent =
                                shouldShow
                                    ? "Hide"
                                    : "Show";

                            button.setAttribute(
                                "aria-label",
                                shouldShow
                                    ? "Hide password"
                                    : "Show password"
                            );
                        }
                    );
                });

            const passwordValidationSummary =
                document.getElementById(
                    "passwordValidationSummary"
                );

            if (
                passwordValidationSummary &&
                passwordValidationSummary
                    .textContent
                    .trim()
            ) {
                passwordValidationSummary.scrollIntoView({
                    behavior: "auto",
                    block: "center"
                });
            }
        })();
    </script>
}