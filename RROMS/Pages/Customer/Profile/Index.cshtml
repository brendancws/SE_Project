    }

    .profile-identity-card h2 {
        margin: 0 0 5px;
        color: #111827;
        font-size: 20px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .profile-identity-card p {
        margin: 0 0 13px;
        color: #6b7280;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

    .account-status {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        color: #065f46;
        background: #d1fae5;
        font-size: 10px;
        font-weight: 850;
    }

    .account-information-card {
        padding: 22px;
    }

    .sidebar-card-heading {
        padding-bottom: 16px;
