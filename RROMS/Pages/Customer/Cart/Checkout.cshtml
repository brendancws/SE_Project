@page
@using System.Globalization
@model RROMS.Pages.Customer.Cart.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-4" style="max-width: 800px;">
    <h2 class="mb-4">Checkout</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Your Order</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                @line.Name
                                @if (!line.IsAvailable)
                                {
                                    <span class="badge bg-secondary ms-1">Unavailable</span>
                                }
                            </td>
                            <td>RM @line.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@line.Quantity</td>
                            <td class="text-end">RM @line.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">RM @Model.Total.ToString("0.00", CultureInfo.InvariantCulture)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Which booking is this order for?</div>
        <div class="card-body">
            @if (!Model.ReservationOptions.Any())
            {
                <div class="alert alert-warning">
                    You have no current reservation to link this order to. Please book a table first.
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="/Customer/Reservations/Create" class="btn btn-primary">Book a Table</a>
                    <a asp-page="/Customer/Cart/Index" class="btn btn-outline-secondary">Back to Cart</a>
                </div>
            }
            else
            {
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ReservationId" class="form-label"></label>
                        <select asp-for="ReservationId" class="form-select">
                            <option value="">-- Select a reservation --</option>
                            @foreach (var option in Model.ReservationOptions)
                            {
                                <option value="@option.ReservationID">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="ReservationId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Place Order</button>
                        <a asp-page="/Customer/Cart/Index" class="btn btn-outline-secondary">Back to Cart</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>