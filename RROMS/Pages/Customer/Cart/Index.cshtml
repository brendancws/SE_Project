@page
@using System.Globalization
@model RROMS.Pages.Customer.Cart.IndexModel
@{
    ViewData["Title"] = "My Cart";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Cart</h2>
        <a asp-page="/Customer/Menu/Index" class="btn btn-outline-secondary">Continue Browsing Menu</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Lines.Any())
    {
        <div class="alert alert-info">
            Your cart is empty. Browse the menu and add some items.
        </div>
        <a asp-page="/Customer/Menu/Index" class="btn btn-primary">Browse Menu</a>
    }
    else
    {
        @if (Model.HasUnavailable)
        {
            <div class="alert alert-warning">
                Some items in your cart are currently unavailable. Please remove them before placing an order.
            </div>
        }

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th>Price</th>
                            <th style="width: 220px;">Quantity</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    @line.Name
                                    @if (!line.IsAvailable)
                                    {
                                        <span class="badge bg-secondary ms-1">Unavailable</span>
                                    }
                                </td>
                                <td>RM @line.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td>
                                    <form method="post" asp-page-handler="Update" class="d-flex gap-2">
                                        <input type="hidden" name="menuItemId" value="@line.MenuItemID" />
                                        <input type="number" name="quantity" value="@line.Quantity"
                                               min="0" max="20" class="form-control form-control-sm" style="width: 80px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                    </form>
                                </td>
                                <td class="text-end">RM @line.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Remove">
                                        <input type="hidden" name="menuItemId" value="@line.MenuItemID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end">RM @Model.Total.ToString("0.00", CultureInfo.InvariantCulture)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <form id="clearCartForm" method="post" asp-page-handler="Clear">
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#clearCartConfirmModal">Clear Cart</button>
            </form>

            @if (Model.HasUnavailable)
            {
                <button type="button" class="btn btn-primary" disabled>Proceed to Checkout</button>
            }
            else
            {
                <a asp-page="/Customer/Cart/Checkout" class="btn btn-primary">Proceed to Checkout</a>
            }
        </div>

        <div class="modal fade" id="clearCartConfirmModal" tabindex="-1" aria-labelledby="clearCartConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="clearCartConfirmModalLabel">Clear cart</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Remove everything from your cart?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger" form="clearCartForm">Yes, clear cart</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
