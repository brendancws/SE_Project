@page
@using System.Globalization
@model RROMS.Pages.Customer.Dashboard.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="customer-dashboard">
    <section class="dashboard-hero">
        <div>
            <span class="hero-label">Customer Portal</span>

            <h1>
                Welcome back, @Model.CustomerName
            </h1>

            <p>
                Manage your reservations, track your orders, and stay
                updated on your dining experience from one place.
            </p>
        </div>

        <div class="hero-actions">
            <a asp-page="/Customer/Reservations/Create"
               class="btn dashboard-primary-btn">
                Book a Table
            </a>

            <a asp-page="/Customer/Menu/Index"
               class="btn dashboard-secondary-btn">
                Browse Menu
            </a>
        </div>
    </section>

    <section class="dashboard-summary-grid"
             aria-label="Customer overview">
        <article class="summary-card">
            <div class="summary-icon reservation-icon">
                📅
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Next Reservation
                </span>

                @if (Model.NextReservation != null)
                {
                    <strong>
                        @Model.NextReservation.Date.ToString(
                            "dd MMM yyyy")
                    </strong>

                    <small>
                        @Model.NextReservation.Time.ToString(@"hh\:mm")
                        · @Model.BookingReference
                    </small>
                }
                else
                {
                    <strong>Not booked</strong>
                    <small>Plan your next visit</small>
                }
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon order-icon">
                🍽️
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Latest Order
                </span>

                @if (Model.LatestOrder != null)
                {
                    <strong>@Model.OrderReference</strong>

                    <small>
                        @(Model.LatestOrder.Status ?? "Pending")
                        · RM @((Model.LatestOrder.TotalAmount ?? 0m)
                            .ToString(
                                "0.00",
                                CultureInfo.InvariantCulture))
                    </small>
                }
                else
                {
                    <strong>No orders yet</strong>
                    <small>Browse the menu to get started</small>
                }
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon notification-icon">
                🔔
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Unread Notifications
                </span>

                <strong>
                    @Model.UnreadNotificationCount
                </strong>

                <small>
    @(Model.UnreadNotificationCount switch
    {
        0 => "You're all caught up",
        1 => "New update waiting",
        _ => "New updates waiting"
    })
</small>
            </div>
        </article>
    </section>

    <section class="dashboard-content-grid">
        <div class="dashboard-panel next-visit-panel">
            <div class="panel-header">
                <div>
                    <span class="panel-eyebrow">
                        Upcoming
                    </span>

                    <h2>Your Next Visit</h2>
                </div>

                <a asp-page="/Customer/Reservations/Index"
                   class="panel-link">
                    View reservations
                </a>
            </div>

            @if (Model.NextReservation != null)
            {
                <div class="visit-card">
                    <div class="visit-date">
                        <span class="visit-day">
                            @Model.NextReservation.Date.ToString("dd")
                        </span>

                        <span class="visit-month">
                            @Model.NextReservation.Date.ToString("MMM")
                        </span>
                    </div>

                    <div class="visit-details">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h3>@Model.BookingReference</h3>

                            <span class="badge @RROMS.Pages.Customer.Dashboard.IndexModel.ReservationBadgeClass(Model.NextReservation.Status)">
                                @(Model.NextReservation.Status ?? "Pending")
                            </span>
                        </div>

                        <p>
                            @Model.NextReservation.Date.ToString(
                                "dddd, dd MMMM yyyy")
                            at
                            @Model.NextReservation.Time.ToString(@"hh\:mm")
                        </p>

                        <div class="detail-list">
                            <span>
                                <strong>Table:</strong>
                                @(Model.NextReservation.Table?.TableNumber
                                    ?? "-")
                            </span>

                            <span>
                                <strong>Guests:</strong>
                                @Model.NextReservation.NumberOfGuests
                            </span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📅</div>

                    <div>
                        <h3>No upcoming reservation</h3>

                        <p>
                            Book a table and start planning your next
                            dining experience.
                        </p>

                        <a asp-page="/Customer/Reservations/Create"
                           class="btn dashboard-primary-btn">
                            Book a Table
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="dashboard-panel latest-order-panel">
            <div class="panel-header">
                <div>
                    <span class="panel-eyebrow">
                        Recent
                    </span>

                    <h2>Latest Order</h2>
                </div>

                <a asp-page="/Customer/Orders/Index"
                   class="panel-link">
                    View orders
                </a>
            </div>

            @if (Model.LatestOrder != null)
            {
                <div class="order-overview">
                    <div>
                        <small>Order reference</small>
                        <h3>@Model.OrderReference</h3>
                    </div>

                    <span class="badge @RROMS.Pages.Customer.Dashboard.IndexModel.OrderBadgeClass(Model.LatestOrder.Status)">
                        @(Model.LatestOrder.Status ?? "Pending")
                    </span>
                </div>

                <div class="order-metrics">
                    <div>
                        <span>Total</span>
                        <strong>
                            RM @((Model.LatestOrder.TotalAmount ?? 0m)
                                .ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture))
                        </strong>
                    </div>

                    <div>
                        <span>Placed</span>
                        <strong>
                            @(Model.LatestOrder.OrderDate?.ToString(
                                "dd MMM yyyy")
                                ?? "Not recorded")
                        </strong>
                    </div>

                    <div>
                        <span>Booking</span>
                        <strong>
                            @(Model.LatestOrder.ReservationID.HasValue
                                ? $"RES-{Model.LatestOrder.ReservationID.Value:D6}"
                                : "Not linked")
                        </strong>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state compact-empty">
                    <div class="empty-icon">🍽️</div>

                    <div>
                        <h3>No orders yet</h3>

                        <p>
                            Browse the menu and add your first meal to
                            the cart.
                        </p>

                        <a asp-page="/Customer/Menu/Index"
                           class="btn dashboard-secondary-btn">
                            Browse Menu
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="quick-actions-section">
        <div class="section-heading">
            <div>
                <span class="panel-eyebrow">
                    Shortcuts
                </span>

                <h2>Quick Actions</h2>
            </div>
        </div>

        <div class="quick-actions-grid">
            <a asp-page="/Customer/Reservations/Create"
               class="quick-action-card">
                <span class="quick-action-icon">📅</span>

                <span>
                    <strong>Book a Table</strong>
                    <small>Plan your next visit</small>
                </span>
            </a>

            <a asp-page="/Customer/Menu/Index"
               class="quick-action-card">
                <span class="quick-action-icon">📖</span>

                <span>
                    <strong>Browse Menu</strong>
                    <small>Explore available dishes</small>
                </span>
            </a>

            <a asp-page="/Customer/Orders/Index"
               class="quick-action-card">
                <span class="quick-action-icon">🍽️</span>

                <span>
                    <strong>Track Orders</strong>
                    <small>Follow order progress</small>
                </span>
            </a>

            <a asp-page="/Customer/Notifications/Index"
               class="quick-action-card">
                <span class="quick-action-icon">🔔</span>

                <span>
                    <strong>Notifications</strong>
                    <small>
                        @Model.UnreadNotificationCount unread
                    </small>
                </span>
            </a>
        </div>
    </section>
</div>

<style>
    .customer-dashboard {
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    .dashboard-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 38px 40px;
        border-radius: 22px;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(245, 158, 11, 0.35),
                transparent 34%
            ),
            linear-gradient(
                135deg,
                #111827 0%,
                #1f2937 60%,
                #374151 100%
            );
        box-shadow: 0 18px 40px rgba(31, 41, 55, 0.16);
    }

    .hero-label,
    .panel-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .dashboard-hero h1 {
        margin: 0 0 12px;
        font-size: 36px;
        font-weight: 800;
    }

    .dashboard-hero p {
        max-width: 690px;
        margin: 0;
        color: #d1d5db;
        line-height: 1.65;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        flex-shrink: 0;
    }

    .dashboard-primary-btn,
    .dashboard-secondary-btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 700;
    }

    .dashboard-primary-btn {
        border-color: #f59e0b;
        background: #f59e0b;
        color: #111827;
    }

    .dashboard-primary-btn:hover {
        border-color: #d97706;
        background: #d97706;
        color: white;
    }

    .dashboard-secondary-btn {
        border: 1px solid #d1d5db;
        background: white;
        color: #1f2937;
    }

    .dashboard-secondary-btn:hover {
        border-color: #9ca3af;
        background: #f9fafb;
        color: #111827;
    }

    .dashboard-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .summary-card,
    .dashboard-panel,
    .quick-action-card {
        border: 1px solid #e5e7eb;
        background: white;
        box-shadow: 0 8px 22px rgba(31, 41, 55, 0.05);
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
        padding: 20px;
        border-radius: 16px;
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        display: flex;
        flex: 0 0 50px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 22px;
    }

    .reservation-icon {
        background: #fff7ed;
    }

    .order-icon {
        background: #eff6ff;
    }

    .notification-icon {
        background: #fef2f2;
    }

    .summary-content {
        min-width: 0;
    }

    .summary-content span,
    .summary-content strong,
    .summary-content small {
        display: block;
    }

    .summary-label {
        margin-bottom: 4px;
        color: #6b7280;
        font-size: 13px;
    }

    .summary-content strong {
        color: #111827;
        font-size: 18px;
    }

    .summary-content small {
        margin-top: 3px;
        color: #6b7280;
        overflow-wrap: anywhere;
    }

    .dashboard-content-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.25fr)
            minmax(340px, 0.75fr);
        gap: 20px;
    }

    .dashboard-panel {
        border-radius: 18px;
        padding: 26px;
    }

    .panel-header,
    .section-heading,
    .order-overview {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .panel-header {
        margin-bottom: 22px;
    }

    .panel-header h2,
    .section-heading h2 {
        margin: 0;
        color: #111827;
        font-size: 22px;
        font-weight: 750;
    }

    .panel-link {
        color: #b45309;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .panel-link:hover {
        color: #92400e;
        text-decoration: underline;
    }

    .visit-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 22px;
        border: 1px solid #fde68a;
        border-radius: 16px;
        background: #fffbeb;
    }

    .visit-date {
        width: 72px;
        height: 78px;
        display: flex;
        flex: 0 0 72px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #1f2937;
        color: white;
    }

    .visit-day {
        font-size: 26px;
        font-weight: 800;
        line-height: 1;
    }

    .visit-month {
        margin-top: 6px;
        color: #fbbf24;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .visit-details h3,
    .order-overview h3,
    .empty-state h3 {
        margin: 0;
        color: #111827;
        font-size: 18px;
        font-weight: 750;
    }

    .visit-details p {
        margin: 8px 0 10px;
        color: #4b5563;
    }

    .detail-list {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: #4b5563;
        font-size: 14px;
    }

    .order-overview {
        align-items: center;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .order-overview small {
        display: block;
        margin-bottom: 4px;
        color: #6b7280;
    }

    .order-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 18px;
    }

    .order-metrics div {
        min-width: 0;
        padding: 14px;
        border-radius: 12px;
        background: #f9fafb;
    }

    .order-metrics span,
    .order-metrics strong {
        display: block;
    }

    .order-metrics span {
        margin-bottom: 5px;
        color: #6b7280;
        font-size: 12px;
    }

    .order-metrics strong {
        color: #111827;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .empty-state {
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 160px;
        padding: 24px;
        border: 1px dashed #d1d5db;
        border-radius: 16px;
        background: #f9fafb;
    }

    .compact-empty {
        min-height: 180px;
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        display: flex;
        flex: 0 0 52px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: white;
        font-size: 24px;
    }

    .empty-state p {
        margin: 7px 0 14px;
        color: #6b7280;
    }

    .quick-actions-section {
        padding-bottom: 12px;
    }

    .section-heading {
        margin-bottom: 15px;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .quick-action-card {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        padding: 18px;
        border-radius: 15px;
        color: #1f2937;
        text-decoration: none;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            border-color 0.18s ease;
    }

    .quick-action-card:hover {
        transform: translateY(-2px);
        border-color: #f59e0b;
        color: #111827;
        box-shadow: 0 12px 28px rgba(31, 41, 55, 0.09);
    }

    .quick-action-icon {
        width: 44px;
        height: 44px;
        display: flex;
        flex: 0 0 44px;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #fff7ed;
        font-size: 20px;
    }

    .quick-action-card strong,
    .quick-action-card small {
        display: block;
    }

    .quick-action-card strong {
        margin-bottom: 3px;
    }

    .quick-action-card small {
        color: #6b7280;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 1150px) {
        .dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-content-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .dashboard-summary-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-hero {
            padding: 28px;
        }

        .dashboard-hero h1 {
            font-size: 29px;
        }

        .order-metrics {
            grid-template-columns: 1fr;
        }

        .quick-actions-grid {
            grid-template-columns: 1fr;
        }

        .visit-card {
            align-items: flex-start;
        }
    }
</style>