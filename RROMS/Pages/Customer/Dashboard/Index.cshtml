@page
@using System.Globalization
@model RROMS.Pages.Customer.Dashboard.IndexModel

@{
    ViewData["Title"] = "Home";

    string nextReservationTime =
        Model.NextReservation == null
            ? string.Empty
            : DateTime.Today
                .Add(Model.NextReservation.Time)
                .ToString("h:mm tt");
}

<div class="customer-dashboard">
    <section class="dashboard-hero">
        <div>
            <span class="hero-label">
                Customer Portal
            </span>

            <h1>
                Welcome back, @Model.CustomerName
            </h1>

            <p>
                Manage your reservations, track your orders, and stay
                updated on your dining experience from one place.
            </p>
        </div>

        <div class="hero-actions">
            <a asp-page="/Customer/Reservations/Create"
               class="btn dashboard-primary-btn">
                Book a Table
            </a>

            <a asp-page="/Customer/Menu/Index"
               class="btn dashboard-secondary-btn">
                Browse Menu
            </a>
        </div>
    </section>

    <section class="dashboard-summary-grid"
             aria-label="Customer overview">

        <article class="summary-card">
            <div class="summary-icon reservation-icon"
                 aria-hidden="true">
                📅
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Next Reservation
                </span>

                @if (Model.NextReservation != null)
                {
                    <strong>
                        @Model.NextReservation.Date.ToString(
                            "dd MMM yyyy")
                    </strong>

                    <small>
                        @nextReservationTime
                        · @Model.BookingReference
                    </small>
                }
                else
                {
                    <strong>Not booked</strong>
                    <small>Plan your next visit</small>
                }
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon order-icon"
                 aria-hidden="true">
                🍽️
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Latest Order
                </span>

                @if (Model.LatestOrder != null)
                {
                    <strong>@Model.OrderReference</strong>

                    <small>
                        @(Model.LatestOrder.Status ?? "Pending")
                        ·
                        RM @((Model.LatestOrder.TotalAmount ?? 0m)
                            .ToString(
                                "0.00",
                                CultureInfo.InvariantCulture))
                    </small>
                }
                else
                {
                    <strong>No orders yet</strong>

                    <small>
                        Browse the menu to get started
                    </small>
                }
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-icon notification-icon"
                 aria-hidden="true">
                🔔
            </div>

            <div class="summary-content">
                <span class="summary-label">
                    Unread Notifications
                </span>

                <strong>
                    @Model.UnreadNotificationCount
                </strong>

                <small>
                    @(Model.UnreadNotificationCount switch
                    {
                        0 => "You're all caught up",
                        1 => "New update waiting",
                        _ => "New updates waiting"
                    })
                </small>
            </div>
        </article>
    </section>

    <section class="dashboard-content-grid">
        <div class="dashboard-panel next-visit-panel">
            <div class="panel-header">
                <div>
                    <span class="panel-eyebrow">
                        Upcoming
                    </span>

                    <h2>Your Next Visit</h2>
                </div>

                <a asp-page="/Customer/Reservations/Index"
                   class="panel-link">
                    View reservations
                </a>
            </div>

            @if (Model.NextReservation != null)
            {
                <div class="visit-card">
                    <div class="visit-date">
                        <span class="visit-day">
                            @Model.NextReservation.Date.ToString("dd")
                        </span>

                        <span class="visit-month">
                            @Model.NextReservation.Date.ToString("MMM")
                        </span>
                    </div>

                    <div class="visit-details">
                        <div class="d-flex
                                    align-items-center
                                    gap-2
                                    flex-wrap">

                            <h3>@Model.BookingReference</h3>

                            <span class="badge
                                         @RROMS.Pages.Customer.Dashboard.IndexModel.ReservationBadgeClass(
                                             Model.NextReservation.Status)">
                                @(Model.NextReservation.Status
                                    ?? "Pending")
                            </span>
                        </div>

                        <p>
                            @Model.NextReservation.Date.ToString(
                                "dddd, dd MMMM yyyy")
                            at
                            @nextReservationTime
                        </p>

                        <div class="detail-list">
                            <span>
                                <strong>Table:</strong>

                                @(Model.NextReservation.Table?.TableNumber
                                    ?? "-")
                            </span>

                            <span>
                                <strong>Guests:</strong>

                                @Model.NextReservation.NumberOfGuests
                            </span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon"
                         aria-hidden="true">
                        📅
                    </div>

                    <div>
                        <h3>No upcoming reservation</h3>

                        <p>
                            Book a table and start planning your next
                            dining experience.
                        </p>

                        <a asp-page="/Customer/Reservations/Create"
                           class="btn dashboard-primary-btn">
                            Book a Table
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="dashboard-panel latest-order-panel">
            <div class="panel-header">
                <div>
                    <span class="panel-eyebrow">
                        Recent
                    </span>

                    <h2>Latest Order</h2>
                </div>

                <a asp-page="/Customer/Orders/Index"
                   class="panel-link">
                    View orders
                </a>
            </div>

            @if (Model.LatestOrder != null)
            {
                <div class="order-overview">
                    <div>
                        <small>Order reference</small>
                        <h3>@Model.OrderReference</h3>
                    </div>

                    <span class="badge
                                 @RROMS.Pages.Customer.Dashboard.IndexModel.OrderBadgeClass(
                                     Model.LatestOrder.Status)">
                        @(Model.LatestOrder.Status ?? "Pending")
                    </span>
                </div>

                <div class="order-metrics">
                    <div>
                        <span>Total</span>

                        <strong>
                            RM @((Model.LatestOrder.TotalAmount ?? 0m)
                                .ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture))
                        </strong>
                    </div>

                    <div>
                        <span>Placed</span>

                        <strong>
                            @(Model.LatestOrder.OrderDate?.ToString(
                                "dd MMM yyyy")
                                ?? "Not recorded")
                        </strong>
                    </div>

                    <div>
                        <span>Booking</span>

                        <strong>
                            @(Model.LatestOrder.ReservationID.HasValue
                                ? $"RES-{Model.LatestOrder.ReservationID.Value:D6}"
                                : "Not linked")
                        </strong>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state compact-empty">
                    <div class="empty-icon"
                         aria-hidden="true">
                        🍽️
                    </div>

                    <div>
                        <h3>No orders yet</h3>

                        <p>
                            Browse the menu and add your first meal to
                            the cart.
                        </p>

                        <a asp-page="/Customer/Menu/Index"
                           class="btn dashboard-secondary-btn">
                            Browse Menu
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    @if (Model.HasRecommendations)
{
    <section class="recommendations-section">
        <div class="recommendations-header">
            <div>
                <span class="panel-eyebrow">
                    @Model.RecommendationEyebrow
                </span>

                <h2>@Model.RecommendationTitle</h2>

                <p>
                    @Model.RecommendationDescription
                </p>
            </div>

            <a asp-page="/Customer/Menu/Index"
               class="panel-link">
                View full menu
            </a>
        </div>

        <div class="recommendation-grid">
            @foreach (var dish in Model.RecommendedDishes)
            {
                <article class="recommendation-card">
                    <div class="recommendation-image-wrapper">
                        @if (!string.IsNullOrWhiteSpace(
                            dish.ImageURL))
                        {
                            <img src="@dish.ImageURL"
                                 alt="@dish.Name"
                                 class="recommendation-image"
                                 loading="lazy"
                                 onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');" />

                            <div class="recommendation-image-fallback d-none"
                                 aria-hidden="true">
                                @GetMenuInitials(dish.Name)
                            </div>
                        }
                        else
                        {
                            <div class="recommendation-image-fallback"
                                 aria-hidden="true">
                                @GetMenuInitials(dish.Name)
                            </div>
                        }

                        <span class="recommendation-category">
                            @dish.CategoryName
                        </span>
                    </div>

                    <div class="recommendation-content">
                        <div class="recommendation-title-row">
                            <h3>@dish.Name</h3>

                            <strong>
                                RM @dish.Price.ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture)
                            </strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            dish.Description))
                        {
                            <p class="recommendation-description">
                                @dish.Description
                            </p>
                        }
                        else
                        {
                            <p class="recommendation-description">
                                An available Dineflow dish selected
                                for your next dining experience.
                            </p>
                        }

                        <div class="recommendation-reason">
                            <span aria-hidden="true">
                                @(Model.RecommendationsArePersonalized
                                    ? "★"
                                    : "↗")
                            </span>

                            <span>@dish.Reason</span>
                        </div>

                        <div class="recommendation-actions">
                            <a asp-page="/Customer/Menu/Index"
                               class="recommendation-menu-link">
                                View Menu
                            </a>

                            <form method="post"
                                  asp-page="/Customer/Cart/Index"
                                  asp-page-handler="Add"
                                  class="recommendation-cart-form">

                                <input type="hidden"
                                       name="menuItemId"
                                       value="@dish.MenuItemID" />

                                <input type="hidden"
                                       name="quantity"
                                       value="1" />

                                <button type="submit"
                                        class="recommendation-add-button">
                                    Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="recommendation-explanation">
            <span class="recommendation-explanation-icon"
                  aria-hidden="true">
                i
            </span>

            <p>
                @if (Model.RecommendationsArePersonalized)
                {
                    <text>
                        Recommendations use your previous
                        non-cancelled orders and currently available
                        dishes. Recently ordered items are avoided
                        when other choices are available.
                    </text>
                }
                else
                {
                    <text>
                        These suggestions use currently available
                        dishes and ordering popularity across
                        Dineflow.
                    </text>
                }
            </p>
        </div>
    </section>
}

    <section class="quick-actions-section">
        <div class="section-heading">
            <div>
                <span class="panel-eyebrow">
                    Shortcuts
                </span>

                <h2>Quick Actions</h2>
            </div>
        </div>

        <div class="quick-actions-grid">
            <a asp-page="/Customer/Reservations/Create"
               class="quick-action-card">

                <span class="quick-action-icon"
                      aria-hidden="true">
                    📅
                </span>

                <span>
                    <strong>Book a Table</strong>
                    <small>Plan your next visit</small>
                </span>
            </a>

            <a asp-page="/Customer/Menu/Index"
               class="quick-action-card">

                <span class="quick-action-icon"
                      aria-hidden="true">
                    📖
                </span>

                <span>
                    <strong>Browse Menu</strong>
                    <small>Explore available dishes</small>
                </span>
            </a>

            <a asp-page="/Customer/Orders/Index"
               class="quick-action-card">

                <span class="quick-action-icon"
                      aria-hidden="true">
                    🍽️
                </span>

                <span>
                    <strong>Track Orders</strong>
                    <small>Follow order progress</small>
                </span>
            </a>

            <a asp-page="/Customer/Notifications/Index"
               class="quick-action-card">

                <span class="quick-action-icon"
                      aria-hidden="true">
                    🔔
                </span>

                <span>
                    <strong>Notifications</strong>

                    <small>
                        @Model.UnreadNotificationCount unread
                    </small>
                </span>
            </a>
        </div>
    </section>
</div>

@functions {
    private static string GetMenuInitials(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "DF";
        }

        string[] words =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        words[0].Length))
                .ToUpperInvariant();
        }

        return string.Concat(
            words
                .Take(2)
                .Select(word =>
                    char.ToUpperInvariant(
                        word[0])));
    }
}

<style>
    .customer-dashboard {
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    .dashboard-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 38px 40px;
        border-radius: 22px;
        color: white;
        background:
            radial-gradient(
                circle at top right,
                rgba(245, 158, 11, 0.35),
                transparent 34%
            ),
            linear-gradient(
                135deg,
                #111827 0%,
                #1f2937 60%,
                #374151 100%
            );
        box-shadow:
            0 18px 40px rgba(31, 41, 55, 0.16);
    }

    .hero-label,
    .panel-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .dashboard-hero h1 {
        margin: 0 0 12px;
        color: #ffffff;
        font-size: 36px;
        font-weight: 800;
    }

    .dashboard-hero p {
        max-width: 690px;
        margin: 0;
        color: #d1d5db;
        line-height: 1.65;
    }

    .hero-actions {
        display: flex;
        flex-shrink: 0;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dashboard-primary-btn,
    .dashboard-secondary-btn {
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 700;
    }

    .dashboard-primary-btn {
        border-color: #f59e0b;
        color: #111827;
        background: #f59e0b;
    }

    .dashboard-primary-btn:hover {
        border-color: #d97706;
        color: white;
        background: #d97706;
    }

    .dashboard-secondary-btn {
        border: 1px solid #d1d5db;
        color: #1f2937;
        background: white;
    }

    .dashboard-secondary-btn:hover {
        border-color: #9ca3af;
        color: #111827;
        background: #f9fafb;
    }

    .dashboard-summary-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .summary-card,
    .dashboard-panel,
    .quick-action-card {
        border: 1px solid #e5e7eb;
        background: white;
        box-shadow:
            0 8px 22px rgba(31, 41, 55, 0.05);
    }

    .summary-card {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-radius: 16px;
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        display: flex;
        flex: 0 0 50px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 22px;
    }

    .reservation-icon {
        background: #fff7ed;
    }

    .order-icon {
        background: #eff6ff;
    }

    .notification-icon {
        background: #fef2f2;
    }

    .summary-content {
        min-width: 0;
    }

    .summary-content span,
    .summary-content strong,
    .summary-content small {
        display: block;
    }

    .summary-label {
        margin-bottom: 4px;
        color: #6b7280;
        font-size: 13px;
    }

    .summary-content strong {
        color: #111827;
        font-size: 18px;
    }

    .summary-content small {
        margin-top: 3px;
        color: #6b7280;
        overflow-wrap: anywhere;
    }

    .dashboard-content-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.25fr)
            minmax(340px, 0.75fr);
        gap: 20px;
    }

    .dashboard-panel {
        padding: 26px;
        border-radius: 18px;
    }

    .panel-header,
    .section-heading,
    .order-overview {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .panel-header {
        margin-bottom: 22px;
    }

    .panel-header h2,
    .section-heading h2 {
        margin: 0;
        color: #111827;
        font-size: 22px;
        font-weight: 750;
    }

    .panel-link {
        color: #b45309;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .panel-link:hover {
        color: #92400e;
        text-decoration: underline;
    }

    .visit-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 22px;
        border: 1px solid #fde68a;
        border-radius: 16px;
        background: #fffbeb;
    }

    .visit-date {
        width: 72px;
        height: 78px;
        display: flex;
        flex: 0 0 72px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: white;
        background: #1f2937;
    }

    .visit-day {
        font-size: 26px;
        font-weight: 800;
        line-height: 1;
    }

    .visit-month {
        margin-top: 6px;
        color: #fbbf24;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .visit-details h3,
    .order-overview h3,
    .empty-state h3 {
        margin: 0;
        color: #111827;
        font-size: 18px;
        font-weight: 750;
    }

    .visit-details p {
        margin: 8px 0 10px;
        color: #4b5563;
    }

    .detail-list {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: #4b5563;
        font-size: 14px;
    }

    .order-overview {
        align-items: center;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .order-overview small {
        display: block;
        margin-bottom: 4px;
        color: #6b7280;
    }

    .order-metrics {
        display: grid;
        grid-template-columns:
            repeat(3, 1fr);
        gap: 12px;
        margin-top: 18px;
    }

    .order-metrics div {
        min-width: 0;
        padding: 14px;
        border-radius: 12px;
        background: #f9fafb;
    }

    .order-metrics span,
    .order-metrics strong {
        display: block;
    }

    .order-metrics span {
        margin-bottom: 5px;
        color: #6b7280;
        font-size: 12px;
    }

    .order-metrics strong {
        color: #111827;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .empty-state {
        display: flex;
        min-height: 160px;
        align-items: center;
        gap: 18px;
        padding: 24px;
        border: 1px dashed #d1d5db;
        border-radius: 16px;
        background: #f9fafb;
    }

    .compact-empty {
        min-height: 180px;
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        display: flex;
        flex: 0 0 52px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: white;
        font-size: 24px;
    }

    .empty-state p {
        margin: 7px 0 14px;
        color: #6b7280;
    }

    .quick-actions-section {
        padding-bottom: 12px;
    }

    .section-heading {
        margin-bottom: 15px;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .quick-action-card {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border-radius: 15px;
        color: #1f2937;
        text-decoration: none;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            border-color 0.18s ease;
    }

    .quick-action-card:hover {
        border-color: #f59e0b;
        color: #111827;
        box-shadow:
            0 12px 28px rgba(31, 41, 55, 0.09);
        transform: translateY(-2px);
    }

    .quick-action-icon {
        width: 44px;
        height: 44px;
        display: flex;
        flex: 0 0 44px;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #fff7ed;
        font-size: 20px;
    }

    .quick-action-card strong,
    .quick-action-card small {
        display: block;
    }

    .quick-action-card strong {
        margin-bottom: 3px;
    }

    .quick-action-card small {
        color: #6b7280;
        overflow-wrap: anywhere;
    }

    .recommendations-section {
    padding: 26px;
    border: 1px solid #e5e7eb;
    border-radius: 19px;
    background: white;
    box-shadow:
        0 9px 27px rgba(31, 41, 55, 0.06);
}

.recommendations-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
}

.recommendations-header h2 {
    margin: 0 0 6px;
    color: #111827;
    font-size: 23px;
    font-weight: 800;
}

.recommendations-header p {
    margin: 0;
    color: #6b7280;
    font-size: 13px;
    line-height: 1.55;
}

.recommendation-grid {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
    gap: 17px;
}

.recommendation-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    background: white;
    box-shadow:
        0 7px 20px rgba(31, 41, 55, 0.05);
    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

.recommendation-card:hover {
    border-color: #fbbf24;
    box-shadow:
        0 13px 30px rgba(31, 41, 55, 0.1);
    transform: translateY(-3px);
}

.recommendation-image-wrapper {
    position: relative;
    height: 170px;
    overflow: hidden;
    background:
        linear-gradient(
            135deg,
            #ffedd5,
            #fde68a
        );
}

.recommendation-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition:
        transform 0.25s ease;
}

.recommendation-card:hover
.recommendation-image {
