@page
@model RROMS.Pages.Customer.Help.IndexModel

@{
    ViewData["Title"] = "Help Assistant";
}

<div class="container py-4 help-page">
    <header class="help-header">
        <div>
            <span class="help-eyebrow">
                Customer Support
            </span>

            <h1>Dineflow Help Assistant</h1>

            <p>
                Ask about reservations, orders, payments, receipts,
                notifications, feedback, or account settings.
            </p>
        </div>

        <span class="assistant-type">
            Dineflow Guidance
        </span>
    </header>

    <section class="assistant-introduction">
        <div class="assistant-avatar"
             aria-hidden="true">

            <svg viewBox="0 0 24 24">
                <path d="M7 8.5h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-5l-4 2v-2H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z" />
                <path d="M9 13h.01" />
                <path d="M15 13h.01" />
                <path d="M12 8.5V5" />
                <circle cx="12"
                        cy="4"
                        r="1" />
            </svg>
        </div>

        <div>
            <span class="assistant-label">
                Dineflow Assistant
            </span>

            <h2>How can I help?</h2>

            <p>
                Get quick, reliable guidance based on the actual
                Dineflow reservation, ordering, payment, and account
                workflows.
            </p>
        </div>
    </section>

    <div class="help-layout">
        <main class="assistant-panel">
            <div class="chat-header">
                <div class="chat-header-status">
                    <span class="online-indicator"
                          aria-hidden="true">
                    </span>

                    <strong>Dineflow Assistant</strong>

                    <span class="chat-ready-text">
                        Ready to help
                    </span>
                </div>

                @if (Model.HasConversation)
                {
                    <form method="post"
                          asp-page-handler="Clear"
                          id="clearConversationForm"
                          class="clear-conversation-form">

                        <button type="button"
                                class="clear-conversation-button"
                                data-bs-toggle="modal"
                                data-bs-target="#clearConversationModal">
                            Clear conversation
                        </button>
                    </form>
                }
            </div>

            <section id="chatWindow"
                     class="chat-window"
                     aria-live="polite">

                @if (!Model.HasConversation)
                {
                    <div class="chat-message assistant-message">
                        <div class="chat-avatar"
                             aria-hidden="true">

                            <svg viewBox="0 0 24 24">
                                <path d="M7 8.5h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-5l-4 2v-2H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z" />
                                <path d="M9 13h.01" />
                                <path d="M15 13h.01" />
                                <path d="M12 8.5V5" />
                                <circle cx="12"
                                        cy="4"
                                        r="1" />
                            </svg>
                        </div>

                        <div class="chat-message-content">
                            <span class="chat-sender">
                                Dineflow Assistant
                            </span>

                            <div class="chat-bubble assistant-bubble">
                                <p>
                                    Hello! I’m the Dineflow Help
                                    Assistant.
                                </p>

                                <p>
                                    I can guide you through
                                    reservations, menu and cart,
                                    checkout, payments, order tracking,
                                    receipts, notifications, feedback,
                                    and profile settings.
                                </p>

                                <p>
                                    Type a question below or select
                                    one of the quick questions.
                                </p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var entry in Model.Conversation)
                    {
                        <div class="chat-exchange">
                            <div class="chat-message user-message">
                                <div class="chat-message-content">
                                    <span class="chat-sender user-sender">
                                        You
                                    </span>

                                    <div class="chat-bubble user-bubble">
                                        <p>@entry.Question</p>
                                    </div>

                                    <time class="chat-time"
                                          datetime="@entry.CreatedAt.ToString("O")">
                                        @entry.CreatedAt.ToString("h:mm tt")
                                    </time>
                                </div>

                                <div class="user-avatar"
                                     aria-hidden="true">
                                    You
                                </div>
                            </div>

                            <div class="chat-message assistant-message">
                                <div class="chat-avatar"
                                     aria-hidden="true">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M7 8.5h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-5l-4 2v-2H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z" />
                                        <path d="M9 13h.01" />
                                        <path d="M15 13h.01" />
                                        <path d="M12 8.5V5" />
                                        <circle cx="12"
                                                cy="4"
                                                r="1" />
                                    </svg>
                                </div>

                                <div class="chat-message-content">
                                    <span class="chat-sender">
                                        Dineflow Assistant
                                    </span>

                                    <div class="chat-bubble assistant-bubble">
                                        <h2>
                                            @entry.Response.Title
                                        </h2>

                                        <p>
                                            @entry.Response.Answer
                                        </p>

                                        @if (entry.Response.Steps.Any())
                                        {
                                            <div class="chat-steps">
                                                <span>What to do</span>

                                                <ol>
                                                    @foreach (
                                                        string step in
                                                        entry.Response.Steps)
                                                    {
                                                        <li>@step</li>
                                                    }
                                                </ol>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                                entry.Response.ActionPage) &&
                                             !string.IsNullOrWhiteSpace(
                                                entry.Response.ActionText))
                                        {
                                            <a href="@entry.Response.ActionPage"
                                               class="response-action">

                                                @entry.Response.ActionText

                                                <span aria-hidden="true">
                                                    →
                                                </span>
                                            </a>
                                        }

                                        @if (entry.Response.Intent ==
                                            "Fallback")
                                        {
                                            <div class="fallback-note">
                                                This assistant provides
                                                predefined Dineflow
                                                guidance and does not
                                                use an external
                                                generative-AI service.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div id="typingIndicator"
                     class="chat-message assistant-message typing-message"
                     aria-live="polite">

                    <div class="chat-avatar"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M7 8.5h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-5l-4 2v-2H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z" />
                            <path d="M9 13h.01" />
                            <path d="M15 13h.01" />
                            <path d="M12 8.5V5" />
                            <circle cx="12"
                                    cy="4"
                                    r="1" />
                        </svg>
                    </div>

                    <div class="typing-bubble">
                        <span></span>
                        <span></span>
                        <span></span>

                        <span class="visually-hidden">
                            Dineflow Assistant is responding
                        </span>
                    </div>
                </div>
            </section>

            <form method="post"
                  novalidate
                  id="questionForm"
                  class="question-form">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary">
                </div>

                <label asp-for="Question"
                       class="visually-hidden">
                    Ask Dineflow Assistant
                </label>

                <div class="question-input-row">
                    <textarea asp-for="Question"
                              class="form-control question-input"
                              rows="2"
                              maxlength="300"
                              placeholder="Ask Dineflow Assistant a question..."></textarea>

                    <button type="submit"
                            id="askButton"
                            class="ask-button">

                        <span>Send</span>

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="m5 12 14-7-4 14-3-6-7-1Z" />
                            <path d="m12 13 7-8" />
                        </svg>
                    </button>
                </div>

                <div class="question-details">
                    <span asp-validation-for="Question"
                          class="text-danger small">
                    </span>

                    <span class="question-counter">
                        <strong id="questionCharacterCount">
                            0
                        </strong>
                        / 300
                    </span>
                </div>
            </form>
        </main>

        <aside class="suggestions-panel">
            <div class="suggestions-heading">
                <span class="help-eyebrow">
                    Conversation Starters
                </span>

                <h2>Quick Questions</h2>

                <p>
                    Select a question to ask the assistant immediately.
                </p>
            </div>

            <div class="suggested-question-list">
                @foreach (string suggestion in
                    Model.SuggestedQuestions)
                {
                    <button type="button"
                            class="suggested-question"
                            data-suggested-question="@suggestion">

                        <span class="suggested-question-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24">
                                <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" />
                                <path d="M8 9h8M8 13h5" />
                            </svg>
                        </span>

                        <span class="suggested-question-text">
                            @suggestion
                        </span>

                        <span class="suggested-question-arrow"
                              aria-hidden="true">
                            →
                        </span>
                    </button>
                }
            </div>

            <div class="assistant-boundary">
                <div class="boundary-icon"
                     aria-hidden="true">
                    i
                </div>

                <div>
                    <strong>Guidance only</strong>

                    <p>
                        The assistant explains where to go and what
                        to do. It cannot create reservations, place
                        orders, process payments, or change account
                        details.
                    </p>
                </div>
            </div>
        </aside>
    </div>

    @if (Model.HasConversation)
    {
        <div class="modal fade"
             id="clearConversationModal"
             tabindex="-1"
             aria-labelledby="clearConversationModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content conversation-modal">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5"
                            id="clearConversationModalLabel">
                            Clear this conversation?
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        All Help Assistant questions and responses
                        from this browser session will be removed.
                        Your cart and other Dineflow data will not
                        be affected.
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Keep conversation
                        </button>

                        <button type="submit"
                                class="btn btn-danger"
                                form="clearConversationForm">
                            Yes, clear conversation
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="supported-topics">
        <div class="supported-topics-heading">
            <span class="help-eyebrow">
                Supported Help
            </span>

            <h2>Topics this assistant understands</h2>
        </div>

        <div class="topic-grid">
            <article>
                <span aria-hidden="true">R</span>

                <div>
                    <strong>Reservations</strong>

                    <small>
                        Book, edit, cancel, status, and duration
                    </small>
                </div>
            </article>

            <article>
                <span aria-hidden="true">M</span>

                <div>
                    <strong>Menu and Cart</strong>

                    <small>
                        Browse dishes and manage cart items
                    </small>
                </div>
            </article>

            <article>
                <span aria-hidden="true">P</span>

                <div>
                    <strong>Checkout and Payment</strong>

                    <small>
                        Reservation linking, Card, and Cash
                    </small>
                </div>
            </article>

            <article>
                <span aria-hidden="true">O</span>

                <div>
                    <strong>Orders</strong>

                    <small>
                        Progress tracking and status meanings
                    </small>
                </div>
            </article>

            <article>
                <span aria-hidden="true">H</span>

                <div>
                    <strong>History and Receipts</strong>

                    <small>
                        Past records, receipts, and summaries
                    </small>
                </div>
            </article>

            <article>
                <span aria-hidden="true">A</span>

                <div>
                    <strong>Account Help</strong>

                    <small>
                        Notifications, feedback, and password
                    </small>
                </div>
            </article>
        </div>
    </section>
</div>

<style>
    .help-page {
        max-width: 1120px;
    }

    .help-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
    }

    .help-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #d97706;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .help-header h1 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 32px;
        font-weight: 800;
    }

    .help-header p {
        max-width: 700px;
        margin: 0;
        color: #6b7280;
        line-height: 1.55;
    }

    .assistant-type {
        flex-shrink: 0;
        padding: 7px 12px;
        border: 1px solid #fde68a;
        border-radius: 999px;
        color: #92400e;
        background: #fffbeb;
        font-size: 10px;
        font-weight: 800;
    }

    .assistant-introduction {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 20px;
        padding: 22px 24px;
        border-radius: 17px;
        color: white;
        background:
            radial-gradient(
                circle at 90% 18%,
                rgba(245, 158, 11, 0.28),
                transparent 28%
            ),
            linear-gradient(
                135deg,
                #111827,
                #1f2937
            );
        box-shadow:
            0 12px 30px rgba(31, 41, 55, 0.12);
    }

    .assistant-avatar {
        width: 62px;
        height: 62px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border:
            1px solid rgba(255, 255, 255, 0.18);
        border-radius: 18px;
        color: #111827;
        background:
            linear-gradient(
                135deg,
                #fbbf24,
                #f59e0b
            );
        box-shadow:
            0 10px 24px rgba(245, 158, 11, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    .assistant-avatar svg {
        width: 32px;
        height: 32px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .assistant-label {
        display: block;
        margin-bottom: 4px;
        color: #fbbf24;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .assistant-introduction h2 {
        margin: 0 0 5px;
        color: white;
        font-size: 21px;
        font-weight: 800;
    }

    .assistant-introduction p {
        max-width: 740px;
        margin: 0;
        color: #d1d5db;
        font-size: 12px;
        line-height: 1.55;
    }

    .help-layout {
        display: grid;
        grid-template-columns:
            minmax(0, 1.45fr)
            minmax(280px, 0.55fr);
        gap: 20px;
        align-items: start;
    }

    .assistant-panel,
    .suggestions-panel,
    .supported-topics {
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        background: white;
        box-shadow:
            0 9px 27px rgba(31, 41, 55, 0.06);
    }

    .assistant-panel {
        overflow: hidden;
    }

    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 50px;
        padding: 10px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    .chat-header-status {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-header strong {
        color: #1f2937;
        font-size: 12px;
    }

    .chat-ready-text {
        margin-left: 4px;
        color: #6b7280;
        font-size: 10px;
        font-weight: 500;
    }

    .online-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow:
            0 0 0 3px rgba(16, 185, 129, 0.14);
    }

    .clear-conversation-form {
        margin: 0;
    }

    .clear-conversation-button {
        padding: 6px 10px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #b91c1c;
        background: #fef2f2;
        font-size: 9px;
        font-weight: 800;
    }

    .clear-conversation-button:hover {
        border-color: #dc2626;
        color: white;
        background: #dc2626;
    }

    .chat-window {
        min-height: 390px;
        max-height: 560px;
        display: flex;
        flex-direction: column;
        gap: 19px;
        overflow-y: auto;
        padding: 24px;
        background:
            linear-gradient(
                180deg,
                #ffffff,
                #fafafa
            );
        scroll-behavior: smooth;
    }

    .chat-exchange {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-exchange + .chat-exchange {
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
    }

    .chat-message {
        display: flex;
        gap: 11px;
    }

    .assistant-message {
        align-items: flex-start;
    }

    .user-message {
        align-items: flex-start;
        justify-content: flex-end;
    }

    .chat-avatar,
    .user-avatar {
        width: 40px;
        height: 40px;
        display: flex;
        flex: 0 0 40px;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    .chat-avatar {
        color: #111827;
        background:
            linear-gradient(
                135deg,
                #fbbf24,
                #f59e0b
            );
    }

    .chat-avatar svg {
        width: 21px;
        height: 21px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .user-avatar {
        color: white;
        background: #334155;
        font-size: 9px;
        font-weight: 850;
    }

    .chat-message-content {
        max-width: 82%;
        min-width: 0;
    }

    .user-message .chat-message-content {
        display: flex;
        align-items: flex-end;
        flex-direction: column;
    }

    .chat-sender {
        display: block;
        margin: 0 0 5px 4px;
        color: #92400e;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .user-sender {
        margin-right: 4px;
        color: #64748b;
        text-align: right;
    }

    .chat-time {
        display: block;
        margin-top: 5px;
        color: #9ca3af;
        font-size: 8px;
    }

    .user-message .chat-time {
        margin-right: 4px;
        text-align: right;
    }

    .chat-bubble {
        padding: 15px 17px;
        border: 1px solid #e5e7eb;
        border-radius: 6px 18px 18px;
        box-shadow:
            0 5px 15px rgba(31, 41, 55, 0.045);
    }

    .assistant-bubble {
        color: #374151;
        background: white;
    }

    .user-bubble {
        border-color: #1f2937;
        border-radius: 18px 6px 18px 18px;
        color: white;
        background:
            linear-gradient(
                135deg,
                #1f2937,
                #334155
            );
    }

    .chat-bubble h2 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 17px;
        font-weight: 800;
    }

    .chat-bubble p {
        margin: 0 0 9px;
        font-size: 12px;
        line-height: 1.62;
    }

    .user-bubble p {
        margin: 0;
        color: white;
    }

    .chat-bubble p:last-child {
        margin-bottom: 0;
    }

    .chat-steps {
        margin-top: 14px;
        padding: 14px;
        border-radius: 11px;
        background: #f8fafc;
    }

    .chat-steps > span {
        display: block;
        margin-bottom: 7px;
        color: #64748b;
        font-size: 8px;
        font-weight: 850;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .chat-steps ol {
        margin: 0;
        padding-left: 19px;
        color: #374151;
        font-size: 11px;
        line-height: 1.6;
    }

    .chat-steps li + li {
        margin-top: 4px;
    }

    .response-action {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
        padding: 8px 13px;
        border: 1px solid #f59e0b;
        border-radius: 9px;
        color: #111827;
        background: #f59e0b;
        font-size: 10px;
        font-weight: 850;
        text-decoration: none;
    }

    .response-action:hover {
        border-color: #d97706;
        color: white;
        background: #d97706;
    }

    .fallback-note {
        margin-top: 13px;
        padding: 10px 12px;
        border-radius: 9px;
        color: #78350f;
        background: #fffbeb;
        font-size: 9px;
        line-height: 1.5;
    }

    .typing-message {
        display: none;
    }

    .typing-message.visible {
        display: flex;
    }

    .typing-bubble {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 40px;
        padding: 11px 15px;
        border: 1px solid #e5e7eb;
        border-radius: 6px 16px 16px;
        background: white;
    }

    .typing-bubble > span:not(.visually-hidden) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #9ca3af;
        animation:
            typingPulse 1s infinite ease-in-out;
    }

    .typing-bubble > span:nth-child(2) {
        animation-delay: 0.15s;
    }

    .typing-bubble > span:nth-child(3) {
        animation-delay: 0.3s;
    }

    @@keyframes typingPulse {
        0%,
        60%,
        100% {
            opacity: 0.35;
            transform: translateY(0);
        }

        30% {
            opacity: 1;
            transform: translateY(-3px);
        }
    }

    .question-form {
        padding: 18px;
        border-top: 1px solid #e5e7eb;
        background: #fffdf8;
    }

    .validation-summary.validation-summary-valid {
        display: none;
    }

    .question-input-row {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr) auto;
        gap: 10px;
        align-items: stretch;
    }

    .question-input {
        min-height: 58px;
        max-height: 125px;
        padding: 12px 14px;
