</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const question =
                document.getElementById(
                    "Question"
                );

            const questionForm =
                document.getElementById(
                    "questionForm"
                );

            const askButton =
                document.getElementById(
                    "askButton"
                );

            const questionCharacterCount =
                document.getElementById(
                    "questionCharacterCount"
                );

            const typingIndicator =
                document.getElementById(
                    "typingIndicator"
                );

            const chatWindow =
                document.getElementById(
                    "chatWindow"
                );

            let submitting =
                false;

            function updateQuestionCount() {
                if (!question ||
                    !questionCharacterCount) {
                    return;
                }

                questionCharacterCount.textContent =
                    question.value.length.toString();
            }

            function scrollChatToBottom() {
                if (!chatWindow) {
                    return;
                }

                chatWindow.scrollTop =
                    chatWindow.scrollHeight;
            }

            function beginSubmission() {
                if (submitting ||
                    !questionForm ||
                    !question ||
                    !askButton) {
                    return;
                }

                if (!questionForm.checkValidity() ||
                    !question.value.trim()) {
                    questionForm.reportValidity();
                    return;
                }

                submitting =
                    true;

                typingIndicator?.classList.add(
                    "visible"
                );

                askButton.disabled =
                    true;

                askButton.innerHTML =
                    "<span>Sending...</span>";

                scrollChatToBottom();

                window.setTimeout(
                    function () {
                        questionForm.submit();
                    },
                    550
                );
            }

            question?.addEventListener(
                "input",
                updateQuestionCount
            );

            question?.addEventListener(
                "keydown",
                function (event) {
                    if (event.key === "Enter" &&
                        !event.shiftKey) {
                        event.preventDefault();
                        beginSubmission();
                    }
                }
            );

            questionForm?.addEventListener(
                "submit",
                function (event) {
                    if (submitting) {
                        return;
                    }

                    event.preventDefault();
                    beginSubmission();
                }
            );

            document
                .querySelectorAll(
                    "[data-suggested-question]"
                )
                .forEach(function (button) {
                    button.addEventListener(
                        "click",
                        function () {
                            if (!question ||
                                submitting) {
                                return;
                            }

                            question.value =
                                button.getAttribute(
                                    "data-suggested-question"
                                ) ?? "";

                            updateQuestionCount();
                            beginSubmission();
                        }
                    );
                });

            if (question) {
                question.value =
                    "";

                updateQuestionCount();
            }

            window.requestAnimationFrame(
                scrollChatToBottom
            );
        })();
    </script>
}