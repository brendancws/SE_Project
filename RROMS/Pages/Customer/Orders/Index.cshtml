</style>

@section Scripts {
    <script>
        (function () {
            const statusOrder = [
                "Pending",
                "Preparing",
                "Ready to Serve",
                "Served",
                "Completed"
            ];

            const lastCheckElement =
                document.getElementById(
                    "lastStatusCheck"
                );

            const changeNotice =
                document.getElementById(
                    "statusChangeNotice"
                );

            const pollingError =
                document.getElementById(
                    "statusPollingError"
                );

            function statusClassFor(status) {
                switch ((status || "").toLowerCase()) {
                    case "pending":
                        return "pending";

                    case "preparing":
                        return "preparing";

                    case "ready to serve":
                        return "ready";

                    case "served":
                        return "served";

                    case "completed":
                        return "completed";

                    case "cancelled":
                        return "cancelled";

                    default:
                        return "other";
                }
            }

            function updateProgress(card, status) {
                const progress =
                    card.querySelector(
                        ".order-progress"
                    );

                const cancelledMessage =
                    card.querySelector(
                        ".order-cancelled-message"
                    );

                if (!progress || !cancelledMessage) {
                    return;
                }

                const steps =
                    Array.from(
                        progress.querySelectorAll(
                            ".order-progress-step"
                        )
                    );

                const lines =
                    Array.from(
                        progress.querySelectorAll(
                            ".order-progress-line"
                        )
                    );

                steps.forEach(function (step) {
                    step.classList.remove(
                        "completed",
                        "current"
                    );
                });

                lines.forEach(function (line) {
                    line.classList.remove(
                        "completed"
                    );
                });

                if (status === "Cancelled") {
                    progress.classList.add(
                        "cancelled"
                    );

                    cancelledMessage.classList.remove(
                        "d-none"
                    );

                    return;
                }

                progress.classList.remove(
                    "cancelled"
                );

                cancelledMessage.classList.add(
                    "d-none"
                );

                const currentIndex =
                    statusOrder.indexOf(status);

                if (currentIndex === -1) {
                    return;
                }

                if (status === "Completed") {
                    steps.forEach(function (step) {
                        step.classList.add(
                            "completed"
                        );
                    });

                    lines.forEach(function (line) {
                        line.classList.add(
                            "completed"
                        );
                    });

                    return;
                }

                steps.forEach(function (step, index) {
                    if (index < currentIndex) {
                        step.classList.add(
                            "completed"
                        );
                    }
                    else if (index === currentIndex) {
                        step.classList.add(
                            "current"
                        );
                    }
                });

                lines.forEach(function (line, index) {
                    if (index < currentIndex) {
                        line.classList.add(
                            "completed"
                        );
                    }
                });
            }

            function updateOrderCard(
                card,
                newStatus
            ) {
                const oldStatus =
                    card.dataset.currentStatus;

                const badge =
                    card.querySelector(
                        ".order-status-badge"
                    );

                if (badge) {
                    badge.textContent =
                        newStatus;

                    badge.className =
                        "order-status-pill " +
                        "order-status-badge " +
                        statusClassFor(newStatus);
                }

                updateProgress(
                    card,
                    newStatus
                );

                card.dataset.currentStatus =
                    newStatus;

                return oldStatus !== newStatus;
            }

            async function pollStatuses() {
                try {
                    const response = await fetch(
                        "?handler=Statuses",
                        {
                            headers: {
                                "Accept":
                                    "application/json"
                            },
                            cache: "no-store"
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            "Status request failed."
                        );
                    }

                    const statuses =
                        await response.json();

                    let anyChanged = false;

                    statuses.forEach(function (item) {
                        const card =
                            document.querySelector(
                                '[data-order-id="' +
                                item.orderId +
                                '"]'
                            );

                        if (!card) {
                            return;
                        }

                        if (updateOrderCard(
                            card,
                            item.status
                        )) {
                            anyChanged = true;
                        }
                    });

                    document
                        .querySelectorAll(
                            "[data-order-id]"
                        )
                        .forEach(function (card) {
                            updateProgress(
                                card,
                                card.dataset.currentStatus
                            );
                        });

                    if (lastCheckElement) {
                        lastCheckElement.textContent =
                            new Date()
                                .toLocaleTimeString();
                    }

                    if (pollingError) {
                        pollingError.classList.add(
                            "d-none"
                        );
                    }

                    if (anyChanged &&
                        changeNotice) {
                        changeNotice.classList.remove(
                            "d-none"
                        );
                    }
                }
                catch (error) {
                    if (pollingError) {
                        pollingError.classList.remove(
                            "d-none"
                        );
                    }
                }
            }

            pollStatuses();

            window.setInterval(
                pollStatuses,
                10000
            );
        })();
    </script>
}