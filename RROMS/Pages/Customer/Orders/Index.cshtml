@page
@using System.Globalization
@model RROMS.Pages.Customer.Orders.IndexModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">My Orders</h2>
        <a asp-page="/Customer/Menu/Index" class="btn btn-primary">Order More Food</a>
    </div>

    @if (TempData["OrderMessage"] is string orderMessage && !string.IsNullOrEmpty(orderMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @orderMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info">You have not placed any orders yet.</div>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            string badgeClass = order.Status.ToLowerInvariant() switch
            {
                "pending" => "bg-warning text-dark",
                "preparing" => "bg-info text-dark",
                "ready to serve" => "bg-primary",
                "served" => "bg-success",
                "completed" => "bg-dark",
                "cancelled" => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@order.OrderID</strong>
                        <span class="text-muted small ms-2">
                            @(order.OrderDate?.ToString("dd MMM yyyy, HH:mm") ?? "-")
                        </span>
                    </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="badge @badgeClass">
        @order.Status
    </span>

    @{
        string paymentBadgeClass =
            (order.PaymentStatus ?? "").ToLowerInvariant() switch
            {
                "paid" => "bg-success",
                "pending" => "bg-warning text-dark",
                "failed" => "bg-danger",
                _ => "bg-secondary"
            };
    }

    <span class="badge @paymentBadgeClass">
        Payment: @(order.PaymentStatus ?? "None")
    </span>

    @if (string.Equals(
        order.PaymentStatus,
        "Paid",
        StringComparison.OrdinalIgnoreCase))
    {
        <a asp-page="/Customer/Orders/Receipt"
           asp-route-id="@order.OrderID"
           class="btn btn-sm btn-outline-success">
            View Receipt
        </a>
    }
    else if (string.Equals(
        order.PaymentStatus,
        "Pending",
        StringComparison.OrdinalIgnoreCase))
    {
        <a asp-page="/Customer/Orders/Receipt"
           asp-route-id="@order.OrderID"
           class="btn btn-sm btn-outline-secondary">
            View Payment Summary
        </a>
    }
    else if (string.Equals(
        order.PaymentStatus,
        "Failed",
        StringComparison.OrdinalIgnoreCase))
    {
        <span class="small text-danger fw-semibold">
            Payment failed
        </span>
    }
</div>            
                </div>
                <div class="card-body pb-2">
                    <p class="text-muted small mb-2">Booking: @order.BookingText</p>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in order.Lines)
                            {
                                <tr>
                                    <td>@line.Name</td>
                                    <td>RM @line.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                    <td>@line.Quantity</td>
                                    <td class="text-end">RM @line.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Total</th>
                                <th class="text-end">RM @order.Total.ToString("0.00", CultureInfo.InvariantCulture)</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    }
</div>