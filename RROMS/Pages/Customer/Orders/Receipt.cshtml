@page "{id:int}"
@using System.Globalization
@model RROMS.Pages.Customer.Orders.ReceiptModel
@{
    ViewData["Title"] = Model.IsPaid
        ? "Payment Receipt"
        : "Payment Summary";

    int totalItems =
        Model.Lines.Sum(line => line.Quantity);

    string paymentStatusClass =
        Model.PaymentStatus.ToLowerInvariant() switch
        {
            "paid" => "paid",
            "pending" => "pending",
            "failed" => "failed",
            _ => "other"
        };
}

<div class="container py-4 receipt-page">
    <header class="receipt-page-header no-print">
        <div>
            <span class="receipt-page-eyebrow">
                Order Payment
            </span>

            <h1>
                @(Model.IsPaid
                    ? "Payment Receipt"
                    : "Payment Summary")
            </h1>

            <p>
                @(Model.IsPaid
                    ? "Review and print the official payment record for this order."
                    : "Review the selected payment method and pending collection details.")
            </p>
        </div>

        <div class="receipt-page-actions">
            <button type="button"
                    class="print-receipt-button"
                    onclick="window.print()">
                Print / Save as PDF
            </button>

            <a asp-page="/Customer/Orders/Index"
               class="back-orders-link">
                Back to My Orders
            </a>
        </div>
    </header>

    <article class="receipt-document">
        <header class="receipt-document-header">
            <div class="receipt-brand">
                <span>Dine</span><strong>flow</strong>
            </div>

            <p>
                @(Model.IsPaid
                    ? "Official Payment Receipt"
                    : "Payment Summary")
            </p>

            <h2>@Model.ReceiptReference</h2>

            <span class="receipt-status-pill @paymentStatusClass">
                @Model.PaymentStatus
            </span>
        </header>

        @if (Model.IsPendingCash)
        {
            <section class="pending-payment-notice">
                <div class="pending-notice-icon"
                     aria-hidden="true">
                    !
                </div>

                <div>
                    <strong>Payment pending</strong>

                    <p>
                        Cash will be collected at the restaurant.
                        This summary is not proof of payment.
                    </p>
                </div>
            </section>
        }

        <section class="receipt-summary-grid">
            <div class="receipt-summary-item">
                <span>Customer</span>
                <strong>@Model.CustomerName</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Receipt Reference</span>
                <strong>@Model.ReceiptReference</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Order Reference</span>
                <strong>@Model.OrderReference</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Booking Reference</span>
                <strong>@Model.BookingReference</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Order Date</span>

                <strong>
                    @(Model.OrderDate?.ToString(
                        "dd MMM yyyy, HH:mm")
                        ?? "Not recorded")
                </strong>
            </div>

            <div class="receipt-summary-item">
                <span>
                    @(Model.IsPaid
                        ? "Payment Date"
                        : "Payment Selection Date")
                </span>

                <strong>
                    @(Model.PaymentDate?.ToString(
                        "dd MMM yyyy, HH:mm")
                        ?? "Not recorded")
                </strong>
            </div>

            <div class="receipt-summary-item">
                <span>Payment Method</span>
                <strong>@Model.PaymentMethod</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Payment Status</span>
                <strong>@Model.PaymentStatus</strong>
            </div>

            <div class="receipt-summary-item">
                <span>Reservation</span>

                <strong>
                    @Model.ReservationDate.ToString("dd MMM yyyy")
                    at
                    @Model.ReservationTime.ToString(@"hh\:mm")
                </strong>
            </div>

            <div class="receipt-summary-item">
                <span>Table</span>
                <strong>@Model.TableNumber</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TransactionNo))
            {
                <div class="receipt-summary-item transaction-summary">
                    <span>Transaction Number</span>
                    <strong>@Model.TransactionNo</strong>
                </div>
            }
        </section>

        <section class="receipt-items-section">
            <div class="receipt-items-heading">
                <div>
                    <span>Order Items</span>

                    <h3>
                        @totalItems
                        @(totalItems == 1 ? "item" : "items")
                    </h3>
                </div>

                <strong>
                    @Model.OrderReference
                </strong>
            </div>

            <div class="receipt-items-table-wrapper">
                <table class="receipt-items-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="number-column">Unit Price</th>
                            <th class="quantity-column">Quantity</th>
                            <th class="number-column">Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    <strong>@line.Name</strong>
                                </td>

                                <td class="number-column">
                                    RM @line.UnitPrice.ToString(
                                        "0.00",
                                        CultureInfo.InvariantCulture)
                                </td>

                                <td class="quantity-column">
                                    @line.Quantity
                                </td>

                                <td class="number-column">
                                    RM @line.Subtotal.ToString(
                                        "0.00",
                                        CultureInfo.InvariantCulture)
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="3">
                                Total
                            </th>

                            <th class="number-column">
                                RM @Model.PaymentAmount.ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture)
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <footer class="receipt-document-footer @(Model.IsPaid ? "paid" : "pending")">
            @if (Model.IsPaid)
            {
                <strong>Payment received</strong>

                <span>
                    Please keep this receipt for your records.
                </span>
            }
            else
            {
                <strong>Pending payment summary</strong>

                <span>
                    Cash has not yet been collected. This document is
                    not proof of payment.
                </span>
            }
        </footer>
    </article>
</div>

<style>
    .receipt-page {
        max-width: 900px;
    }

    .receipt-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .receipt-page-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #d97706;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .receipt-page-header h1 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 31px;
        font-weight: 800;
    }

    .receipt-page-header p {
        max-width: 590px;
        margin: 0;
        color: #6b7280;
        line-height: 1.55;
    }

    .receipt-page-actions {
        display: flex;
        flex-shrink: 0;
        gap: 9px;
    }

    .print-receipt-button,
    .back-orders-link {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 15px;
        border: 1px solid;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 800;
    }

    .print-receipt-button {
        border-color: #2563eb;
        color: white;
        background: #2563eb;
    }

    .print-receipt-button:hover {
        border-color: #1d4ed8;
        background: #1d4ed8;
    }

    .back-orders-link {
        border-color: #d1d5db;
        color: #374151;
        background: white;
        text-decoration: none;
    }

    .back-orders-link:hover {
        border-color: #9ca3af;
        color: #111827;
        background: #f9fafb;
    }

    .receipt-document {
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: white;
        box-shadow:
            0 12px 34px rgba(31, 41, 55, 0.08);
    }

    .receipt-document-header {
        padding: 29px 28px 25px;
        border-bottom: 1px solid #e5e7eb;
        background:
            radial-gradient(
                circle at 82% 20%,
                rgba(245, 158, 11, 0.13),
                transparent 28%
            ),
            linear-gradient(
                135deg,
                #fffdf8,
                #ffffff
            );
        text-align: center;
    }

    .receipt-brand {
        display: flex;
        justify-content: center;
        margin-bottom: 4px;
        color: #111827;
        font-size: 26px;
        font-weight: 800;
    }

    .receipt-brand strong {
        color: #f59e0b;
    }

    .receipt-document-header p {
        margin: 0 0 14px;
        color: #6b7280;
        font-size: 12px;
    }

    .receipt-document-header h2 {
        margin: 0 0 9px;
        color: #111827;
        font-size: 20px;
        font-weight: 850;
        letter-spacing: 0.03em;
    }

    .receipt-status-pill {
        display: inline-flex;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 850;
    }

    .receipt-status-pill.paid {
        color: #065f46;
        background: #d1fae5;
    }

    .receipt-status-pill.pending {
        color: #78350f;
        background: #fef3c7;
    }

    .receipt-status-pill.failed {
        color: #991b1b;
        background: #fee2e2;
    }

    .receipt-status-pill.other {
        color: #374151;
        background: #e5e7eb;
    }

    .pending-payment-notice {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin: 22px 26px 0;
        padding: 14px 15px;
        border: 1px solid #fde68a;
        border-radius: 11px;
        color: #78350f;
        background: #fffbeb;
    }

    .pending-notice-icon {
        width: 28px;
        height: 28px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: white;
        background: #d97706;
        font-size: 14px;
        font-weight: 850;
    }

    .pending-payment-notice strong {
        display: block;
        margin-bottom: 3px;
        font-size: 13px;
    }

    .pending-payment-notice p {
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
    }

    .receipt-summary-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 11px;
        padding: 25px 26px;
    }

    .receipt-summary-item {
        min-width: 0;
        padding: 12px 13px;
        border-radius: 10px;
        background: #f9fafb;
    }

    .receipt-summary-item span,
    .receipt-summary-item strong {
        display: block;
    }

    .receipt-summary-item span {
        margin-bottom: 4px;
        color: #6b7280;
        font-size: 9px;
        font-weight: 750;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .receipt-summary-item strong {
        color: #1f2937;
        font-size: 12px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .transaction-summary {
        grid-column: 1 / -1;
    }

    .receipt-items-section {
        padding: 0 26px 25px;
    }

    .receipt-items-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 12px;
    }

    .receipt-items-heading span {
        display: block;
        margin-bottom: 3px;
        color: #d97706;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .receipt-items-heading h3 {
        margin: 0;
        color: #111827;
        font-size: 17px;
        font-weight: 800;
    }

    .receipt-items-heading > strong {
        color: #6b7280;
        font-size: 11px;
    }

    .receipt-items-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
    }

    .receipt-items-table {
        width: 100%;
        border-collapse: collapse;
        color: #374151;
        font-size: 11px;
    }

    .receipt-items-table th,
    .receipt-items-table td {
        padding: 11px 13px;
        border-bottom: 1px solid #e5e7eb;
    }

    .receipt-items-table thead th {
        color: #4b5563;
        background: #f9fafb;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .receipt-items-table tbody tr:last-child td {
        border-bottom: 1px solid #e5e7eb;
    }

    .receipt-items-table tbody strong {
        color: #1f2937;
    }

    .receipt-items-table tfoot th {
        border-bottom: 0;
        color: #111827;
        background: #fffdf8;
        font-size: 12px;
        font-weight: 850;
    }

    .receipt-items-table tfoot th:first-child {
        text-align: right;
    }

    .number-column {
        text-align: right;
        white-space: nowrap;
    }

    .quantity-column {
        text-align: center;
    }

    .receipt-document-footer {
        display: grid;
        gap: 3px;
        margin: 0 26px 26px;
        padding: 14px 15px;
        border: 1px solid;
        border-radius: 11px;
    }

    .receipt-document-footer.paid {
        border-color: #a7f3d0;
        color: #065f46;
        background: #ecfdf5;
    }

    .receipt-document-footer.pending {
        border-color: #fde68a;
        color: #78350f;
        background: #fffbeb;
    }

    .receipt-document-footer strong {
        font-size: 12px;
    }

    .receipt-document-footer span {
        font-size: 11px;
    }

    @@media (max-width: 680px) {
        .receipt-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .receipt-page-actions {
            width: 100%;
            flex-direction: column;
        }

        .print-receipt-button,
        .back-orders-link {
            width: 100%;
        }

        .receipt-summary-grid {
            grid-template-columns: 1fr;
        }

        .transaction-summary {
            grid-column: auto;
        }
    }

    @@page {
        size: A4 portrait;
        margin: 12mm;
    }

    @@media print {
        html,
        body {
            background: white !important;
            font-size: 10px !important;
        }

        .customer-sidebar,
        .customer-topbar,
        .no-print {
            display: none !important;
        }

        .customer-main {
            width: 100% !important;
            margin-left: 0 !important;
        }

        .customer-page-content {
            padding: 0 !important;
        }

        .receipt-page {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .receipt-document {
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        .receipt-document-header {
            padding: 12px 14px !important;
        }

        .receipt-brand {
            font-size: 20px !important;
        }

        .receipt-document-header p {
            margin-bottom: 7px !important;
        }

        .receipt-document-header h2 {
            margin-bottom: 5px !important;
            font-size: 15px !important;
        }

        .pending-payment-notice {
            margin: 10px 12px 0 !important;
            padding: 8px 10px !important;
        }

        .receipt-summary-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr)) !important;
            gap: 5px !important;
            padding: 10px 12px !important;
        }

        .receipt-summary-item {
            padding: 6px 8px !important;
        }

        .receipt-summary-item span {
            font-size: 7px !important;
        }

        .receipt-summary-item strong {
            font-size: 9px !important;
        }

        .transaction-summary {
            grid-column: 1 / -1 !important;
        }

        .receipt-items-section {
            padding: 0 12px 10px !important;
        }

        .receipt-items-heading {
            margin-bottom: 6px !important;
        }

        .receipt-items-heading h3 {
            font-size: 12px !important;
        }

        .receipt-items-table-wrapper {
            overflow: visible !important;
        }

        .receipt-items-table {
            font-size: 8px !important;
        }

        .receipt-items-table th,
        .receipt-items-table td {
            padding: 5px 7px !important;
        }

        .receipt-document-footer {
            margin: 0 12px 10px !important;
            padding: 7px 9px !important;
        }
    }
</style>