@page "{id:int}"
@using System.Globalization
@model RROMS.Pages.Customer.Orders.ReceiptModel
@{
    ViewData["Title"] = Model.IsPaid
        ? "Payment Receipt"
        : "Payment Summary";
}

<div class="container py-4" style="max-width: 820px;">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <h2 class="mb-0">
            @(Model.IsPaid ? "Payment Receipt" : "Payment Summary")
        </h2>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">
                Print / Save as PDF
            </button>

            <a asp-page="/Customer/Orders/Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm receipt-document">
        <div class="card-body p-4 p-md-5">
            <div class="text-center border-bottom pb-4 mb-4">
                <h1 class="h3 mb-1">
                    Dine<span class="text-warning">flow</span>
                </h1>

                <p class="text-muted mb-3">
                    @(Model.IsPaid
                        ? "Official Payment Receipt"
                        : "Payment Summary")
                </p>

                <h2 class="h4 mb-2">
                    @Model.ReceiptReference
                </h2>

                <span class="badge @RROMS.Pages.Customer.Orders.ReceiptModel.PaymentBadgeClass(Model.PaymentStatus)">
                    @Model.PaymentStatus
                </span>
            </div>

            @if (Model.IsPendingCash)
            {
                <div class="alert alert-warning">
                    <strong>Payment pending.</strong>
                    Cash will be collected at the restaurant.
                    This summary is not proof of payment.
                </div>
            }

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">Customer</p>
                    <p class="fw-semibold mb-0">@Model.CustomerName</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Receipt Reference</p>
                    <p class="fw-semibold mb-0">@Model.ReceiptReference</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Order Reference</p>
                    <p class="fw-semibold mb-0">@Model.OrderReference</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Booking Reference</p>
                    <p class="fw-semibold mb-0">@Model.BookingReference</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Order Date</p>
                    <p class="fw-semibold mb-0">
                        @(Model.OrderDate?.ToString("dd MMM yyyy, HH:mm")
                            ?? "Not recorded")
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        @(Model.IsPaid ? "Payment Date" : "Payment Selection Date")
                    </p>

                    <p class="fw-semibold mb-0">
                        @(Model.PaymentDate?.ToString("dd MMM yyyy, HH:mm")
                            ?? "Not recorded")
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Payment Method</p>
                    <p class="fw-semibold mb-0">@Model.PaymentMethod</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Payment Status</p>
                    <p class="fw-semibold mb-0">@Model.PaymentStatus</p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Reservation</p>
                    <p class="fw-semibold mb-0">
                        @Model.ReservationDate.ToString("dd MMM yyyy")
                        at @Model.ReservationTime.ToString(@"hh\:mm")
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">Table</p>
                    <p class="fw-semibold mb-0">@Model.TableNumber</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.TransactionNo))
                {
                    <div class="col-12">
                        <p class="text-muted small mb-1">
                            Transaction Number
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.TransactionNo
                        </p>
                    </div>
                }
            </div>

            <h3 class="h5 mb-3">Order Items</h3>

            <div class="table-responsive border rounded">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.Name</td>

                                <td class="text-end">
                                    RM @line.UnitPrice.ToString(
                                        "0.00",
                                        CultureInfo.InvariantCulture)
                                </td>

                                <td class="text-center">
                                    @line.Quantity
                                </td>

                                <td class="text-end">
                                    RM @line.Subtotal.ToString(
                                        "0.00",
                                        CultureInfo.InvariantCulture)
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">
                                Total
                            </th>

                            <th class="text-end">
                                RM @Model.PaymentAmount.ToString(
                                    "0.00",
                                    CultureInfo.InvariantCulture)
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="alert alert-light border mt-4 mb-0">
                @if (Model.IsPaid)
                {
                    <span>
                        Payment received. Please keep this receipt for
                        reference.
                    </span>
                }
                else
                {
                    <span>
                        This is a pending payment summary. Cash has not yet
                        been collected.
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<style>
    @@page {
        size: A4 portrait;
        margin: 12mm;
    }

    @@media print {
        html,
        body {
            background: white !important;
            font-size: 11px !important;
        }

        .customer-sidebar,
        .customer-topbar,
        .no-print {
            display: none !important;
        }

        .customer-main {
            margin-left: 0 !important;
            width: 100% !important;
        }

        .customer-page-content {
            padding: 0 !important;
        }

        .container {
            max-width: none !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .receipt-document {
            border: none !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        .receipt-document .card-body {
            padding: 12px !important;
        }

        .receipt-document .row {
            --bs-gutter-y: 0.75rem;
        }

        .receipt-document h1,
        .receipt-document h2,
        .receipt-document h3,
        .receipt-document p {
            margin-top: 0 !important;
        }

        .receipt-document .mb-4 {
            margin-bottom: 0.75rem !important;
        }

        .receipt-document .mt-4 {
            margin-top: 0.75rem !important;
        }

        .receipt-document .pb-4 {
            padding-bottom: 0.75rem !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .table {
            font-size: 10px !important;
        }

        .table th,
        .table td {
            padding: 5px 7px !important;
        }

        .alert {
            padding: 8px 10px !important;
            margin-bottom: 0 !important;
        }
    }
</style>