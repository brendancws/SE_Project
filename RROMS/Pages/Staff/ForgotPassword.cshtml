
@page
@model RROMS.Pages.Staff.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password - Dineflow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

        body {
            margin: 0;
            min-height: 100vh;
            background: #f6f7f9;
            font-family: Arial, Helvetica, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .forgot-container {
            width: 100%;
            max-width: 440px;
        }

        .forgot-logo {
            text-align: center;
            font-size: 34px;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 10px;
        }

        .forgot-logo span {
            color: #f59e0b;
        }

        .forgot-subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 15px;
            margin-bottom: 30px;
        }

        .forgot-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            padding: 35px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            text-align: center;
        }

        .security-icon {
            width: 75px;
            height: 75px;
            border-radius: 50%;
            background: #fef3c7;
            color: #d97706;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 34px;
            font-weight: 700;
        }

        .forgot-card h3 {
            font-weight: 700;
            font-size: 24px;
            color: #1f2937;
            margin-bottom: 12px;
        }

        .description {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .info-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 25px;
            text-align: left;
        }

        .info-box strong {
            color: #92400e;
            display: block;
            margin-bottom: 8px;
        }

        .info-box p {
            color: #78350f;
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }

        .back-btn {
            background: #f59e0b;
            color: #111827;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 700;
            width: 100%;
            display: block;
            text-decoration: none;
        }

        .back-btn:hover {
            background: #d97706;
            color: white;
        }

        .forgot-footer {
            text-align: center;
            margin-top: 25px;
            color: #9ca3af;
            font-size: 13px;
        }

        @@media (max-width: 500px) {

            .forgot-card {
                padding: 25px 20px;
            }

        }

    </style>
</head>

<body>

    <div class="forgot-container">

        <div class="forgot-logo">
            Dine<span>flow</span>
        </div>

        <p class="forgot-subtitle">
            Restaurant Reservation & Order Management System
        </p>

        <div class="forgot-card">

            <div class="security-icon">
                &#128274;
            </div>

            <h3>Forgot Your Password?</h3>

            <p class="description">
                Don't worry! If you have forgotten your
                staff account password, please contact
                your restaurant administrator for assistance.
            </p>

            <div class="info-box">

                <strong>Password Reset Assistance</strong>

                <p>
                    For security reasons, staff password
                    resets are handled by the restaurant
                    administrator.

                    Please contact your administrator
                    to verify your identity and request
                    a password reset.
                </p>

            </div>

            <a asp-page="/Staff/Login"
               class="back-btn">
                Back to Login
            </a>

        </div>

        <div class="forgot-footer">
            © 2026 Dineflow. Staff Access Only.
        </div>

    </div>

</body>
</html>
