@page "{id:int}"
@model RROMS.Pages.Staff.Customers.DetailsModel

@{
    ViewData["Title"] = "Customer Details";
    Layout = "_StaffLayout";

    string ReservationBadge(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" =>
                "staff-badge staff-badge-success",

            "pending" =>
                "staff-badge staff-badge-warning",

            "cancelled" =>
                "staff-badge staff-badge-danger",

            "completed" =>
                "staff-badge staff-badge-completed",

            _ =>
                "staff-badge staff-badge-pending"
        };
    }

    string OrderBadge(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "preparing" =>
                "staff-badge staff-badge-warning",

            "ready to serve" =>
                "staff-badge staff-badge-info",

            "served" =>
                "staff-badge staff-badge-completed",

            "completed" =>
                "staff-badge staff-badge-success",

            "cancelled" =>
                "staff-badge staff-badge-danger",

            _ =>
                "staff-badge staff-badge-pending"
        };
    }
}

@section Styles {
    <style>
        .customer-details {
            width: 100%;
            max-width: 1350px;
            margin: 0 auto;
        }

        .customer-details-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

        .customer-details-header .staff-page-header {
            margin-bottom: 0;
        }

        .customer-information-grid,
        .customer-history-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 18px;
        }

        .customer-details-card {
            min-width: 0;
            margin: 0;
        }

        .customer-card-title {
            margin: 0 0 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--staff-border);
            color: var(--staff-text);
            font-size: 16px;
            font-weight: 850;
        }

        .customer-info-list {
            display: grid;
            gap: 13px;
        }

        .customer-info-row {
            display: grid;
            grid-template-columns: 125px minmax(0, 1fr);
            gap: 14px;
            color: #475569;
            font-size: 13px;
        }

        .customer-info-label {
            color: var(--staff-text);
            font-weight: 800;
        }

        .customer-preference {
            display: inline-flex;
            max-width: 100%;
            padding: 7px 10px;
            border-radius: 8px;
            background: var(--staff-info-soft);
            color: #075985;
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .customer-request {
            background: var(--staff-warning-soft);
            color: #92400e;
        }

        .history-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
        }

        .history-title {
            color: var(--staff-text);
            font-size: 16px;
            font-weight: 850;
        }

        .history-subtitle {
            margin-top: 3px;
            color: var(--staff-text-secondary);
            font-size: 11px;
        }

        .history-count {
            flex-shrink: 0;
            padding: 5px 9px;
            border-radius: 999px;
            background: #f1f5f9;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
        }

        .history-table {
            min-width: 540px;
        }

        .history-footer {
            margin-top: 13px;
            color: var(--staff-text-secondary);
            font-size: 11px;
        }

        @@media (max-width: 1050px) {
            .customer-information-grid,
            .customer-history-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .customer-details-header {
                flex-direction: column;
            }

            .customer-info-row {
                grid-template-columns: 1fr;
                gap: 2px;
            }
        }
    </style>
}

<div class="customer-details">
    <div class="customer-details-header">
        <header class="staff-page-header">
            <h1>Customer Details</h1>

            <p>
                Review customer information, preferences, and recent activity.
            </p>
        </header>

        <a asp-page="./Index"
           class="staff-button staff-button-secondary">
            ← Back to Customers
        </a>
    </div>

    <section class="customer-information-grid">
        <article class="staff-card customer-details-card">
            <h2 class="customer-card-title">
                Contact Information
            </h2>

            <div class="customer-info-list">
                <div class="customer-info-row">
                    <div class="customer-info-label">
                        Name
                    </div>

                    <div>@Model.Customer.Name</div>
                </div>

                <div class="customer-info-row">
                    <div class="customer-info-label">
                        Email
                    </div>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.Customer.Email)
                            ? "Not provided"
                            : Model.Customer.Email)
                    </div>
                </div>

                <div class="customer-info-row">
                    <div class="customer-info-label">
                        Phone
                    </div>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.Customer.Phone)
                            ? "Not provided"
                            : Model.Customer.Phone)
                    </div>
                </div>

                <div class="customer-info-row">
                    <div class="customer-info-label">
                        Account Status
                    </div>

                    <div>
                        @if (string.Equals(
                            Model.Customer.Status,
                            "Active",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="staff-badge staff-badge-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="staff-badge staff-badge-pending">
                                @(Model.Customer.Status ?? "Unknown")
                            </span>
                        }
                    </div>
                </div>
            </div>
        </article>

        <article class="staff-card customer-details-card">
            <h2 class="customer-card-title">
                Dining Preferences &amp; Requests
            </h2>

            <div class="customer-info-list">
                <div>
                    <div class="customer-info-label"
                         style="margin-bottom:7px;">
                        Special Request
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Customer.SpecialRequest))
                    {
                        <span class="customer-preference customer-request">
                            @Model.Customer.SpecialRequest
                        </span>
                    }
                    else
                    {
                        <span style="color:#94a3b8;">
                            None specified
                        </span>
                    }
                </div>

                <div>
                    <div class="customer-info-label"
                         style="margin-bottom:7px;">
                        Dining Preference
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Customer.DiningPreference))
                    {
                        <span class="customer-preference">
                            @Model.Customer.DiningPreference
                        </span>
                    }
                    else
                    {
                        <span style="color:#94a3b8;">
                            None specified
                        </span>
                    }
                </div>
            </div>
        </article>
    </section>

    <section class="customer-history-grid">
        <article class="staff-card customer-details-card">
            <div class="history-heading">
                <div>
                    <div class="history-title">
                        Recent Reservations
                    </div>

                    <div class="history-subtitle">
                        Latest five reservation records
                    </div>
                </div>

                <span class="history-count">
                    @Model.TotalReservationCount total
                </span>
            </div>

            @if (Model.Reservations.Count == 0)
            {
                <div class="staff-empty-state">
                    <div class="staff-empty-title">
                        No reservations found
                    </div>
                </div>
            }
            else
            {
                <div class="staff-table-wrapper">
                    <table class="staff-table history-table">
                        <thead>
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>Table</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var reservation in Model.Reservations)
                            {
                                string status =
                                    reservation.Status ?? "Pending";

                                <tr>
                                    <td>
                                        <strong>
                                            @reservation.Date.ToString(
                                                "dd MMM yyyy")
                                        </strong>

                                        <div style="margin-top:2px;
                                                    color:#64748b;
                                                    font-size:11px;">
                                            @DateTime.Today
                                                .Add(reservation.Time)
                                                .ToString("h:mm tt")
                                        </div>
                                    </td>

                                    <td>
                                        @(reservation.Table == null
                                            ? "Unassigned"
                                            : $"Table {reservation.Table.TableNumber}")
                                    </td>

                                    <td>
                                        <span class="@ReservationBadge(status)">
                                            @status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="history-footer">
                    Showing @Model.Reservations.Count most recent of
                    @Model.TotalReservationCount reservation record(s).
                </div>
            }
        </article>

        <article class="staff-card customer-details-card">
            <div class="history-heading">
                <div>
                    <div class="history-title">
                        Recent Orders
                    </div>

                    <div class="history-subtitle">
                        Latest five order records
                    </div>
                </div>

                <span class="history-count">
                    @Model.TotalOrderCount total
                </span>
            </div>

            @if (Model.Orders.Count == 0)
            {
                <div class="staff-empty-state">
                    <div class="staff-empty-title">
                        No orders found
                    </div>
                </div>
            }
            else
            {
                <div class="staff-table-wrapper">
                    <table class="staff-table history-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                string status =
                                    order.Status ?? "Pending";

                                <tr>
                                    <td>
                                        #@order.OrderID
                                    </td>

                                    <td>
                                        @(order.OrderDate?.ToString(
                                            "dd MMM yyyy")
                                            ?? "Not recorded")
                                    </td>

                                    <td>
                                        <strong>
                                            RM @((order.TotalAmount ?? 0m)
                                                .ToString("F2"))
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="@OrderBadge(status)">
                                            @status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="history-footer">
                    Showing @Model.Orders.Count most recent of
                    @Model.TotalOrderCount order record(s).
                </div>
            }
        </article>
    </section>
</div>