
@page "{id:int}"
@model RROMS.Pages.Staff.Customers.DetailsModel

@{
    ViewData["Title"] = "Customer Details";
    Layout = "_StaffLayout";
}

<div class="customer-details-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2>Customer Details</h2>
            <p>
                View customer information, requests,
                preferences, and reservation history.
            </p>
        </div>

        <a asp-page="/Staff/Customers/Index"
           class="btn btn-outline-secondary">
            ← Back to Customers
        </a>
    </div>

    <!-- CUSTOMER INFORMATION -->
    <div class="details-grid">

        <!-- CONTACT INFORMATION -->
        <div class="details-card">
            <h4>Contact Information</h4>
            <hr class="mb-3 mt-2" />

            <div class="info-list">
                <p>
                    <strong>Name:</strong>
                    @Model.Customer.Name
                </p>

                <p>
                    <strong>Email:</strong>
                    @(Model.Customer.Email ?? "-")
                </p>

                <p>
                    <strong>Phone:</strong>
                    @(string.IsNullOrWhiteSpace(Model.Customer.Phone)
                        ? "N/A" : Model.Customer.Phone)
                </p>

                <p>
                    <strong>Account Status:</strong>

                    @{
                        string customerStatus =
                            Model.Customer.Status ?? "Unknown";

                        string accountClass =
                            customerStatus.Equals(
                                "Active",
                                StringComparison.OrdinalIgnoreCase)
                            ? "bg-success"
                            : "bg-secondary";
                    }

                    <span class="badge @accountClass">
                        @customerStatus
                    </span>
                </p>
            </div>
        </div>

        <!-- DINING PREFERENCES -->
        <div class="details-card">
            <h4>Dining Preferences & Requests</h4>
            <hr class="mb-3 mt-2" />

            <div class="info-list">

                <p>
                    <strong>Special Request:</strong>
                </p>

                @if (!string.IsNullOrWhiteSpace(
                    Model.Customer.SpecialRequest))
                {
                    <span class="badge bg-warning text-dark preference-badge">
                        @Model.Customer.SpecialRequest
                    </span>
                }
                else
                {
                    <p class="text-muted">None specified</p>
                }

                <p class="mt-4">
                    <strong>Dining Preference:</strong>
                </p>

                @if (!string.IsNullOrWhiteSpace(
                    Model.Customer.DiningPreference))
                {
                    <span class="badge bg-info text-dark preference-badge">
                        @Model.Customer.DiningPreference
                    </span>
                }
                else
                {
                    <p class="text-muted">None specified</p>
                }

            </div>
        </div>

    </div>

    <!-- RESERVATION AND ORDER HISTORY -->
    <div class="details-grid">

        <!-- RESERVATION HISTORY -->
        <div class="details-card">

            <div class="section-heading">
                <h4>Reservation History</h4>
                <span class="record-count">
                    @Model.Reservations.Count records
                </span>
            </div>

            <hr class="mb-3 mt-2" />

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Table</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Reservations.Any())
                        {
                            foreach (var res in Model.Reservations)
                            {
                                <tr>

                                    <td>
                                        @res.Date.ToString("dd/MM/yyyy")
                                        <br />
                                        <small class="text-muted">
                                            @res.Time.ToString(@"hh\:mm")
                                        </small>
                                    </td>

                                    <td>
                                        @if (res.Table != null)
                                        {
                                            <span>
                                                Table @res.Table.TableNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unassigned
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @{
                                            string reservationStatus =
                                                res.Status ?? "Pending";

                                            string reservationClass =
                                                reservationStatus.ToLowerInvariant()
                                                switch
                                                {
                                                    "confirmed" => "bg-success",
                                                    "pending" => "bg-warning text-dark",
                                                    "cancelled" => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                        }

                                        <span class="badge @reservationClass">
                                            @reservationStatus
                                        </span>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-4">
                                    No reservations found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

        <!-- ORDER HISTORY -->
        <div class="details-card">

            <div class="section-heading">
                <h4>Order History</h4>
                <span class="record-count">
                    @Model.Orders.Count records
                </span>
            </div>

            <hr class="mb-3 mt-2" />

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Orders.Any())
                        {
                            foreach (var order in Model.Orders)
                            {
                                <tr>

                                    <td>
                                        #@order.OrderID
                                    </td>

                                    <td>
                                        @(order.OrderDate?.ToString(
                                            "dd/MM/yyyy") ?? "-")
                                    </td>

                                    <td>
                                        RM @(order.TotalAmount?.ToString(
                                            "0.00") ?? "0.00")
                                    </td>

                                    <td>
                                        @{
                                            string orderStatus =
                                                order.Status ?? "Pending";

                                            string orderClass =
                                                orderStatus.ToLowerInvariant()
                                                switch
                                                {
                                                    "completed" => "bg-success",
                                                    "cancelled" => "bg-danger",
                                                    "preparing" => "bg-warning text-dark",
                                                    "ready to serve" => "bg-info text-dark",
                                                    "served" => "bg-primary",
                                                    _ => "bg-secondary"
                                                };
                                        }

                                        <span class="badge @orderClass">
                                            @orderStatus
                                        </span>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No orders found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>

</div>

<style>

    .customer-details-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* PAGE HEADER */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    /* CARDS */
    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .details-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
        min-width: 0;
    }

    .details-card h4 {
        font-size: 20px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 5px;
    }

    /* CUSTOMER INFORMATION */
    .info-list p {
        margin-bottom: 12px;
        color: #4b5563;
        overflow-wrap: anywhere;
    }

    .preference-badge {
        display: inline-block;
        white-space: normal;
        overflow-wrap: anywhere;
        text-align: left;
        line-height: 1.5;
        padding: 8px 12px;
        max-width: 100%;
    }

    /* HISTORY */
    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .record-count {
        font-size: 12px;
        color: #6b7280;
        background: #f3f4f6;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .table thead th {
        white-space: nowrap;
        font-size: 13px;
        color: #4b5563;
    }

    .table td {
        font-size: 14px;
        vertical-align: middle;
    }

    .table .badge {
        white-space: nowrap;
        font-size: 12px;
        padding: 6px 10px;
        border-radius: 20px;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 900px) {

        .details-grid {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

    }

    @@media (max-width: 600px) {

        .details-card {
            padding: 18px;
        }

    }

</style>
