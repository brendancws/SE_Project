@page
@model RROMS.Pages.Staff.Customers.DetailsModel

@{
    ViewData["Title"] = "Customer Details";
    Layout = "_StaffLayout";
}

<div class="customer-details-page">

    <div class="page-header">
        <div>
            <h2>Customer Details</h2>
            <p>View customer information, requests, preferences, and reservation history.</p>
        </div>

        <a asp-page="/Staff/Customers/Index"
           class="btn btn-outline-secondary">
            ← Back to Customers
        </a>
    </div>

    <div class="details-card">

        <div class="empty-state">

            <div class="empty-icon">
                👤
            </div>

            <h4>No Customer Selected</h4>

            <p>
                Select a customer from the Customers page to view their
                details, dining preferences, special requests, and reservation history.
            </p>

            <a asp-page="/Staff/Customers/Index"
               class="btn action-btn">
                View Customers
            </a>

        </div>

    </div>

</div>

<style>

    .customer-details-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .details-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 60px 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .empty-state {
        text-align: center;
        max-width: 560px;
        margin: 0 auto;
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;

        border-radius: 50%;
        background: #f3f4f6;

        display: flex;
        justify-content: center;
        align-items: center;

        font-size: 30px;
    }

    .empty-state h4 {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #1f2937;
    }

    .empty-state p {
        color: #6b7280;
        margin-bottom: 25px;
    }

    .action-btn {
        background: #f59e0b;
        color: #111827;
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
    }

    .action-btn:hover {
        background: #d97706;
        color: white;
    }

    @@media(max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

    }

</style>