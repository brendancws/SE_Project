
@page
@model RROMS.Pages.Staff.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
    Layout = "_StaffLayout";
}

<div class="customers-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2>Customers</h2>
            <p>View customer requests, preferences, and reservation history.</p>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="summary-row">

        <!-- TOTAL CUSTOMERS -->
        <div class="summary-card">
            <div class="summary-icon">👥</div>
            <div>
                <span>Total Customers</span>
                <h3>@Model.TotalCustomers</h3>
            </div>
        </div>

        <!-- SPECIAL REQUESTS -->
        <div class="summary-card">
            <div class="summary-icon">📝</div>
            <div>
                <span>Special Requests</span>
                <h3>@Model.SpecialRequestsCount</h3>
            </div>
        </div>

        <!-- DINING PREFERENCES -->
        <div class="summary-card">
            <div class="summary-icon">🍽️</div>
            <div>
                <span>Dining Preferences</span>
                <h3>@Model.DiningPreferencesCount</h3>
            </div>
        </div>

        <!-- TOTAL RESERVATIONS -->
        <div class="summary-card">
            <div class="summary-icon">📅</div>
            <div>
                <span>Reservation Records</span>
                <h3>@Model.TotalReservationsCount</h3>
            </div>
        </div>

    </div>

    <!-- CUSTOMER INFORMATION -->
    <div class="customers-card">

        <div class="table-toolbar">

            <div>
                <h4>Customer Information</h4>
                <p>Review customer details and dining information.</p>
            </div>

            <!-- CUSTOMER SEARCH -->
            <form method="get" class="search-box">

                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search name or phone..." />

                <button type="submit" class="btn btn-dark">
                    Search
                </button>

                <a asp-page="/Staff/Customers/Index"
                   class="btn btn-outline-secondary">
                    Reset
                </a>

            </form>

        </div>

        <!-- CUSTOMER TABLE -->
        <div class="table-responsive">

            <table class="table customers-table align-middle">

                <thead>
                    <tr>
                        <th>Customer ID</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Special Request</th>
                        <th>Preference</th>
                        <th>Reservations</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Customers.Any())
                    {
                        foreach (var item in Model.Customers)
                        {
                            <tr>

                                <!-- CUSTOMER ID -->
                                <td>
                                    @item.CustomerID
                                </td>

                                <!-- CUSTOMER NAME AND EMAIL -->
                                <td>
                                    <strong>@item.Name</strong>

                                    <br />

                                    <small class="text-muted">
                                        @(item.Email ?? "-")
                                    </small>
                                </td>

                                <!-- PHONE NUMBER -->
                                <td>
                                    @(item.Phone ?? "-")
                                </td>

                                <!-- SPECIAL REQUEST -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        item.SpecialRequest))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @item.SpecialRequest
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            None
                                        </span>
                                    }
                                </td>

                                <!-- DINING PREFERENCE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        item.DiningPreference))
                                    {
                                        <span class="badge bg-info text-dark">
                                            @item.DiningPreference
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            None
                                        </span>
                                    }
                                </td>

                                <!-- RESERVATION DETAILS -->
                                <td>
                                    <span class="text-muted">
                                        View history →
                                    </span>
                                </td>

                                <!-- VIEW CUSTOMER HISTORY -->
                                <td>
                                    <a asp-page="./Details"
                                       asp-route-id="@item.CustomerID"
                                       class="btn btn-sm btn-outline-primary">
                                        View History
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">

                                @if (!string.IsNullOrWhiteSpace(Model.Search))
                                {
                                    <span>
                                        No customers match your search.
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        No customer records found.
                                    </span>
                                }

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .customers-page {
        width: 100%;
    }

    /* PAGE HEADER */
    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    /* SUMMARY CARDS */
    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    /* CUSTOMER TABLE CARD */
    .customers-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    /* TABLE TOOLBAR */
    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    /* SEARCH BOX */
    .search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-box .form-control {
        width: 230px;
        min-height: 40px;
        border-radius: 10px;
    }

    .search-box .btn {
        border-radius: 10px;
        white-space: nowrap;
    }

    /* CUSTOMER TABLE */
    .customers-table {
        width: 100%;
    }

    .customers-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .customers-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    .customers-table tbody tr:hover {
        background: #fffaf0;
    }

    .customers-table .badge {
        display: inline-block;
        max-width: 220px;
        white-space: normal;
        overflow-wrap: anywhere;
        text-align: left;
        padding: 7px 10px;
        font-size: 12px;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

    }

    @@media (max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

        .search-box {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

        .search-box .form-control,
        .search-box .btn {
            width: 100%;
        }

        .customers-card {
            padding: 15px;
        }

    }

</style>
