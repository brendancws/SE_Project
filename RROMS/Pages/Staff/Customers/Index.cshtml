@page
@model RROMS.Pages.Staff.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
    Layout = "_StaffLayout";
}

@section Styles {
    <style>
        .customer-table {
            min-width: 950px;
        }

        .customer-preference {
            display: inline-flex;
            max-width: 220px;
            padding: 6px 9px;
            border-radius: 7px;
            background: var(--staff-info-soft);
            color: #075985;
            font-size: 11px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .customer-request {
            background: var(--staff-warning-soft);
            color: #92400e;
        }
    </style>
}

<header class="staff-page-header">
    <h1>Customers</h1>

    <p>
        View customer requests, preferences, and recent activity.
    </p>
</header>

<section class="staff-summary-grid"
         aria-label="Customer summary">

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3" />
                <path d="M3 20v-2a6 6 0 0 1 12 0v2" />
                <circle cx="17" cy="9" r="2" />
                <path d="M16 15a5 5 0 0 1 5 5" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Total Customers
            </div>

            <div class="staff-summary-value">
                @Model.TotalCustomers
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M5 3h14v18H5z" />
                <path d="M8 7h8M8 11h8M8 15h5" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Special Requests
            </div>

            <div class="staff-summary-value">
                @Model.SpecialRequestsCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10" />
                <path d="M16 3v18M16 3c3 2 4 5 4 8h-4" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Dining Preferences
            </div>

            <div class="staff-summary-value">
                @Model.DiningPreferencesCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="16" rx="2" />
                <path d="M16 3v4M8 3v4M3 10h18" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Reservation Records
            </div>

            <div class="staff-summary-value">
                @Model.TotalReservationsCount
            </div>
        </div>
    </div>
</section>

<section class="staff-card">
    <div class="staff-toolbar">
        <div>
            <h2 class="staff-toolbar-title">
                Customer Information
            </h2>

            <p class="staff-toolbar-copy">
                Review contact details and dining information.
            </p>
        </div>

        <form method="get"
              class="staff-filter-form">

            <input type="search"
                   name="Search"
                   value="@Model.Search"
                   class="staff-input staff-search-input"
                   placeholder="Search name, email, or phone"
                   autocomplete="off" />

            <button type="submit"
                    class="staff-button staff-button-dark">
                Search
            </button>

            <a asp-page="./Index"
               class="staff-button staff-button-secondary">
                Reset
            </a>
        </form>
    </div>

    @if (Model.Customers.Count == 0)
    {
        <div class="staff-empty-state">
            <div class="staff-empty-title">
                No customers found
            </div>

            <div>
                Try changing the name, email, or phone search.
            </div>
        </div>
    }
    else
    {
        <div class="staff-table-wrapper">
            <table class="staff-table customer-table">
                <thead>
                    <tr>
                        <th>Customer ID</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Special Request</th>
                        <th>Preference</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>
                                #@customer.CustomerID
                            </td>

                            <td>
                                <strong>@customer.Name</strong>

                                <div style="margin-top:2px;
                                            color:#64748b;
                                            font-size:11px;">
                                    @customer.Email
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(customer.Phone)
                                    ? "Not provided"
                                    : customer.Phone)
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    customer.SpecialRequest))
                                {
                                    <span class="customer-preference customer-request">
                                        @customer.SpecialRequest
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;">
                                        None
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    customer.DiningPreference))
                                {
                                    <span class="customer-preference">
                                        @customer.DiningPreference
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;">
                                        None
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-page="./Details"
                                   asp-route-id="@customer.CustomerID"
                                   class="staff-button staff-button-secondary">
                                    View History
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="staff-result-count">
            @Model.Customers.Count customer record(s) shown
        </div>
    }
</section>