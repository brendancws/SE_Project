@page
@model RROMS.Pages.Staff.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
    Layout = "_StaffLayout";
}

<div class="customers-page">

    <div class="page-header">
        <div>
            <h2>Customers</h2>
            <p>View customer requests, preferences, and reservation history.</p>
        </div>
    </div>

    <div class="summary-row">

        <div class="summary-card">
            <div class="summary-icon">👥</div>
            <div>
                <span>Total Customers</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">📝</div>
            <div>
                <span>Special Requests</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">🍽️</div>
            <div>
                <span>Dining Preferences</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">📅</div>
            <div>
                <span>Reservation Records</span>
                <h3>0</h3>
            </div>
        </div>

    </div>

    <div class="customers-card">

        <div class="table-toolbar">

            <div>
                <h4>Customer Information</h4>
                <p>Review customer details and dining information.</p>
            </div>

            <div class="search-box">
                <input type="text"
                       class="form-control"
                       placeholder="Search customer..." />
            </div>

        </div>

        <div class="table-responsive">

            <table class="table customers-table align-middle">

                <thead>
                    <tr>
                        <th>Customer ID</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Special Request</th>
                        <th>Preference</th>
                        <th>Reservations</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-5">
                            No customer records found.
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .customers-page {
        width: 100%;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .customers-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    .search-box {
        width: 280px;
    }

    .search-box input {
        border-radius: 10px;
    }

    .customers-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .customers-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    @@media(max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-box {
            width: 100%;
        }

    }

    @@media(max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

    }

</style>