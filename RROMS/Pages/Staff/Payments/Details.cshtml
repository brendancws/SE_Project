
@page "{id:int}"
@model RROMS.Pages.Staff.Payments.DetailsModel

@{
    ViewData["Title"] = "Payment Details";
    Layout = "_StaffLayout";

    string currentStatus = Model.Payment.Status ?? "Pending";

    string statusClass = currentStatus.ToLowerInvariant() switch
    {
        "paid" => "paid",
        "pending" => "pending",
        "failed" => "failed",
        "cancelled" => "cancelled",
        _ => "default-status"
    };
}

<div class="payment-details-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h2>Payment Details</h2>
            <p>View billing information and update payment status.</p>
        </div>

        <a asp-page="/Staff/Payments/Index"
           class="btn btn-outline-secondary">
            ← Back to Payments
        </a>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            ✅ @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- PAYMENT DETAILS CARD -->
    <div class="details-card">

        <div class="payment-header">

            <div>
                <span class="small-label">Payment ID</span>
                <h4>#@Model.Payment.PaymentID</h4>
            </div>

            <span class="status-badge @statusClass">
                @currentStatus
            </span>

        </div>

        <hr />

        <!-- BILLING INFORMATION -->
        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <span>Order ID</span>
                    <strong>@Model.Payment.OrderID</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Customer</span>
                    <strong>
                        @(Model.Payment.Order?.Customer?.Name ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Payment Date</span>
                    <strong>
                        @(Model.Payment.PaymentDate?.ToString(
                            "dd/MM/yyyy hh:mm tt") ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Amount</span>
                    <strong>
                        RM @Model.Payment.Amount.ToString("0.00")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Payment Method</span>
                    <strong>
                        @(Model.Payment.Method ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Transaction Number</span>
                    <strong>
                        @(Model.Payment.TransactionNo ?? "-")
                    </strong>
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <!-- PAYMENT STATUS UPDATE -->
        <form method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="status-section">

                <div>
                    <h5>Update Payment Status</h5>
                    <p>Select the current status for this payment.</p>
                </div>

                <div class="status-controls">

                    <select asp-for="NewStatus"
                            class="form-select"
                            aria-label="Payment status">

                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                        <option value="Failed">Failed</option>
                        <option value="Cancelled">Cancelled</option>

                    </select>

                    <button type="submit"
                            class="btn update-btn">
                        Update Status
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<style>

    .payment-details-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* HEADER */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    /* MAIN CARD */
    .details-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .payment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .small-label {
        color: #6b7280;
        font-size: 13px;
    }

    .payment-header h4 {
        margin-top: 4px;
        font-weight: 700;
        color: #1f2937;
    }

    /* STATUS BADGES */
    .status-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .paid {
        background: #dcfce7;
        color: #166534;
    }

    .pending {
        background: #fef3c7;
        color: #92400e;
    }

    .failed,
    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .default-status {
        background: #e5e7eb;
        color: #374151;
    }

    /* BILLING INFORMATION */
    .info-box {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
        height: 100%;
    }

    .info-box span {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .info-box strong {
        color: #1f2937;
        overflow-wrap: anywhere;
    }

    /* STATUS UPDATE SECTION */
    .status-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
    }

    .status-section h5 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .status-section p {
        margin: 0;
        color: #6b7280;
    }

    .status-controls {
        display: flex;
        gap: 10px;
        min-width: 420px;
    }

    .status-controls .form-select {
        border-radius: 10px;
        min-height: 45px;
    }

    /* UPDATE BUTTON */
    .update-btn {
        background: #f59e0b;
        color: #111827;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .update-btn:hover {
        background: #d97706;
        color: white;
    }

    /* MOBILE RESPONSIVENESS */
    @@media (max-width: 750px) {

        .page-header,
        .status-section {
            flex-direction: column;
            align-items: flex-start;
        }

        .status-controls {
            width: 100%;
            min-width: 0;
            flex-direction: column;
        }

        .details-card {
            padding: 20px;
        }

    }

</style>
