@page
@model RROMS.Pages.Staff.Payments.IndexModel

@{
    ViewData["Title"] = "Payments";
    Layout = "_StaffLayout";

    string StatusBadge(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "paid" =>
                "staff-badge staff-badge-success",

            "pending" =>
                "staff-badge staff-badge-warning",

            "failed" =>
                "staff-badge staff-badge-danger",

            "cancelled" =>
                "staff-badge staff-badge-danger",

            _ =>
                "staff-badge staff-badge-pending"
        };
    }
}

<header class="staff-page-header">
    <h1>Payments</h1>

    <p>
        Record payment status and manage billing information.
    </p>
</header>

<section class="staff-summary-grid"
         aria-label="Payment summary">

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="2.5" y="5"
                      width="19"
                      height="14"
                      rx="2" />

                <path d="M2.5 9h19M6 15h4" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Total Payments
            </div>

            <div class="staff-summary-value">
                @Model.TotalPayments
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M7 3h10M7 21h10" />
                <path d="M8 3c0 4 1 6 4 9-3 3-4 5-4 9" />
                <path d="M16 3c0 4-1 6-4 9 3 3 4 5 4 9" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Pending
            </div>

            <div class="staff-summary-value">
                @Model.PendingCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 3 3 5-6" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Paid
            </div>

            <div class="staff-summary-value">
                @Model.PaidCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="m9 9 6 6M15 9l-6 6" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Failed / Cancelled
            </div>

            <div class="staff-summary-value">
                @Model.FailedOrCancelledCount
            </div>
        </div>
    </div>
</section>

<section class="staff-card">
    <div class="staff-toolbar">
        <div>
            <h2 class="staff-toolbar-title">
                Payment Records
            </h2>

            <p class="staff-toolbar-copy">
                View transaction and billing status.
            </p>
        </div>

        <form method="get"
              class="staff-filter-form">

            <input type="search"
                   name="Search"
                   value="@Model.Search"
                   class="staff-input staff-search-input"
                   placeholder="Search name or phone"
                   autocomplete="off" />

            <select name="StatusFilter"
                    class="staff-select staff-status-select">

                <option value="All"
                        selected="@(Model.StatusFilter == "All")">
                    All statuses
                </option>

                <option value="Pending"
                        selected="@(Model.StatusFilter == "Pending")">
                    Pending
                </option>

                <option value="Paid"
                        selected="@(Model.StatusFilter == "Paid")">
                    Paid
                </option>

                <option value="Failed"
                        selected="@(Model.StatusFilter == "Failed")">
                    Failed
                </option>

                <option value="Cancelled"
                        selected="@(Model.StatusFilter == "Cancelled")">
                    Cancelled
                </option>
            </select>

            <button type="submit"
                    class="staff-button staff-button-dark">
                Search
            </button>

            <a asp-page="./Index"
               class="staff-button staff-button-secondary">
                Reset
            </a>
        </form>
    </div>

    @if (Model.Payments.Count == 0)
    {
        <div class="staff-empty-state">
            <div class="staff-empty-title">
                No payment records found
            </div>

            <div>
                Try changing the customer search or status filter.
            </div>
        </div>
    }
    else
    {
        <div class="staff-table-wrapper">
            <table class="staff-table"
                   style="min-width:1050px;">
                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Transaction No.</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        string status =
                            payment.Status ?? "Unknown";

                        <tr>
                            <td>
                                #@payment.PaymentID
                            </td>

                            <td>
                                #@payment.OrderID
                            </td>

                            <td>
                                @if (payment.Order?.Customer != null)
                                {
                                    <strong>
                                        @payment.Order.Customer.Name
                                    </strong>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;">
                                        Unknown customer
                                    </span>
                                }
                            </td>

                            <td>
                                @(payment.PaymentDate?.ToString(
                                    "dd MMM yyyy, h:mm tt")
                                    ?? "Not recorded")
                            </td>

                            <td>
                                <strong>
                                    RM @payment.Amount.ToString("F2")
                                </strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(payment.Method)
                                    ? "—"
                                    : payment.Method)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    payment.TransactionNo)
                                    ? "—"
                                    : payment.TransactionNo)
                            </td>

                            <td>
                                <span class="@StatusBadge(status)">
                                    @status
                                </span>
                            </td>

                            <td>
                                <a asp-page="./Details"
                                   asp-route-id="@payment.PaymentID"
                                   class="staff-button staff-button-secondary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="staff-result-count">
        @if (Model.TotalResults == 0)
        {
            <span>No matching payment records</span>
        }
        else
        {
            <span>
                Showing @Model.FirstResultNumber–@Model.LastResultNumber
                of @Model.TotalResults payments
            </span>
        }
    </div>

    @if (Model.TotalResults > 0)
    {
        <nav class="staff-pagination"
             aria-label="Payment result pages">

            <div class="staff-page-status">
                Page @Model.PageNumber of @Model.TotalPages
            </div>

            <div class="staff-page-links">
                @if (Model.HasPreviousPage)
                {
                    <a asp-page="./Index"
                       asp-route-Search="@Model.Search"
                       asp-route-StatusFilter="@Model.StatusFilter"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       class="staff-button staff-button-secondary">
                        ← Previous
                    </a>
                }
                else
                {
                    <span class="staff-button staff-button-secondary"
                          style="opacity:0.5;
                                 cursor:not-allowed;"
                          aria-disabled="true">
                        ← Previous
                    </span>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-page="./Index"
                       asp-route-Search="@Model.Search"
                       asp-route-StatusFilter="@Model.StatusFilter"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       class="staff-button staff-button-secondary">
                        Next →
                    </a>
                }
                else
                {
                    <span class="staff-button staff-button-secondary"
                          style="opacity:0.5;
                                 cursor:not-allowed;"
                          aria-disabled="true">
                        Next →
                    </span>
                }
            </div>
        </nav>
    }
</section>