@page
@model RROMS.Pages.Staff.Payments.IndexModel

@{
    ViewData["Title"] = "Payments";
    Layout = "_StaffLayout";
}

<div class="payments-page">

    <div class="page-header">
        <div>
            <h2>Payments</h2>
            <p>Record payment status and manage billing information.</p>
        </div>
    </div>

    <div class="summary-row">

        <div class="summary-card">
            <div class="summary-icon">💳</div>
            <div>
                <span>Total Payments</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">⏳</div>
            <div>
                <span>Pending</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">✅</div>
            <div>
                <span>Paid</span>
                <h3>0</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">❌</div>
            <div>
                <span>Failed / Cancelled</span>
                <h3>0</h3>
            </div>
        </div>

    </div>

    <div class="payments-card">

        <div class="table-toolbar">

            <div>
                <h4>Payment Records</h4>
                <p>View transaction and billing status.</p>
            </div>

            <div class="filters">

                <input type="text"
                       class="form-control"
                       placeholder="Search payment..." />

                <select class="form-select">
                    <option selected>All Status</option>
                    <option>Pending</option>
                    <option>Paid</option>
                    <option>Failed</option>
                    <option>Cancelled</option>
                </select>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table payments-table align-middle">

                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Transaction No.</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-5">

                            No payment records found.

                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .payments-page {
        width: 100%;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .payments-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    .filters {
        display: flex;
        gap: 10px;
        width: 420px;
    }

    .filters .form-control,
    .filters .form-select {
        border-radius: 10px;
    }

    .payments-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .payments-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    @@media(max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .filters {
            width: 100%;
        }

    }

    @@media(max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

        .filters {
            flex-direction: column;
        }

    }

</style>