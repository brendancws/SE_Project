
@page
@model RROMS.Pages.Staff.Payments.IndexModel

@{
    ViewData["Title"] = "Payments";
    Layout = "_StaffLayout";
}

<div class="payments-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2>Payments</h2>
            <p>Record payment status and manage billing information.</p>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="summary-row">

        <!-- TOTAL PAYMENTS -->
        <div class="summary-card">
            <div class="summary-icon">💳</div>
            <div>
                <span>Total Payments</span>
                <h3>@Model.Payments.Count</h3>
            </div>
        </div>

        <!-- PENDING PAYMENTS -->
        <div class="summary-card">
            <div class="summary-icon">⏳</div>
            <div>
                <span>Pending</span>
                <h3>
                    @Model.Payments.Count(p =>
                        string.Equals(
                            p.Status,
                            "Pending",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <!-- PAID PAYMENTS -->
        <div class="summary-card">
            <div class="summary-icon">✅</div>
            <div>
                <span>Paid</span>
                <h3>
                    @Model.Payments.Count(p =>
                        string.Equals(
                            p.Status,
                            "Paid",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <!-- FAILED / CANCELLED -->
        <div class="summary-card">
            <div class="summary-icon">❌</div>
            <div>
                <span>Failed / Cancelled</span>
                <h3>
                    @Model.Payments.Count(p =>
                        string.Equals(
                            p.Status,
                            "Failed",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        string.Equals(
                            p.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

    </div>

    <!-- PAYMENT RECORDS -->
    <div class="payments-card">

        <div class="table-toolbar">

            <div>
                <h4>Payment Records</h4>
                <p>View transaction and billing status.</p>
            </div>

            <!-- SEARCH AND FILTER -->
            <form method="get" class="filters">

                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search customer..." />

                <select name="StatusFilter"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All"
                            selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">
                        All Status
                    </option>

                    <option value="Pending"
                            selected="@(Model.StatusFilter == "Pending")">
                        Pending
                    </option>

                    <option value="Paid"
                            selected="@(Model.StatusFilter == "Paid")">
                        Paid
                    </option>

                    <option value="Failed"
                            selected="@(Model.StatusFilter == "Failed")">
                        Failed
                    </option>

                    <option value="Cancelled"
                            selected="@(Model.StatusFilter == "Cancelled")">
                        Cancelled
                    </option>

                </select>

                <button type="submit" class="btn btn-dark">
                    Search
                </button>

                <a asp-page="/Staff/Payments/Index"
                   class="btn btn-outline-secondary">
                    Reset
                </a>

            </form>

        </div>

        <!-- PAYMENT TABLE -->
        <div class="table-responsive">

            <table class="table payments-table align-middle">

                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Transaction No.</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Payments.Any())
                    {
                        foreach (var payment in Model.Payments)
                        {
                            <tr>

                                <!-- PAYMENT ID -->
                                <td>
                                    @payment.PaymentID
                                </td>

                                <!-- ORDER ID -->
                                <td>
                                    @payment.OrderID
                                </td>

                                <!-- CUSTOMER -->
                                <td>
                                    @if (payment.Order?.Customer != null)
                                    {
                                        <strong>
                                            @payment.Order.Customer.Name
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- PAYMENT DATE -->
                                <td>
                                    @(payment.PaymentDate?.ToString(
                                        "dd/MM/yyyy hh:mm tt") ?? "-")
                                </td>

                                <!-- PAYMENT AMOUNT -->
                                <td>
                                    RM @payment.Amount.ToString("0.00")
                                </td>

                                <!-- PAYMENT METHOD -->
                                <td>
                                    @(payment.Method ?? "-")
                                </td>

                                <!-- TRANSACTION NUMBER -->
                                <td>
                                    @(payment.TransactionNo ?? "-")
                                </td>

                                <!-- PAYMENT STATUS -->
                                <td>
                                    @{
                                        string status =
                                            payment.Status ?? "Unknown";

                                        string statusClass =
                                            status.ToLowerInvariant() switch
                                            {
                                                "paid" => "paid",
                                                "pending" => "pending",
                                                "failed" => "failed",
                                                "cancelled" => "cancelled",
                                                _ => "default-status"
                                            };
                                    }

                                    <span class="status-badge @statusClass">
                                        @status
                                    </span>
                                </td>

                                <!-- ACTION -->
                                <td>
                                    <a asp-page="/Staff/Payments/Details"
                                       asp-route-id="@payment.PaymentID"
                                       class="btn btn-sm btn-outline-dark">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-5">
                                No payment records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .payments-page {
        width: 100%;
    }

    /* PAGE HEADER */
    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    /* SUMMARY CARDS */
    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
        color: #111827;
    }

    /* PAYMENT RECORD CARD */
    .payments-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    /* TABLE TOOLBAR */
    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
        color: #111827;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    /* SEARCH AND FILTER */
    .filters {
        display: flex;
        align-items: center;
        gap: 10px;
        width: auto;
        flex-wrap: wrap;
    }

    .filters .form-control {
        width: 210px;
    }

    .filters .form-select {
        width: 150px;
    }

    .filters .form-control,
    .filters .form-select {
        border-radius: 10px;
        min-height: 40px;
    }

    .filters .btn {
        border-radius: 10px;
        white-space: nowrap;
    }

    /* PAYMENT TABLE */
    .payments-table {
        width: 100%;
    }

    .payments-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .payments-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    .payments-table tbody tr:hover {
        background: #fffaf0;
    }

    /* STATUS BADGES */
    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .paid {
        background: #dcfce7;
        color: #166534;
    }

    .pending {
        background: #fef3c7;
        color: #92400e;
    }

    .failed,
    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .default-status {
        background: #e5e7eb;
        color: #374151;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

    }

    @@media (max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

        .filters {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

        .filters .form-control,
        .filters .form-select,
        .filters .btn {
            width: 100%;
        }

        .payments-card {
            padding: 15px;
        }

    }

</style>
