@page
@model RROMS.Pages.Staff.LoginModel

@{
    ViewData["Title"] = "Staff Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Staff Login - Dineflow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                background: #f6f7f9;
                font-family: Arial, Helvetica, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .login-container {
                width: 100%;
                max-width: 440px;
            }

            .login-logo {
                text-align: center;
                font-size: 34px;
                font-weight: 800;
                color: #1f2937;
                margin-bottom: 10px;
            }

                .login-logo span {
                    color: #f59e0b;
                }

            .login-subtitle {
                text-align: center;
                color: #6b7280;
                font-size: 15px;
                margin-bottom: 30px;
            }

            .login-card {
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 18px;
                padding: 35px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            }

                .login-card h3 {
                    font-weight: 700;
                    font-size: 24px;
                    color: #1f2937;
                    margin-bottom: 6px;
                }

                .login-card .description {
                    color: #6b7280;
                    margin-bottom: 25px;
                    font-size: 14px;
                }

            .form-label {
                font-weight: 600;
                color: #374151;
                margin-bottom: 8px;
            }

            .form-control {
                min-height: 48px;
                border-radius: 10px;
                border: 1px solid #d1d5db;
                padding: 10px 14px;
            }

                .form-control:focus {
                    border-color: #f59e0b;
                    box-shadow: 0 0 0 0.2rem rgba(245,158,11,0.15);
                }

            /* FORGOT PASSWORD */
            .forgot-password-link {
                color: #f59e0b;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
            }

                .forgot-password-link:hover {
                    color: #d97706;
                    text-decoration: underline;
                }

                .forgot-password-link:focus-visible {
                    outline: 2px solid #f59e0b;
                    outline-offset: 3px;
                    border-radius: 3px;
                }

            .login-btn {
                background: #f59e0b;
                color: #111827;
                border: none;
                border-radius: 10px;
                padding: 12px;
                font-weight: 700;
                width: 100%;
                margin-top: 15px;
            }

                .login-btn:hover {
                    background: #d97706;
                    color: white;
                }

            .login-footer {
                text-align: center;
                margin-top: 25px;
                color: #9ca3af;
                font-size: 13px;
            }

            @@media (max-width: 500px) {

                .login-card {
                    padding: 25px 20px;
                }
            }

    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-logo">
            Dine<span>flow</span>
        </div>

        <p class="login-subtitle">
            Restaurant Reservation & Order Management System
        </p>

        <div class="login-card">

            <h3>Staff Login</h3>

            <p class="description">
                Sign in to access the restaurant staff panel.
            </p>

            <form method="post"
                  asp-route-returnUrl="@Model.ReturnUrl">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- EMAIL -->
                <div class="mb-3">

                    <label asp-for="Input.Email"
                           class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Input.Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="username" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger small">
                    </span>

                </div>

                <!-- PASSWORD -->
                <div class="mb-2">

                    <label asp-for="Input.Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger small">
                    </span>

                </div>

                <!-- FORGOT PASSWORD -->
                <div class="text-end mb-3">

                    <a asp-page="/Staff/ForgotPassword"
                       class="forgot-password-link">
                        Forgot Password?
                    </a>

                </div>

                <!-- REMEMBER ME -->
                <div class="form-check mb-3">

                    <input asp-for="Input.RememberMe"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMe"
                           class="form-check-label">
                        Keep me signed in
                    </label>

                </div>

                <!-- LOGIN BUTTON -->
                <button type="submit"
                        class="btn login-btn">
                    Sign In
                </button>

            </form>

        </div>

        <div class="login-footer">
            © 2026 Dineflow. Staff Access Only.
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
