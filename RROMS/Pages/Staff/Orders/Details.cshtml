
@page "{id:int}"
@model RROMS.Pages.Staff.Orders.DetailsModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "_StaffLayout";

    string currentStatus = Model.Order.Status ?? "Pending";

    string statusClass = currentStatus.ToLowerInvariant() switch
    {
        "pending" => "pending",
        "preparing" => "preparing",
        "ready to serve" => "ready",
        "served" => "served",
        "completed" => "completed",
        "cancelled" => "cancelled",
        _ => "default-status"
    };

    // Must match the workflow in Details.cshtml.cs
    var allowedNextStatuses = currentStatus switch
    {
        "Pending" => new[] { "Preparing", "Cancelled" },
        "Preparing" => new[] { "Ready to Serve", "Cancelled" },
        "Ready to Serve" => new[] { "Served", "Cancelled" },
        "Served" => new[] { "Completed" },
        _ => Array.Empty<string>()
    };

    bool canUpdate = allowedNextStatuses.Length > 0;
}

<div class="order-details-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h2>Order Details</h2>
            <p>View order information and update its status.</p>
        </div>

        <a asp-page="/Staff/Orders/Index"
           class="btn btn-outline-secondary">
            ← Back to Orders
        </a>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            ✅ @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- ORDER DETAILS -->
    <div class="details-card">

        <div class="order-header">

            <div>
                <span class="small-label">Order ID</span>
                <h4>#@Model.Order.OrderID</h4>
            </div>

            <span class="status-badge @statusClass">
                @currentStatus
            </span>

        </div>

        <hr />

        <!-- ORDER INFORMATION -->
        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <span>Customer</span>
                    <strong>
                        @(Model.Order.Customer?.Name ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Phone Number</span>
                    <strong>
                        @(Model.Order.Customer?.Phone ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Reservation ID</span>
                    <strong>
                        @(Model.Order.ReservationID?.ToString() ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Table</span>
                    <strong>
                        @(Model.Order.Reservation?.Table?.TableNumber ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Order Date</span>
                    <strong>
                        @(Model.Order.OrderDate?.ToString(
                            "dd/MM/yyyy hh:mm tt") ?? "-")
                    </strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <span>Total Amount</span>
                    <strong>
                        RM @(Model.Order.TotalAmount?.ToString("0.00") ?? "0.00")
                    </strong>
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <!-- STATUS UPDATE -->
        <div class="status-section">

            <div>
                <h5>Update Order Status</h5>

                <p>
                    @if (canUpdate)
                    {
                        <span>
                            Select the next stage of this order.
                        </span>
                    }
                    else
                    {
                        <span>
                            This order cannot be updated further.
                        </span>
                    }
                </p>
            </div>

            @if (canUpdate)
            {
                <form method="post" class="status-form">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="status-controls">

                        <select asp-for="NewStatus"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Next Status --
                            </option>

                            @foreach (string status in allowedNextStatuses)
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </select>

                        <button type="submit"
                                class="btn update-btn">
                            Update Status
                        </button>

                    </div>

                </form>
            }
            else
            {
                <span class="final-status">
                    @if (currentStatus == "Completed")
                    {
                        <text>✅ Order Completed</text>
                    }
                    else if (currentStatus == "Cancelled")
                    {
                        <text>❌ Order Cancelled</text>
                    }
                    else
                    {
                        <text>Status Unavailable</text>
                    }
                </span>
            }

        </div>

    </div>

</div>

<style>

    .order-details-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* PAGE HEADER */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    /* MAIN DETAILS CARD */
    .details-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .small-label {
        color: #6b7280;
        font-size: 13px;
    }

    .order-header h4 {
        margin-top: 4px;
        font-weight: 700;
        color: #1f2937;
    }

    /* ORDER STATUS BADGES */
    .status-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .pending {
        background: #f3f4f6;
        color: #374151;
    }

    .preparing {
        background: #fef3c7;
        color: #92400e;
    }

    .ready {
        background: #dbeafe;
        color: #1e40af;
    }

    .served {
        background: #e0e7ff;
        color: #3730a3;
    }

    .completed {
        background: #dcfce7;
        color: #166534;
    }

    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .default-status {
        background: #e5e7eb;
        color: #374151;
    }

    /* ORDER INFORMATION */
    .info-box {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
        height: 100%;
    }

    .info-box span {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
    }

    .info-box strong {
        color: #1f2937;
        overflow-wrap: anywhere;
    }

    /* STATUS UPDATE SECTION */
    .status-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
    }

    .status-section h5 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .status-section p {
        margin: 0;
        color: #6b7280;
    }

    .status-form {
        min-width: 420px;
    }

    .status-controls {
        display: flex;
        gap: 10px;
    }

    .status-controls .form-select {
        border-radius: 10px;
        min-height: 45px;
    }

    /* UPDATE BUTTON */
    .update-btn {
        background: #f59e0b;
        color: #111827;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .update-btn:hover {
        background: #d97706;
        color: white;
    }

    /* FINAL STATUS */
    .final-status {
        background: #f3f4f6;
        color: #374151;
        border-radius: 10px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
    }

    /* RESPONSIVE */
    @@media (max-width: 750px) {

        .page-header,
        .status-section {
            flex-direction: column;
            align-items: flex-start;
        }

        .status-form {
            width: 100%;
            min-width: 0;
        }

        .status-controls {
            width: 100%;
            flex-direction: column;
        }

        .details-card {
            padding: 20px;
        }

    }

</style>
