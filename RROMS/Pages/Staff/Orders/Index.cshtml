@page
@model RROMS.Pages.Staff.Orders.IndexModel

@{
    ViewData["Title"] = "Orders";
    Layout = "_StaffLayout";
}

<div class="orders-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2>Orders</h2>
            <p>Receive, process, and update customer orders.</p>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="summary-row">

        <div class="summary-card">
            <div class="summary-icon">🧾</div>
            <div>
                <span>Total Orders</span>
                <h3>@Model.Orders.Count</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">👨‍🍳</div>
            <div>
                <span>Preparing</span>
                <h3>
                    @Model.Orders.Count(o =>
                        string.Equals(
                            o.Status,
                            "Preparing",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">🔔</div>
            <div>
                <span>Ready to Serve</span>
                <h3>
                    @Model.Orders.Count(o =>
                        string.Equals(
                            o.Status,
                            "Ready to Serve",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">✅</div>
            <div>
                <span>Completed</span>
                <h3>
                    @Model.Orders.Count(o =>
                        string.Equals(
                            o.Status,
                            "Completed",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

    </div>

    <!-- ORDERS TABLE -->
    <div class="orders-card">

        <div class="table-toolbar">

            <div>
                <h4>Incoming Orders</h4>
                <p>Manage and monitor customer order progress.</p>
            </div>

            <!-- SEARCH AND STATUS FILTER -->
            <form method="get" class="filters">

                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search customer..." />

                <select name="StatusFilter"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All"
                            selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">
                        All Status
                    </option>

                    <option value="Pending"
                            selected="@(Model.StatusFilter == "Pending")">
                        Pending
                    </option>

                    <option value="Preparing"
                            selected="@(Model.StatusFilter == "Preparing")">
                        Preparing
                    </option>

                    <option value="Ready to Serve"
                            selected="@(Model.StatusFilter == "Ready to Serve")">
                        Ready to Serve
                    </option>

                    <option value="Served"
                            selected="@(Model.StatusFilter == "Served")">
                        Served
                    </option>

                    <option value="Completed"
                            selected="@(Model.StatusFilter == "Completed")">
                        Completed
                    </option>

                    <option value="Cancelled"
                            selected="@(Model.StatusFilter == "Cancelled")">
                        Cancelled
                    </option>

                </select>

                <button type="submit" class="btn btn-dark">
                    Search
                </button>

                <a asp-page="/Staff/Orders/Index"
                   class="btn btn-outline-secondary">
                    Reset
                </a>

            </form>

        </div>

        <div class="table-responsive">

            <table class="table orders-table align-middle">

                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Table</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Orders.Any())
                    {
                        foreach (var order in Model.Orders)
                        {
                            <tr>

                                <!-- ORDER ID -->
                                <td>
                                    @order.OrderID
                                </td>

                                <!-- CUSTOMER -->
                                <td>
                                    @if (order.Customer != null)
                                    {
                                        <strong>
                                            @order.Customer.Name
                                        </strong>

                                        @if (!string.IsNullOrEmpty(
                                            order.Customer.Phone))
                                        {
                                            <div class="text-muted small">
                                                @order.Customer.Phone
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- RESERVATION ID -->
                                <td>
                                    @(order.ReservationID?.ToString() ?? "-")
                                </td>

                                <!-- TABLE NUMBER -->
                                <td>
                                    @if (order.Reservation?.Table != null)
                                    {
                                        @order.Reservation.Table.TableNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- ORDER TOTAL -->
                                <td>
                                    RM @(order.TotalAmount?.ToString("0.00") ?? "0.00")
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @{
                                        string status =
                                            order.Status ?? "Pending";

                                        string statusClass =
                                            status.ToLowerInvariant() switch
                                            {
                                                "preparing" => "preparing",
                                                "ready to serve" => "ready",
                                                "served" => "served",
                                                "completed" => "completed",
                                                "cancelled" => "cancelled",
                                                _ => "pending"
                                            };
                                    }

                                    <span class="status-badge @statusClass">
                                        @status
                                    </span>
                                </td>

                                <!-- VIEW DETAILS -->
                                <td>
                                    <a asp-page="/Staff/Orders/Details"
                                       asp-route-id="@order.OrderID"
                                       class="btn btn-sm btn-outline-dark">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">
                                No orders found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .orders-page {
        width: 100%;
    }

    /* PAGE HEADER */
    .page-header {
        margin-bottom: 25px;
    }

        .page-header h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #1f2937;
        }

        .page-header p {
            margin: 0;
            color: #6b7280;
        }

    /* SUMMARY CARDS */
    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
        color: #111827;
    }

    /* MAIN ORDERS CARD */
    .orders-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    /* TABLE TOOLBAR */
    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
        flex-wrap: wrap;
    }

        .table-toolbar h4 {
            margin-bottom: 3px;
            font-weight: 700;
        }

        .table-toolbar p {
            margin: 0;
            color: #6b7280;
        }

    /* FILTERS */
    .filters {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .filters .form-control {
            width: 210px;
        }

        .filters .form-select {
            width: 170px;
        }

        .filters .form-control,
        .filters .form-select {
            min-height: 40px;
            border-radius: 10px;
        }

        .filters .btn {
            border-radius: 10px;
            white-space: nowrap;
        }

    /* TABLE */
    .orders-table {
        width: 100%;
    }

        .orders-table thead th {
            background: #f9fafb;
            border-bottom: none;
            color: #4b5563;
            font-size: 14px;
            padding: 14px;
            white-space: nowrap;
        }

        .orders-table td {
            padding: 15px 14px;
            vertical-align: middle;
        }

        .orders-table tbody tr:hover {
            background: #fffaf0;
        }

    /* STATUS BADGES */
    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .preparing {
        background: #fef3c7;
        color: #92400e;
    }

    .ready {
        background: #dbeafe;
        color: #1e40af;
    }

    .served {
        background: #e0e7ff;
        color: #3730a3;
    }

    .completed {
        background: #dcfce7;
        color: #166534;
    }

    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .pending {
        background: #f3f4f6;
        color: #374151;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

        .filters {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

            .filters .form-control,
            .filters .form-select,
            .filters .btn {
                width: 100%;
            }

        .orders-card {
            padding: 15px;
        }
    }

</style>
