@page
@model RROMS.Pages.Staff.Orders.IndexModel

@{
    ViewData["Title"] = "Orders";
    Layout = "_StaffLayout";

    string StatusBadge(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "preparing" =>
                "staff-badge staff-badge-warning",

            "ready to serve" =>
                "staff-badge staff-badge-info",

            "served" =>
                "staff-badge staff-badge-completed",

            "completed" =>
                "staff-badge staff-badge-success",

            "cancelled" =>
                "staff-badge staff-badge-danger",

            _ =>
                "staff-badge staff-badge-pending"
        };
    }
}

<header class="staff-page-header">
    <h1>Orders</h1>

    <p>
        Receive, process, and update customer orders.
    </p>
</header>

<section class="staff-summary-grid"
         aria-label="Order summary">

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" />
                <path d="M9 8h6M9 12h6M9 16h3" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Total Orders
            </div>

            <div class="staff-summary-value">
                @Model.TotalOrders
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M7 18h10" />
                <path d="M8 18c-2-3-2-7 0-10" />
                <path d="M16 18c2-3 2-7 0-10" />
                <path d="M9 6c0-2 1-3 3-3s3 1 3 3" />
                <path d="M6 21h12" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Preparing
            </div>

            <div class="staff-summary-value">
                @Model.PreparingCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M6 17h12" />
                <path d="M8 17v-5a4 4 0 0 1 8 0v5" />
                <path d="M12 5V3M5 12H3M21 12h-2" />
                <path d="M4 20h16" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Ready to Serve
            </div>

            <div class="staff-summary-value">
                @Model.ReadyCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 3 3 5-6" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Completed
            </div>

            <div class="staff-summary-value">
                @Model.CompletedCount
            </div>
        </div>
    </div>
</section>

<section class="staff-card">
    <div class="staff-toolbar">
        <div>
            <h2 class="staff-toolbar-title">
                Incoming Orders
            </h2>

            <p class="staff-toolbar-copy">
                Manage and monitor customer order progress.
            </p>
        </div>

        <form method="get"
              class="staff-filter-form">

            <input type="search"
                   name="Search"
                   value="@Model.Search"
                   class="staff-input staff-search-input"
                   placeholder="Search name or phone"
                   autocomplete="off" />

            <select name="StatusFilter"
                    class="staff-select staff-status-select">

                <option value="All"
                        selected="@(Model.StatusFilter == "All")">
                    All statuses
                </option>

                <option value="Pending"
                        selected="@(Model.StatusFilter == "Pending")">
                    Pending
                </option>

                <option value="Preparing"
                        selected="@(Model.StatusFilter == "Preparing")">
                    Preparing
                </option>

                <option value="Ready to Serve"
                        selected="@(Model.StatusFilter == "Ready to Serve")">
                    Ready to Serve
                </option>

                <option value="Served"
                        selected="@(Model.StatusFilter == "Served")">
                    Served
                </option>

                <option value="Completed"
                        selected="@(Model.StatusFilter == "Completed")">
                    Completed
                </option>

                <option value="Cancelled"
                        selected="@(Model.StatusFilter == "Cancelled")">
                    Cancelled
                </option>
            </select>

            <button type="submit"
                    class="staff-button staff-button-dark">
                Search
            </button>

            <a asp-page="./Index"
               class="staff-button staff-button-secondary">
                Reset
            </a>
        </form>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="staff-empty-state">
            <div class="staff-empty-title">
                No orders found
            </div>

            <div>
                Try changing the customer search or status filter.
            </div>
        </div>
    }
    else
    {
        <div class="staff-table-wrapper">
            <table class="staff-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Table</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        string status =
                            order.Status ?? "Pending";

                        <tr>
                            <td>
                                #@order.OrderID
                            </td>

                            <td>
                                @if (order.Customer != null)
                                {
                                    <strong>
                                        @order.Customer.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        order.Customer.Phone))
                                    {
                                        <div style="margin-top:2px;
                                                    color:#64748b;
                                                    font-size:11px;">
                                            @order.Customer.Phone
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span style="color:#94a3b8;">
                                        Unknown customer
                                    </span>
                                }
                            </td>

                            <td>
                                @(order.ReservationID?.ToString()
                                    ?? "—")
                            </td>

                            <td>
                                @(order.Reservation?.Table?.TableNumber
                                    ?? "—")
                            </td>

                            <td>
                                <strong>
                                    RM @((order.TotalAmount ?? 0m)
                                        .ToString("F2"))
                                </strong>
                            </td>

                            <td>
                                <span class="@StatusBadge(status)">
                                    @status
                                </span>
                            </td>

                            <td>
                                <a asp-page="./Details"
                                   asp-route-id="@order.OrderID"
                                   class="staff-button staff-button-secondary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="staff-result-count">
        @if (Model.TotalResults == 0)
        {
            <span>No matching orders</span>
        }
        else
        {
            <span>
                Showing @Model.FirstResultNumber–@Model.LastResultNumber
                of @Model.TotalResults orders
            </span>
        }
    </div>

    @if (Model.TotalResults > 0)
    {
        <nav class="staff-pagination"
             aria-label="Order result pages">

            <div class="staff-page-status">
                Page @Model.PageNumber of @Model.TotalPages
            </div>

            <div class="staff-page-links">
                @if (Model.HasPreviousPage)
                {
                    <a asp-page="./Index"
                       asp-route-Search="@Model.Search"
                       asp-route-StatusFilter="@Model.StatusFilter"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       class="staff-button staff-button-secondary">
                        ← Previous
                    </a>
                }
                else
                {
                    <span class="staff-button staff-button-secondary"
                          style="opacity:0.5;
                                 cursor:not-allowed;"
                          aria-disabled="true">
                        ← Previous
                    </span>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-page="./Index"
                       asp-route-Search="@Model.Search"
                       asp-route-StatusFilter="@Model.StatusFilter"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       class="staff-button staff-button-secondary">
                        Next →
                    </a>
                }
                else
                {
                    <span class="staff-button staff-button-secondary"
                          style="opacity:0.5;
                                 cursor:not-allowed;"
                          aria-disabled="true">
                        Next →
                    </span>
                }
            </div>
        </nav>
    }
</section>