@page
@model RROMS.Pages.Staff.Orders.IndexModel

@{
    ViewData["Title"] = "Orders";
    Layout = "_StaffLayout";
}

<div class="orders-page">

    <div class="page-header">
        <div>
            <h2>Orders</h2>
            <p>Receive, process, and update customer orders.</p>
        </div>
    </div>

    <div class="summary-row">

        <div class="summary-card">
            <div class="summary-icon">🧾</div>
            <div>
                <span>Total Orders</span>
                <h3>@Model.Orders.Count</h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">👨‍🍳</div>
            <div>
                <span>Preparing</span>
                <h3>
                    @Model.Orders.Count(o =>
                        o.Status != null &&
                        o.Status.Equals("Preparing",
                        StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">🔔</div>
            <div>
                <span>Ready to Serve</span>
                <h3>
                    @Model.Orders.Count(o =>
                        o.Status != null &&
                        o.Status.Equals("Ready to Serve",
                        StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon">✅</div>
            <div>
                <span>Completed</span>
                <h3>
                    @Model.Orders.Count(o =>
                        o.Status != null &&
                        o.Status.Equals("Completed",
                        StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>
        </div>

    </div>

    <div class="orders-card">

        <div class="table-toolbar">

            <div>
                <h4>Incoming Orders</h4>
                <p>Manage and monitor customer order progress.</p>
            </div>

            <div class="filters">

                <input type="text"
                       class="form-control"
                       placeholder="Search order..." />

                <select class="form-select">
                    <option selected>All Status</option>
                    <option>Preparing</option>
                    <option>Ready to Serve</option>
                    <option>Served</option>
                    <option>Completed</option>
                    <option>Cancelled</option>
                </select>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table orders-table align-middle">

                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Table</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        foreach (var order in Model.Orders)
                        {
                            <tr>

                                <td>
                                    @order.OrderID
                                </td>

                                <td>
                                    @if (order.Customer != null)
                                    {
                                        <strong>
                                            @order.Customer.Name
                                        </strong>

                                        @if (!string.IsNullOrEmpty(order.Customer.Phone))
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @order.Customer.Phone
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (order.ReservationID.HasValue)
                                    {
                                        @order.ReservationID
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (order.Reservation?.Table != null)
                                    {
                                        @order.Reservation.Table.TableNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td>
                                    RM @(order.TotalAmount?.ToString("0.00") ?? "0.00")
                                </td>

                                <td>

                                    @if (order.Status != null &&
                                         order.Status.Equals(
                                             "Preparing",
                                             StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge preparing">
                                            Preparing
                                        </span>
                                    }
                                    else if (order.Status != null &&
                                             order.Status.Equals(
                                                 "Ready to Serve",
                                                 StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge ready">
                                            Ready to Serve
                                        </span>
                                    }
                                    else if (order.Status != null &&
                                             order.Status.Equals(
                                                 "Served",
                                                 StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge served">
                                            Served
                                        </span>
                                    }
                                    else if (order.Status != null &&
                                             order.Status.Equals(
                                                 "Completed",
                                                 StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge completed">
                                            Completed
                                        </span>
                                    }
                                    else if (order.Status != null &&
                                             order.Status.Equals(
                                                 "Cancelled",
                                                 StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge cancelled">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending">
                                            @(order.Status ?? "Pending")
                                        </span>
                                    }

                                </td>

                                <td>
                                    <a asp-page="/Staff/Orders/Details"
                                       asp-route-id="@order.OrderID"
                                       class="btn btn-sm btn-outline-dark">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">
                                No orders found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .orders-page {
        width: 100%;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .orders-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    .filters {
        display: flex;
        gap: 10px;
        width: 420px;
    }

    .filters .form-control,
    .filters .form-select {
        border-radius: 10px;
    }

    .orders-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .orders-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .preparing {
        background: #fef3c7;
        color: #92400e;
    }

    .ready {
        background: #dbeafe;
        color: #1e40af;
    }

    .served {
        background: #e0e7ff;
        color: #3730a3;
    }

    .completed {
        background: #dcfce7;
        color: #166534;
    }

    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .pending {
        background: #f3f4f6;
        color: #374151;
    }

    @@media(max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .filters {
            width: 100%;
        }

    }

    @@media(max-width: 700px) {

        .summary-row {
            grid-template-columns: 1fr;
        }

        .filters {
            flex-direction: column;
        }

    }

</style>