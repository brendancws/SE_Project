
@page
@model RROMS.Pages.Staff.Dashboard.IndexModel

@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_StaffLayout";
}

<div class="staff-dashboard">

    <div class="dashboard-header mb-4">
        <div>
            <h2 class="fw-bold mb-1">Staff Dashboard</h2>
            <p class="text-muted mb-0">
                Overview of today's restaurant activities.
            </p>
        </div>
    </div>

    <!-- DASHBOARD STATISTICS -->
    <div class="row g-4 mb-4">

        <!-- TODAY'S RESERVATIONS -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="card-icon">📅</div>
                <div>
                    <p class="card-label">Today's Reservations</p>
                    <h3>@Model.TodayReservations</h3>
                </div>
            </div>
        </div>

        <!-- PENDING ORDERS -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="card-icon">🍽️</div>
                <div>
                    <p class="card-label">Pending Orders</p>
                    <h3>@Model.PendingOrders</h3>
                </div>
            </div>
        </div>

        <!-- ORDERS READY -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="card-icon">✅</div>
                <div>
                    <p class="card-label">Orders Ready</p>
                    <h3>@Model.OrdersReady</h3>
                </div>
            </div>
        </div>

        <!-- PENDING PAYMENTS -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="card-icon">💳</div>
                <div>
                    <p class="card-label">Pending Payments</p>
                    <h3>@Model.PendingPayments</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- TODAY'S RESERVATIONS -->
    <div class="dashboard-section">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h4 class="fw-bold mb-1">
                    Today's Reservations
                </h4>

                <small class="text-muted">
                    Manage upcoming customer reservations
                </small>
            </div>

            <a asp-page="/Staff/Reservations/Index"
               class="btn btn-dark">
                View All
            </a>

        </div>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Guests</th>
                        <th>Table</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.TodayReservationList.Any())
                    {
                        foreach (var reservation in Model.TodayReservationList)
                        {
                            <tr>

                                <!-- TIME -->
                                <td>
                                    @reservation.Time.ToString(@"hh\:mm")
                                </td>

                                <!-- CUSTOMER -->
                                <td>
                                    @(reservation.Customer?.Name ?? "Unknown")
                                </td>

                                <!-- GUESTS -->
                                <td>
                                    @reservation.NumberOfGuests
                                </td>

                                <!-- TABLE -->
                                <td>
                                    @if (reservation.Table != null)
                                    {
                                        <span>
                                            Table @reservation.Table.TableNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unassigned
                                        </span>
                                    }
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @{
                                        string status =
                                            reservation.Status ?? "Pending";

                                        string badgeClass = status switch
                                        {
                                            "Confirmed" => "bg-success",
                                            "Pending" => "bg-warning text-dark",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badgeClass">
                                        @status
                                    </span>
                                </td>

                                <!-- ACTION -->
                                <td>
                                    <a asp-page="/Staff/Reservations/Edit"
                                       asp-route-id="@reservation.ReservationID"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No reservations found for today.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .staff-dashboard {
        padding: 10px 5px;
    }

    .dashboard-header h2 {
        color: #202124;
    }

    .dashboard-card {
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 120px;
        transition: 0.2s;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    .card-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: #f5f5f5;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 26px;
    }

    .card-label {
        margin-bottom: 5px;
        font-size: 14px;
        color: #777;
    }

    .dashboard-card h3 {
        margin: 0;
        font-weight: 700;
    }

    .dashboard-section {
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .table thead th {
        background: #f8f9fa;
        color: #555;
        border-bottom: none;
        padding: 14px;
    }

    .table td {
        padding: 15px 14px;
    }

    .badge {
        font-size: 12px;
        padding: 7px 12px;
        border-radius: 20px;
    }

    @@media (max-width: 768px) {

        .dashboard-section {
            padding: 15px;
        }

        .dashboard-card {
            padding: 18px;
        }

    }

</style>
