@page
@model RROMS.Pages.Staff.Profile.ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_StaffLayout";
}

@section Styles {
    <style>
        .password-page {
            width: 100%;
            max-width: 720px;
        }

        .password-card {
            margin: 0;
        }

        .password-card-header {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 22px;
            padding-bottom: 18px;
            border-bottom: 1px solid var(--staff-border);
        }

        .password-card-icon {
            display: grid;
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 12px;
            background: var(--staff-primary-soft);
            color: var(--staff-primary-dark);
        }

        .password-card-icon svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .password-card-title {
            margin: 0;
            color: var(--staff-text);
            font-size: 16px;
            font-weight: 850;
        }

        .password-card-copy {
            margin: 4px 0 0;
            color: var(--staff-text-secondary);
            font-size: 12px;
            line-height: 1.5;
        }

        .password-form-group {
            margin-bottom: 18px;
        }

        .password-label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 12px;
            font-weight: 750;
        }

        .password-input {
            width: 100%;
            min-height: 43px;
            padding: 9px 12px;
            border: 1px solid var(--staff-border-strong);
            border-radius: var(--staff-radius-sm);
            background: #ffffff;
            color: var(--staff-text);
            outline: none;
            transition:
                border-color 0.15s ease,
                box-shadow 0.15s ease;
        }

        .password-input:focus {
            border-color: var(--staff-primary);
            box-shadow: var(--staff-focus);
        }

        .password-validation {
            display: block;
            margin-top: 5px;
            color: #b91c1c;
            font-size: 11px;
        }

        .password-requirements {
            margin-top: 8px;
            padding: 11px 13px;
            border: 1px solid #fde68a;
            border-radius: var(--staff-radius-sm);
            background: #fffbeb;
            color: #92400e;
            font-size: 11px;
            line-height: 1.55;
        }

        .password-requirements strong {
            display: block;
            margin-bottom: 3px;
        }

        .password-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--staff-border);
        }

        @@media (max-width: 600px) {
            .password-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .password-actions .staff-button {
                width: 100%;
            }
        }
    </style>
}

<header class="staff-page-header">
    <h1>Change Password</h1>

    <p>
        Update your Staff account password securely.
    </p>
</header>

<div class="password-page">
    <section class="staff-card password-card">
        <div class="password-card-header">
            <div class="password-card-icon"
                 aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5"
                          y="10"
                          width="14"
                          height="11"
                          rx="2" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    <path d="M12 14v3" />
                </svg>
            </div>

            <div>
                <h2 class="password-card-title">
                    Account Security
                </h2>

                <p class="password-card-copy">
                    Confirm the current password, then choose a new
                    password for the Staff account.
                </p>
            </div>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="password-form-group">
                <label asp-for="Input.CurrentPassword"
                       class="password-label">
                    Current Password
                </label>

                <input asp-for="Input.CurrentPassword"
                       class="password-input"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Enter current password" />

                <span asp-validation-for="Input.CurrentPassword"
                      class="password-validation">
                </span>
            </div>

            <div class="password-form-group">
                <label asp-for="Input.NewPassword"
                       class="password-label">
                    New Password
                </label>

                <input asp-for="Input.NewPassword"
                       class="password-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Enter new password" />

                <span asp-validation-for="Input.NewPassword"
                      class="password-validation">
                </span>

                <div class="password-requirements">
                    <strong>Password requirement</strong>
                    Use at least 12 characters. Follow any additional
                    uppercase, lowercase, number, or symbol requirements
                    shown by validation.
                </div>
            </div>

            <div class="password-form-group">
                <label asp-for="Input.ConfirmPassword"
                       class="password-label">
                    Confirm New Password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="password-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Re-enter the new password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="password-validation">
                </span>
            </div>

            <div class="password-actions">
                <button type="submit"
                        class="staff-button staff-button-primary">
                    Update Password
                </button>

                <a asp-page="./Index"
                   class="staff-button staff-button-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}