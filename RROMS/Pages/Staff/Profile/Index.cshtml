@page
@model RROMS.Pages.Staff.Profile.IndexModel

@{
    ViewData["Title"] = "Staff Profile";
    Layout = "_StaffLayout";
}

@section Styles {
    <style>
        .staff-profile-container {
            width: 100%;
            max-width: 1100px;
        }

        .staff-profile-card {
            margin: 0;
        }

        .staff-profile-identity {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 24px;
            padding-bottom: 21px;
            border-bottom: 1px solid var(--staff-border);
        }

        .staff-profile-avatar {
            display: grid;
            width: 72px;
            height: 72px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 50%;
            background: var(--staff-sidebar-dark);
            color: #fbbf24;
            font-size: 26px;
            font-weight: 850;
        }

        .staff-profile-name {
            margin: 0;
            color: var(--staff-text);
            font-size: 20px;
            font-weight: 850;
            overflow-wrap: anywhere;
        }

        .staff-profile-role {
            margin: 4px 0 0;
            color: var(--staff-text-secondary);
            font-size: 13px;
        }

        .staff-profile-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .staff-form-group {
            min-width: 0;
        }

        .staff-form-label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 12px;
            font-weight: 750;
        }

        .staff-form-control {
            width: 100%;
            min-height: 43px;
            padding: 9px 12px;
            border: 1px solid var(--staff-border-strong);
            border-radius: var(--staff-radius-sm);
            background: #ffffff;
            color: var(--staff-text);
            outline: none;
        }

        .staff-form-control:focus {
            border-color: var(--staff-primary);
            box-shadow: var(--staff-focus);
        }

        .staff-form-control[readonly] {
            background: #f1f5f9;
            color: #64748b;
        }

        .staff-form-validation {
            display: block;
            margin-top: 5px;
            color: #b91c1c;
            font-size: 11px;
        }

        .staff-profile-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 9px;
            margin-top: 24px;
        }

        .staff-security-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-top: 28px;
            padding-top: 23px;
            border-top: 1px solid var(--staff-border);
        }

        .staff-security-title {
            color: var(--staff-text);
            font-size: 15px;
            font-weight: 850;
        }

        .staff-security-copy {
            max-width: 570px;
            margin: 4px 0 0;
            color: var(--staff-text-secondary);
            font-size: 12px;
        }

        @@media (max-width: 700px) {
            .staff-profile-form-grid {
                grid-template-columns: 1fr;
            }

            .staff-profile-identity {
                align-items: flex-start;
            }

            .staff-profile-avatar {
                width: 58px;
                height: 58px;
                font-size: 21px;
            }

            .staff-profile-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .staff-profile-actions .staff-button {
                width: 100%;
            }

            .staff-security-section {
                align-items: stretch;
                flex-direction: column;
            }

            .staff-security-section .staff-button {
                width: 100%;
            }
        }
    </style>
}

<header class="staff-page-header">
    <h1>My Profile</h1>

    <p>
        View and update your personal Staff information.
    </p>
</header>

<div class="staff-profile-container">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @Model.StatusMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <section class="staff-card staff-profile-card">
        <div class="staff-profile-identity">
            <div class="staff-profile-avatar"
                 aria-hidden="true">
                @(string.IsNullOrWhiteSpace(Model.Input.Name)
                    ? "S"
                    : Model.Input.Name
                        .Substring(0, 1)
                        .ToUpperInvariant())
            </div>

            <div>
                <h2 class="staff-profile-name">
                    @Model.Input.Name
                </h2>

                <p class="staff-profile-role">
                    @(string.IsNullOrWhiteSpace(Model.Input.Role)
                        ? "Staff"
                        : Model.Input.Role)
                </p>
            </div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="staff-profile-form-grid">
                <div class="staff-form-group">
                    <label asp-for="Input.Name"
                           class="staff-form-label">
                        Full Name
                    </label>

                    <input asp-for="Input.Name"
                           class="staff-form-control"
                           maxlength="100"
                           placeholder="Enter full name"
                           autocomplete="name" />

                    <span asp-validation-for="Input.Name"
                          class="staff-form-validation">
                    </span>
                </div>

                <div class="staff-form-group">
                    <label asp-for="Input.Email"
                           class="staff-form-label">
                        Email Address
                    </label>

                    <input asp-for="Input.Email"
                           class="staff-form-control"
                           type="email"
                           maxlength="150"
                           placeholder="Enter email address"
                           autocomplete="email" />

                    <span asp-validation-for="Input.Email"
                          class="staff-form-validation">
                    </span>
                </div>

                <div class="staff-form-group">
                    <label asp-for="Input.Phone"
                           class="staff-form-label">
                        Phone Number
                    </label>

                    <input asp-for="Input.Phone"
                           class="staff-form-control"
                           maxlength="30"
                           placeholder="Enter phone number"
                           autocomplete="tel" />

                    <span asp-validation-for="Input.Phone"
                          class="staff-form-validation">
                    </span>
                </div>

                <div class="staff-form-group">
                    <label class="staff-form-label">
                        Role
                    </label>

                    <input type="text"
                           value="@Model.Input.Role"
                           class="staff-form-control"
                           readonly />
                </div>

                <div class="staff-form-group">
                    <label class="staff-form-label">
                        Account Status
                    </label>

                    <input type="text"
                           value="@Model.Input.Status"
                           class="staff-form-control"
                           readonly />
                </div>
            </div>

            <div class="staff-profile-actions">
                <a asp-page="./Index"
                   class="staff-button staff-button-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="staff-button staff-button-primary">
                    Save Changes
                </button>
            </div>
        </form>

        <div class="staff-security-section">
            <div>
                <div class="staff-security-title">
                    Account Security
                </div>

                <p class="staff-security-copy">
                    Keep the Staff account secure by updating the
                    password regularly.
                </p>
            </div>

            <a asp-page="./ChangePassword"
               class="staff-button staff-button-dark">
                Change Password
            </a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}