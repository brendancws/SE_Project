@page
@model RROMS.Pages.Staff.Feedback.IndexModel

@{
    ViewData["Title"] = "Customer Feedback";
    Layout = "_StaffLayout";
}

@section Styles {
    <style>
        .feedback-summary-grid {
            grid-template-columns:
                repeat(2, minmax(0, 260px));
        }

        .feedback-table {
            min-width: 1050px;
        }

        .feedback-comment {
            min-width: 240px;
            max-width: 420px;
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .feedback-rating {
            display: inline-flex;
            min-height: 25px;
            align-items: center;
            padding: 5px 10px;
            border-radius: 999px;
            background: var(--staff-warning-soft);
            color: #92400e;
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
        }

        @@media (max-width: 650px) {
            .feedback-summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<header class="staff-page-header">
    <h1>Customer Feedback</h1>

    <p>
        View ratings and comments submitted after completed dining
        experiences.
    </p>
</header>

<section class="staff-summary-grid feedback-summary-grid"
         aria-label="Customer feedback summary">

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M4 5h16v11H9l-5 4V5z" />
                <path d="M8 9h8M8 12h5" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Total Feedback
            </div>

            <div class="staff-summary-value">
                @Model.FeedbackItems.Count
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                Average Rating
            </div>

            <div class="staff-summary-value">
                @Model.AverageRating.ToString("0.0") / 5
            </div>
        </div>
    </div>
</section>

<section class="staff-card">
    <div class="staff-toolbar">
        <div>
            <h2 class="staff-toolbar-title">
                Submitted Feedback
            </h2>

            <p class="staff-toolbar-copy">
                Feedback is read-only and linked to the relevant
                reservation.
            </p>
        </div>
    </div>

    @if (!Model.FeedbackItems.Any())
    {
        <div class="staff-empty-state">
            <div class="staff-empty-title">
                No customer feedback found
            </div>

            <div>
                Feedback submitted after completed dining experiences
                will appear here.
            </div>
        </div>
    }
    else
    {
        <div class="staff-table-wrapper">
            <table class="staff-table feedback-table">
                <thead>
                    <tr>
                        <th>Feedback ID</th>
                        <th>Booking</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Table</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Submitted</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var feedback in Model.FeedbackItems)
                    {
                        <tr>
                            <td>
                                #@feedback.FeedbackID
                            </td>

                            <td>
                                <strong>
                                    @feedback.BookingReference
                                </strong>
                            </td>

                            <td>
                                @feedback.CustomerName
                            </td>

                            <td>
                                <strong>
                                    @feedback.ReservationDate.ToString(
                                        "dd MMM yyyy")
                                </strong>

                                <div style="margin-top:2px;
                                            color:#64748b;
                                            font-size:11px;">
                                    @(DateTime.Today
                                        .Add(feedback.ReservationTime)
                                        .ToString("h:mm tt"))
                                </div>
                            </td>

                            <td>
                                Table @feedback.TableNumber
                            </td>

                            <td>
                                <span class="feedback-rating">
                                    @feedback.Rating ★
                                </span>
                            </td>

                            <td class="feedback-comment">
                                @(string.IsNullOrWhiteSpace(
                                    feedback.Comment)
                                    ? "No written comment."
                                    : feedback.Comment)
                            </td>

                            <td>
                                @feedback.SubmittedAt.ToString(
                                    "dd MMM yyyy, h:mm tt")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="staff-result-count">
            @Model.FeedbackItems.Count feedback record(s) shown
        </div>
    }
</section>