@page
@model RROMS.Pages.Staff.Reservations.EditModel

@{
    ViewData["Title"] = "Edit Reservation";
    Layout = "_StaffLayout";
}

<div class="edit-reservation-page">

    <div class="page-header">

        <div>
            <h2>Edit Reservation</h2>
            <p>Update reservation details and table assignment.</p>
        </div>

        <a asp-page="/Staff/Reservations/Index"
           class="btn btn-outline-secondary">

            ← Back to Reservations

        </a>

    </div>

    <div class="edit-card">

        <div class="empty-reservation">

            <div class="empty-icon">
                📅
            </div>

            <h4>No Reservation Selected</h4>

            <p>
                Select a reservation from the Reservations page to edit its details.
            </p>

            <a asp-page="/Staff/Reservations/Index"
               class="btn back-btn">

                View Reservations

            </a>

        </div>

    </div>

</div>

<style>

    .edit-reservation-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .edit-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 60px 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .empty-reservation {
        text-align: center;
        max-width: 500px;
        margin: 0 auto;
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;

        border-radius: 50%;
        background: #f3f4f6;

        display: flex;
        justify-content: center;
        align-items: center;

        font-size: 30px;
    }

    .empty-reservation h4 {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #1f2937;
    }

    .empty-reservation p {
        color: #6b7280;
        margin-bottom: 25px;
    }

    .back-btn {
        background: #f59e0b;
        color: #111827;
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
    }

    .back-btn:hover {
        background: #d97706;
        color: white;
    }

    @@media(max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

    }

</style>