@page
@model RROMS.Pages.Staff.Reservations.EditModel

@{
    ViewData["Title"] = "Edit Reservation";
    Layout = "_StaffLayout";
}

<div class="edit-reservation-page">

    <div class="page-header">
        <div>
            <h2>Edit Reservation</h2>
            <p>Update reservation details and table assignment.</p>
        </div>

        <a asp-page="/Staff/Reservations/Index"
           class="btn btn-outline-secondary">
            ← Back to Reservations
        </a>
    </div>

    <div class="edit-card">

        <h4>Reservation #@Model.Reservation.ReservationID</h4>

        <p class="text-muted">
            Customer:
            <strong>
                @(Model.Reservation.Customer?.Name ?? "Unknown")
            </strong>
        </p>

        <hr />

        <form method="post"
              asp-page="/Staff/Reservations/Edit"
              asp-route-id="@Model.Reservation.ReservationID">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label">
                        Reservation Date
                    </label>

                    <input asp-for="ReservationDate"
                           asp-format="{0:yyyy-MM-dd}"
                           type="date"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Reservation Time
                    </label>

                    <input type="time"
                           id="ReservationTime"
                           name="ReservationTime"
                           value="@(Model.ReservationTime.ToString(@"hh\:mm"))"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Table Assignment
                    </label>

                    <select asp-for="TableId"
                            class="form-select">

                        @foreach (var table in Model.Tables)
                        {
                            <option value="@table.TableID">
                                Table @table.TableNumber
                                (Capacity: @table.Capacity)
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Reservation Status
                    </label>

                    <select asp-for="NewStatus"
                            class="form-select">

                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Cancelled">Cancelled</option>

                    </select>
                </div>

            </div>

            <div class="form-actions">

                <a asp-page="/Staff/Reservations/Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="save-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

<style>
    .edit-reservation-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 15px;
        flex-wrap: wrap;
    }

        .page-header h2 {
            font-size: 30px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 4px;
        }

        .page-header p {
            color: #6b7280;
            margin: 0;
        }

    .edit-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

        .edit-card h4 {
            font-weight: 700;
            color: #1f2937;
        }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 12px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
    }

    .save-btn {
        background: #f59e0b;
        color: #111827;
        border: none;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
    }

        .save-btn:hover {
            background: #d97706;
            color: white;
        }
</style>
