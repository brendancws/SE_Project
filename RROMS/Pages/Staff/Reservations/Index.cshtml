@page
@model RROMS.Pages.Staff.Reservations.IndexModel

@{
    ViewData["Title"] = "Reservations";
    Layout = "_StaffLayout";
}

<div class="reservation-page">

    <div class="page-header">

        <div>
            <h2>Reservations</h2>
            <p>View and manage today's table reservations.</p>
        </div>

        <div class="header-actions">

            <input type="date"
                   class="form-control date-filter"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />

        </div>

    </div>

    <div class="summary-row">

        <div class="summary-card">

            <div class="summary-icon">
                📅
            </div>

            <div>
                <span>Total Today</span>
                <h3>0</h3>
            </div>

        </div>

        <div class="summary-card">

            <div class="summary-icon">
                ⏳
            </div>

            <div>
                <span>Pending</span>
                <h3>0</h3>
            </div>

        </div>

        <div class="summary-card">

            <div class="summary-icon">
                ✅
            </div>

            <div>
                <span>Confirmed</span>
                <h3>0</h3>
            </div>

        </div>

        <div class="summary-card">

            <div class="summary-icon">
                ❌
            </div>

            <div>
                <span>Cancelled</span>
                <h3>0</h3>
            </div>

        </div>

    </div>

    <div class="reservation-card">

        <div class="table-toolbar">

            <div>

                <h4>
                    Today's Reservations
                </h4>

                <p>
                    Manage customer bookings and table assignments.
                </p>

            </div>

            <div class="search-box">

                <input type="text"
                       class="form-control"
                       placeholder="Search customer..." />

            </div>

        </div>

        <div class="table-responsive">

            <table class="table reservation-table align-middle">

                <thead>
                    <tr>
                        <th>Reservation ID</th>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Guests</th>
                        <th>Table</th>
                        <th>Special Request</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>

                        <td colspan="8"
                            class="text-center text-muted py-5">

                            No reservations found.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .reservation-page {
        width: 100%;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .date-filter {
        width: 180px;
        height: 44px;
        border-radius: 10px;
    }

    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;

        display: flex;
        align-items: center;
        gap: 15px;

        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .reservation-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .table-toolbar h4 {
        margin-bottom: 3px;
        font-weight: 700;
    }

    .table-toolbar p {
        margin: 0;
        color: #6b7280;
    }

    .search-box {
        width: 260px;
    }

    .search-box input {
        border-radius: 10px;
    }

    .reservation-table thead th {
        background: #f9fafb;
        border-bottom: none;
        color: #4b5563;
        font-size: 14px;
        padding: 14px;
        white-space: nowrap;
    }

    .reservation-table td {
        padding: 15px 14px;
        vertical-align: middle;
    }

    @@media(max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @@media(max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .summary-row {
            grid-template-columns: 1fr;
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }

    }

</style>