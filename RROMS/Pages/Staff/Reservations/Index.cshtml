@page
@model RROMS.Pages.Staff.Reservations.IndexModel

@{
    ViewData["Title"] = "Reservations";
    Layout = "_StaffLayout";
}

<div class="reservation-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h2>Reservations</h2>
            <p>View and manage restaurant table reservations.</p>
        </div>

        <!-- DATE FILTER -->
        <form method="get" class="header-actions">

            <input type="hidden"
                   name="Search"
                   value="@Model.Search" />

            <input type="date"
                   name="SelectedDate"
                   class="form-control date-filter"
                   value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))"
                   onchange="this.form.submit()" />

        </form>

    </div>

    <!-- SUMMARY CARDS -->
    <div class="summary-row">

        <!-- TOTAL RESERVATIONS -->
        <div class="summary-card">

            <div class="summary-icon">
                📅
            </div>

            <div>
                <span>Total Selected Date</span>
                <h3>@Model.Reservations.Count</h3>
            </div>

        </div>

        <!-- PENDING RESERVATIONS -->
        <div class="summary-card">

            <div class="summary-icon">
                ⏳
            </div>

            <div>
                <span>Pending</span>

                <h3>
                    @Model.Reservations.Count(r =>
                        string.Equals(
                            r.Status,
                            "Pending",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>

        </div>

        <!-- CONFIRMED RESERVATIONS -->
        <div class="summary-card">

            <div class="summary-icon">
                ✅
            </div>

            <div>
                <span>Confirmed</span>

                <h3>
                    @Model.Reservations.Count(r =>
                        string.Equals(
                            r.Status,
                            "Confirmed",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>

        </div>

        <!-- CANCELLED RESERVATIONS -->
        <div class="summary-card">

            <div class="summary-icon">
                ❌
            </div>

            <div>
                <span>Cancelled</span>

                <h3>
                    @Model.Reservations.Count(r =>
                        string.Equals(
                            r.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                </h3>
            </div>

        </div>

    </div>

    <!-- RESERVATIONS TABLE -->
    <div class="reservation-card">

        <div class="table-toolbar">

            <div>
                <h4>Reservations for Selected Date</h4>

                <p>
                    Manage customer bookings and table assignments.
                </p>
            </div>

            <!-- CUSTOMER SEARCH -->
            <form method="get" class="search-box">

                <input type="hidden"
                       name="SelectedDate"
                       value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />

                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search customer..." />

            </form>

        </div>

        <div class="table-responsive">

            <table class="table reservation-table align-middle">

                <thead>
                    <tr>
                        <th>Reservation ID</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Guests</th>
                        <th>Table</th>
                        <th>Special Request</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Reservations.Any())
                    {
                        foreach (var reservation in Model.Reservations)
                        {
                            <tr>

                                <!-- RESERVATION ID -->
                                <td>
                                    @reservation.ReservationID
                                </td>

                                <!-- RESERVATION DATE -->
                                <td>
                                    @reservation.Date.ToString("dd/MM/yyyy")
                                </td>

                                <!-- RESERVATION TIME -->
                                <td>
                                    @reservation.Time.ToString(@"hh\:mm")
                                </td>

                                <!-- CUSTOMER INFORMATION -->
                                <td>

                                    @if (reservation.Customer != null)
                                    {
                                        <strong>
                                            @reservation.Customer.Name
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @reservation.Customer.Phone
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- NUMBER OF GUESTS -->
                                <td>
                                    -
                                </td>

                                <!-- TABLE NUMBER -->
                                <td>

                                    @if (reservation.Table != null)
                                    {
                                        <span>
                                            Table @reservation.Table.TableNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- CUSTOMER SPECIAL REQUEST -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        reservation.Customer?.SpecialRequest))
                                    {
                                        @reservation.Customer.SpecialRequest
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }

                                </td>

                                <!-- RESERVATION STATUS -->
                                <td>

                                    @if (string.Equals(
                                        reservation.Status,
                                        "Confirmed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge confirmed">
                                            Confirmed
                                        </span>
                                    }
                                    else if (string.Equals(
                                        reservation.Status,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge pending">
                                            Pending
                                        </span>
                                    }
                                    else if (string.Equals(
                                        reservation.Status,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge cancelled">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge default-status">
                                            @(reservation.Status ?? "Unknown")
                                        </span>
                                    }

                                </td>

                                <!-- EDIT RESERVATION -->
                                <td>

                                    <a asp-page="/Staff/Reservations/Edit"
                                       asp-route-id="@reservation.ReservationID"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center text-muted py-5">

                                No reservations found for the selected date.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .reservation-page {
        width: 100%;
    }

    /* PAGE HEADER */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 15px;
    }

        .page-header h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 4px;
            color: #1f2937;
        }

        .page-header p {
            margin: 0;
            color: #6b7280;
        }

    /* DATE FILTER */
    .date-filter {
        width: 180px;
        height: 44px;
        border-radius: 10px;
    }

    /* SUMMARY CARDS */
    .summary-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-card span {
        color: #6b7280;
        font-size: 14px;
    }

    .summary-card h3 {
        margin: 3px 0 0;
        font-weight: 700;
        color: #111827;
    }

    /* RESERVATION CARD */
    .reservation-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    /* TABLE TOOLBAR */
    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

        .table-toolbar h4 {
            margin-bottom: 3px;
            font-weight: 700;
            color: #111827;
        }

        .table-toolbar p {
            margin: 0;
            color: #6b7280;
        }

    /* SEARCH BOX */
    .search-box {
        width: 280px;
    }

        .search-box input {
            width: 100%;
            height: 42px;
            border-radius: 10px;
        }

    /* RESERVATION TABLE */
    .reservation-table {
        width: 100%;
    }

        .reservation-table thead th {
            background: #f9fafb;
            border-bottom: none;
            color: #4b5563;
            font-size: 14px;
            padding: 14px;
            white-space: nowrap;
        }

        .reservation-table td {
            padding: 15px 14px;
            vertical-align: middle;
        }

        .reservation-table tbody tr:hover {
            background: #fffaf0;
        }

    /* RESERVATION STATUS */
    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .confirmed {
        background: #dcfce7;
        color: #166534;
    }

    .pending {
        background: #fef3c7;
        color: #92400e;
    }

    .cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .default-status {
        background: #e5e7eb;
        color: #374151;
    }

    /* EDIT BUTTON */
    .btn-outline-warning {
        border-radius: 8px;
        font-weight: 600;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 1100px) {

        .summary-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .summary-row {
            grid-template-columns: 1fr;
        }

        .table-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }

        .reservation-card {
            padding: 15px;
        }
    }

</style>
