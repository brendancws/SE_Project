@page
@model RROMS.Pages.Staff.Reservations.IndexModel

@{
    ViewData["Title"] = "Reservations";
    Layout = "_StaffLayout";

    string StatusBadge(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" =>
                "staff-badge staff-badge-success",

            "pending" =>
                "staff-badge staff-badge-warning",

            "cancelled" =>
                "staff-badge staff-badge-danger",

            "completed" =>
                "staff-badge staff-badge-completed",

            _ =>
                "staff-badge staff-badge-pending"
        };
    }
}

@section Styles {
    <style>
        .reservation-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

        .reservation-header .staff-page-header {
            margin-bottom: 0;
        }

        .reservation-date-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .reservation-date-input {
            min-width: 175px;
        }

        .reservation-navigation {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .reservation-mode-label {
            display: inline-flex;
            min-height: 38px;
            align-items: center;
            padding: 8px 13px;
            border: 1px solid var(--staff-border);
            border-radius: var(--staff-radius-sm);
            background: var(--staff-surface-muted);
            color: #475569;
            font-size: 12px;
            font-weight: 750;
        }

        .reservation-mode-label.active {
            border-color: #fde68a;
            background: var(--staff-primary-soft);
            color: #92400e;
        }

        .reservation-table {
            min-width: 1120px;
        }

        .reservation-empty {
            display: grid;
            min-height: 190px;
            place-items: center;
            padding: 28px 20px;
            text-align: center;
        }

        .reservation-empty-icon {
            display: grid;
            width: 50px;
            height: 50px;
            margin: 0 auto 12px;
            place-items: center;
            border-radius: 15px;
            background: var(--staff-primary-soft);
            color: var(--staff-primary-dark);
        }

        .reservation-empty-icon svg {
            width: 24px;
            height: 24px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .reservation-empty-title {
            color: #334155;
            font-size: 14px;
            font-weight: 850;
        }

        .reservation-empty-copy {
            margin-top: 5px;
            color: var(--staff-text-secondary);
            font-size: 12px;
        }

        @@media (max-width: 760px) {
            .reservation-header {
                flex-direction: column;
            }

            .reservation-date-form,
            .reservation-date-input {
                width: 100%;
            }

            .reservation-navigation {
                display: grid;
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .reservation-navigation .staff-button {
                width: 100%;
            }

            .reservation-mode-label {
                grid-column: 1 / -1;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .reservation-navigation {
                grid-template-columns: 1fr;
            }

            .reservation-mode-label {
                grid-column: auto;
            }
        }
    </style>
}

<div class="reservation-header">
    <header class="staff-page-header">
        <h1>Reservations</h1>

        <p>
            View and manage restaurant table reservations.
        </p>
    </header>

    <form method="get"
          class="reservation-date-form">
        <input type="hidden"
               name="Search"
               value="@Model.Search" />

        <input type="hidden"
               name="ShowAll"
               value="false" />

        <label for="reservation-date"
               class="visually-hidden">
            Reservation date
        </label>

        <input id="reservation-date"
               type="date"
               name="SelectedDate"
               class="staff-input reservation-date-input"
               value="@Model.SelectedDate?.ToString("yyyy-MM-dd")"
               onchange="this.form.submit()" />
    </form>
</div>

<nav class="reservation-navigation"
     aria-label="Reservation view controls">

    <a asp-page="./Index"
       asp-route-SelectedDate="@Model.PreviousDate.ToString("yyyy-MM-dd")"
       asp-route-Search="@Model.Search"
       asp-route-ShowAll="false"
       class="staff-button staff-button-secondary">
        ← Previous Day
    </a>

    <a asp-page="./Index"
       asp-route-SelectedDate="@DateTime.Today.ToString("yyyy-MM-dd")"
       asp-route-Search="@Model.Search"
       asp-route-ShowAll="false"
       class="staff-button staff-button-primary">
        Today
    </a>

    <a asp-page="./Index"
       asp-route-SelectedDate="@Model.NextDate.ToString("yyyy-MM-dd")"
       asp-route-Search="@Model.Search"
       asp-route-ShowAll="false"
       class="staff-button staff-button-secondary">
        Next Day →
    </a>

    <a asp-page="./Index"
       asp-route-ShowAll="true"
       asp-route-Search="@Model.Search"
       class="staff-button @(Model.ShowAll
           ? "staff-button-dark"
           : "staff-button-secondary")">
        All Reservations
    </a>

    <span class="reservation-mode-label @(Model.IsToday || Model.ShowAll ? "active" : "")">
        @if (Model.ShowAll)
        {
            <span>Showing all reservation records</span>
        }
        else
        {
            <span>
                @Model.SelectedDate?.ToString(
                    "dddd, dd MMMM yyyy")
            </span>
        }
    </span>
</nav>

<section class="staff-summary-grid"
         aria-label="Reservation summary">

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon"
             aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="16" rx="2" />
                <path d="M16 3v4M8 3v4M3 10h18" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">
                @(Model.ShowAll
                    ? "Total Reservations"
                    : "Total Selected Date")
            </div>

            <div class="staff-summary-value">
                @Model.TotalCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M7 3h10M7 21h10" />
                <path d="M8 3c0 4 1 6 4 9-3 3-4 5-4 9" />
                <path d="M16 3c0 4-1 6-4 9 3 3 4 5 4 9" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">Pending</div>
            <div class="staff-summary-value">
                @Model.PendingCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 3 3 5-6" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">Confirmed</div>
            <div class="staff-summary-value">
                @Model.ConfirmedCount
            </div>
        </div>
    </div>

    <div class="staff-card staff-summary-card">
        <div class="staff-summary-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="m9 9 6 6M15 9l-6 6" />
            </svg>
        </div>

        <div>
            <div class="staff-summary-label">Cancelled</div>
            <div class="staff-summary-value">
                @Model.CancelledCount
            </div>
        </div>
    </div>
</section>

<section class="staff-card">
    <div class="staff-toolbar">
        <div>
            <h2 class="staff-toolbar-title">
                @(Model.ShowAll
                    ? "All Reservations"
                    : "Reservations for Selected Date")
            </h2>

            <p class="staff-toolbar-copy">
                Manage customer bookings and table assignments.
            </p>
        </div>

        <form method="get"
              class="staff-filter-form">

            <input type="hidden"
                   name="SelectedDate"
                   value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />

            <input type="hidden"
                   name="ShowAll"
                   value="@Model.ShowAll.ToString().ToLowerInvariant()" />

            <input type="search"
                   name="Search"
                   value="@Model.Search"
                   class="staff-input staff-search-input"
                   placeholder="Search name or phone"
                   autocomplete="off" />

            <button type="submit"
                    class="staff-button staff-button-dark">
                Search
            </button>

            <a asp-page="./Index"
               asp-route-SelectedDate="@Model.SelectedDate?.ToString("yyyy-MM-dd")"
               asp-route-ShowAll="@Model.ShowAll"
               class="staff-button staff-button-secondary">
                Reset
            </a>
        </form>
    </div>

    @if (Model.Reservations.Count == 0)
    {
        <div class="reservation-empty">
            <div>
                <div class="reservation-empty-icon"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                    </svg>
                </div>

                <div class="reservation-empty-title">
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <span>
                            No reservations match “@Model.Search”
                        </span>
                    }
                    else if (Model.ShowAll)
                    {
                        <span>No reservation records found</span>
                    }
                    else
                    {
                        <span>
                            No reservations scheduled for
                            @Model.SelectedDate?.ToString(
                                "dd MMMM yyyy")
                        </span>
                    }
                </div>

                <div class="reservation-empty-copy">
                    Try another date, search term, or view all reservations.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="staff-table-wrapper">
            <table class="staff-table reservation-table">
                <thead>
                    <tr>
                        <th>Reservation ID</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Guests</th>
                        <th>Table</th>
                        <th>Special Request</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Reservations)
                    {
                        string status =
                            reservation.Status ?? "Unknown";

                        <tr>
                            <td>#@reservation.ReservationID</td>

                            <td>
                                @reservation.Date.ToString("dd MMM yyyy")
                            </td>

                            <td>
    @(DateTime.Today
        .Add(reservation.Time)
        .ToString("h:mm tt"))
</td>

                            <td>
                                @if (reservation.Customer != null)
                                {
                                    <strong>
                                        @reservation.Customer.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        reservation.Customer.Phone))
                                    {
                                        <div style="margin-top:2px;
                                                    color:#64748b;
                                                    font-size:11px;">
                                            @reservation.Customer.Phone
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span style="color:#94a3b8;">
                                        Unknown customer
                                    </span>
                                }
                            </td>

                            <td>
                                @reservation.NumberOfGuests
                            </td>

                            <td>
                                @(reservation.Table == null
                                    ? "Unassigned"
                                    : $"Table {reservation.Table.TableNumber}")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    reservation.Customer?.SpecialRequest)
                                    ? "—"
                                    : reservation.Customer.SpecialRequest)
                            </td>

                            <td>
                                <span class="@StatusBadge(status)">
                                    @status
                                </span>
                            </td>

                            <td>
                                <a asp-page="./Edit"
                                   asp-route-id="@reservation.ReservationID"
                                   class="staff-button staff-button-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="staff-result-count">
        @if (Model.TotalResults == 0)
        {
            <span>No matching reservations</span>
        }
        else
        {
            <span>
                Showing @Model.FirstResultNumber–@Model.LastResultNumber
                of @Model.TotalResults reservations
            </span>
        }
    </div>

    @if (Model.TotalResults > 0)
    {
        <nav class="staff-pagination"
             aria-label="Reservation result pages">

            <div class="staff-page-status">
                Page @Model.PageNumber of @Model.TotalPages
            </div>

            <div class="staff-page-links">
                @if (Model.HasPreviousPage)
                {
                    <a asp-page="./Index"
                       asp-route-SelectedDate="@Model.SelectedDate?.ToString("yyyy-MM-dd")"
                       asp-route-ShowAll="@Model.ShowAll"
                       asp-route-Search="@Model.Search"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       class="staff-button staff-button-secondary">
                        ← Previous
                    </a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-page="./Index"
                       asp-route-SelectedDate="@Model.SelectedDate?.ToString("yyyy-MM-dd")"
                       asp-route-ShowAll="@Model.ShowAll"
                       asp-route-Search="@Model.Search"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       class="staff-button staff-button-secondary">
                        Next →
                    </a>
                }
            </div>
        </nav>
    }
</section>