<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — DineFlow Admin</title>

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-shell">
        <aside id="admin-sidebar"
               class="sidebar"
               aria-label="Administrator sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-mark"
                     aria-hidden="true">
                    D
                </div>

                <div class="sidebar-brand-copy">
                    <div class="sidebar-brand-name">
                        DineFlow
                    </div>

                    <div class="sidebar-brand-caption">
                        Administrator
                    </div>
                </div>
            </div>

            <nav class="nav"
                 aria-label="Administrator navigation">
                <div class="nav-group">Overview</div>

                <a href="/Admin/Dashboard"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Dashboard") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M3 11 12 3l9 8" />
        <path d="M5 10v10h14V10M9 20v-6h6v6" />
    </svg>
</span>
                    <span>Dashboard</span>
                </a>

                <div class="nav-group">Operations</div>

                <a href="/Admin/Reservations"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Reservations") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 10h18M8 14h3M8 17h6" />
    </svg>
</span>
                    <span>Reservations</span>
                </a>

                <a href="/Admin/Orders"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Orders") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" />
        <path d="M9 8h6M9 12h6M9 16h3" />
    </svg>
</span>
                    <span>Orders</span>
                </a>

                <a href="/Admin/Payments"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Payments") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="M2.5 9h19M6 15h4" />
    </svg>
</span>
                    <span>Payments</span>
                </a>

                <a href="/Admin/Reports"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Reports") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
    </svg>
</span>
                    <span>Reports</span>
                </a>

                <div class="nav-group">Restaurant Setup</div>

                <a href="/Admin/Tables"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Tables") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M4 8h16M7 8v12M17 8v12M3 5h18v3H3z" />
    </svg>
</span>
                    <span>Tables</span>
                </a>

                <a href="/Admin/OpeningHours"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/OpeningHours") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
    </svg>
</span>
                    <span>Opening Hours</span>
                </a>

                <div class="nav-group">Menu Management</div>

                <a href="/Admin/Categories"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Categories") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M3 6h7l2 2h9v11H3z" />
    </svg>
</span>
                    <span>Menu Categories</span>
                </a>

                <a href="/Admin/MenuItems"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/MenuItems") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10" />
        <path d="M16 3v18M16 3c3 2 4 5 4 8h-4" />
    </svg>
</span>
                    <span>Menu Items</span>
                </a>

                <div class="nav-group">User Management</div>

                <a href="/Admin/Staff"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Staff") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <circle cx="9" cy="8" r="3" />
        <path d="M3 20v-2a6 6 0 0 1 12 0v2" />
        <circle cx="17" cy="9" r="2" />
        <path d="M16 15a5 5 0 0 1 5 5" />
    </svg>
</span>
                    <span>Staff</span>
                </a>

                <a href="/Admin/Customers"
                   class="@(Context.Request.Path.StartsWithSegments("/Admin/Customers") ? "active" : "")">
                    <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21a8 8 0 0 1 16 0" />
    </svg>
</span>
                    <span>Customers</span>
                </a>
            </nav>
        </aside>

        <button id="sidebar-backdrop"
                type="button"
                class="sidebar-backdrop"
                aria-label="Close navigation">
        </button>

        <div class="main">
            <header class="topbar">
                <button id="mobile-menu-button"
                        type="button"
                        class="mobile-menu-button"
                        aria-controls="admin-sidebar"
                        aria-expanded="false"
                        aria-label="Open navigation">
                    ☰
                </button>

                <div class="topbar-heading">
                    <div class="topbar-eyebrow">
                        Administrator Portal
                    </div>

                    <div class="panel-title">
                        @ViewData["Title"]
                    </div>
                </div>

                <div class="user">
                    <div class="avatar" aria-hidden="true">
                        @(User.Identity?.Name?
                            .Substring(0, 1)
                            .ToUpper() ?? "A")
                    </div>

                    <div class="user-copy">
                        <span class="user-label">
                            Signed in as
                        </span>

                        <strong class="user-name">
                            @User.Identity?.Name
                        </strong>
                    </div>

                    <form method="post"
                          asp-page="/Account/Logout"
                          class="logout-form">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">
                            Logout
                        </button>
                    </form>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        (() => {
            const body = document.body;
            const menuButton =
                document.getElementById("mobile-menu-button");
            const backdrop =
                document.getElementById("sidebar-backdrop");
            const sidebar =
                document.getElementById("admin-sidebar");

            const setSidebarOpen = (isOpen) => {
                body.classList.toggle("sidebar-open", isOpen);
                menuButton?.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false");
            };

            menuButton?.addEventListener("click", () => {
                setSidebarOpen(
                    !body.classList.contains("sidebar-open"));
            });

            backdrop?.addEventListener("click", () => {
                setSidebarOpen(false);
            });

            sidebar?.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", () => {
                    if (window.innerWidth <= 900) {
                        setSidebarOpen(false);
                    }
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    setSidebarOpen(false);
                }
            });

            window.addEventListener("resize", () => {
                if (window.innerWidth > 900) {
                    setSidebarOpen(false);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>