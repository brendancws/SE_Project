@using System.Security.Claims

@{
    string staffName =
        User.FindFirstValue(ClaimTypes.Name) ?? "Staff Member";

    string staffInitial =
        string.IsNullOrWhiteSpace(staffName)
            ? "S"
            : staffName.Substring(0, 1).ToUpperInvariant();

    string currentPage =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — DineFlow Staff</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/staff.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="staff-wrapper">
        <aside id="staff-sidebar"
               class="staff-sidebar"
               aria-label="Staff navigation">
            <div class="staff-brand">
                <div class="staff-brand-mark"
                     aria-hidden="true">
                    D
                </div>

                <div>
                    <div class="staff-brand-name">
                        DineFlow
                    </div>

                    <div class="staff-brand-caption">
                        Staff Operations
                    </div>
                </div>
            </div>

            <nav class="staff-nav">
                <a asp-page="/Staff/Dashboard/Index"
                   class="@(currentPage.StartsWith("/Staff/Dashboard") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 11 12 3l9 8" />
                            <path d="M5 10v10h14V10M9 20v-6h6v6" />
                        </svg>
                    </span>
                    <span>Dashboard</span>
                </a>

                <a asp-page="/Staff/Reservations/Index"
                   class="@(currentPage.StartsWith("/Staff/Reservations") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 10h18" />
                        </svg>
                    </span>
                    <span>Reservations</span>
                </a>

                <a asp-page="/Staff/Orders/Index"
                   class="@(currentPage.StartsWith("/Staff/Orders") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" />
                            <path d="M9 8h6M9 12h6M9 16h3" />
                        </svg>
                    </span>
                    <span>Orders</span>
                </a>

                <a asp-page="/Staff/Payments/Index"
                   class="@(currentPage.StartsWith("/Staff/Payments") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="2.5" y="5" width="19" height="14" rx="2" />
                            <path d="M2.5 9h19M6 15h4" />
                        </svg>
                    </span>
                    <span>Payments</span>
                </a>

                <a asp-page="/Staff/Customers/Index"
                   class="@(currentPage.StartsWith("/Staff/Customers") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="8" r="3" />
                            <path d="M3 20v-2a6 6 0 0 1 12 0v2" />
                            <circle cx="17" cy="9" r="2" />
                            <path d="M16 15a5 5 0 0 1 5 5" />
                        </svg>
                    </span>
                    <span>Customers</span>
                </a>

                <a asp-page="/Staff/Feedback/Index"
                   class="@(currentPage.StartsWith("/Staff/Feedback") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 5h16v11H9l-5 4V5z" />
                            <path d="M8 9h8M8 12h5" />
                        </svg>
                    </span>
                    <span>Feedback</span>
                </a>

                <a asp-page="/Staff/Profile/Index"
                   class="@(currentPage.StartsWith("/Staff/Profile") ? "active" : "")">
                    <span class="staff-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21a8 8 0 0 1 16 0" />
                        </svg>
                    </span>
                    <span>Profile</span>
                </a>

                <hr class="staff-nav-divider" />

                <form method="post"
                      asp-page="/Staff/Logout"
                      class="staff-logout-form">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="staff-logout-btn">
                        <span class="staff-nav-icon"
                              aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M10 17l5-5-5-5" />
                                <path d="M15 12H3" />
                                <path d="M13 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" />
                            </svg>
                        </span>
                        <span>Logout</span>
                    </button>
                </form>
            </nav>
        </aside>

        <button id="staff-sidebar-backdrop"
                type="button"
                class="staff-sidebar-backdrop"
                aria-label="Close navigation">
        </button>

        <div class="staff-main">
            <header class="staff-topbar">
                <button id="staff-mobile-menu"
                        type="button"
                        class="staff-mobile-menu"
                        aria-controls="staff-sidebar"
                        aria-expanded="false"
                        aria-label="Open navigation">
                    ☰
                </button>

                <div class="staff-topbar-heading">
                    <div class="staff-topbar-eyebrow">
                        Restaurant Staff Panel
                    </div>

                    <div class="staff-topbar-title">
                        @ViewData["Title"]
                    </div>
                </div>

                <div class="profile-area">
                    <div class="profile-details">
                        <span class="profile-label">
                            Signed in as
                        </span>

                        <strong class="profile-name">
                            @staffName
                        </strong>
                    </div>

                    <div class="profile-circle"
                         aria-hidden="true">
                        @staffInitial
                    </div>
                </div>
            </header>

            <main class="staff-page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
        (() => {
            const body = document.body;
            const menuButton =
                document.getElementById("staff-mobile-menu");
            const backdrop =
                document.getElementById("staff-sidebar-backdrop");
            const sidebar =
                document.getElementById("staff-sidebar");

            const setSidebarOpen = (isOpen) => {
                body.classList.toggle(
                    "staff-sidebar-open",
                    isOpen);

                menuButton?.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false");
            };

            menuButton?.addEventListener("click", () => {
                setSidebarOpen(
                    !body.classList.contains(
                        "staff-sidebar-open"));
            });

            backdrop?.addEventListener("click", () => {
                setSidebarOpen(false);
            });

            sidebar?.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", () => {
                    if (window.innerWidth <= 900) {
                        setSidebarOpen(false);
                    }
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    setSidebarOpen(false);
                }
            });

            window.addEventListener("resize", () => {
                if (window.innerWidth > 900) {
                    setSidebarOpen(false);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>