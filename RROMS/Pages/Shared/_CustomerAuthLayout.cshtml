<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dineflow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background:
                linear-gradient(
                    135deg,
                    #fff7ed 0%,
                    #f6f7f9 50%,
                    #eef2ff 100%
                );
            font-family: Arial, Helvetica, sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns:
                minmax(320px, 0.9fr)
                minmax(480px, 1.1fr);
        }

        .auth-brand-panel {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 64px;
            background: #1f2937;
            color: white;
        }

        .auth-logo {
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 24px;
        }

        .auth-logo span {
            color: #f59e0b;
        }

        .auth-brand-panel h1 {
            max-width: 500px;
            margin-bottom: 18px;
            font-size: 40px;
            line-height: 1.15;
            font-weight: 750;
        }

        .auth-brand-panel p {
            max-width: 520px;
            margin-bottom: 0;
            color: #d1d5db;
            font-size: 17px;
            line-height: 1.7;
        }

        .auth-content-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
        }

        .auth-content-wrapper {
            width: 100%;
            max-width: 540px;
        }

        .auth-content-wrapper .container {
            max-width: none !important;
            margin-top: 0 !important;
            padding: 0 !important;
        }

        .auth-content-wrapper .card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(31, 41, 55, 0.12) !important;
        }

        .auth-content-wrapper .card-body {
            padding: 38px;
        }

        .auth-content-wrapper .btn-warning {
            border-color: #f59e0b;
            background: #f59e0b;
            color: #111827;
            font-weight: 700;
        }

        .auth-content-wrapper .btn-warning:hover {
            border-color: #d97706;
            background: #d97706;
            color: white;
        }

        .auth-content-wrapper a {
            color: #b45309;
            font-weight: 600;
        }

        .text-danger ul,
        .alert-danger ul {
            padding-left: 0;
            margin-bottom: 0;
            list-style: none;
        }

        @@media (max-width: 900px) {
            .auth-shell {
                grid-template-columns: 1fr;
            }

            .auth-brand-panel {
                padding: 36px 48px;
            }

            .auth-brand-panel h1 {
                margin-bottom: 10px;
                font-size: 28px;
            }

            .auth-brand-panel p {
                font-size: 15px;
            }

            .auth-content-panel {
                padding: 40px 24px;
            }
        }
    </style>
</head>

<body>
    <main class="auth-shell">
        <section class="auth-brand-panel"
                 aria-label="Dineflow introduction">
            <div class="auth-logo">
                Dine<span>flow</span>
            </div>

            <h1>
                Reservations and dining made simple.
            </h1>

            <p>
                Book your table, order ahead, complete payment,
                track your dining progress, and keep every receipt
                in one secure customer portal.
            </p>
        </section>

        <section class="auth-content-panel">
            <div class="auth-content-wrapper">
                @RenderBody()
            </div>
        </section>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>