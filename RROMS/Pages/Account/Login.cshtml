@page
@model RROMS.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Administrator Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Administrator Login - Dineflow</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background:
                linear-gradient(
                    135deg,
                    #0f172a 0%,
                    #1e293b 60%,
                    #78350f 100%);
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 40px 36px;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
        }

        .brand-label {
            margin-bottom: 6px;
            color: #f59e0b;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 8px;
            color: #0f172a;
            font-size: 28px;
        }

        .subtitle {
            margin: 0 0 26px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.5;
        }

        label {
            display: block;
            margin-bottom: 6px;
            color: #334155;
            font-size: 13px;
            font-weight: 700;
        }

        input {
            width: 100%;
            margin-bottom: 6px;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

        input:focus {
            border-color: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.16);
        }

        .field-error {
            display: block;
            min-height: 18px;
            margin-bottom: 10px;
            color: #dc2626;
            font-size: 12px;
        }

        .error {
            margin-bottom: 18px;
            padding: 11px 12px;
            border-radius: 8px;
            background: #fee2e2;
            color: #991b1b;
            font-size: 13px;
        }

        button {
            width: 100%;
            margin-top: 6px;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #f59e0b;
            color: #ffffff;
            cursor: pointer;
            font-size: 15px;
            font-weight: 800;
        }

        button:hover {
            background: #d97706;
        }

        .portal-note {
            margin-top: 18px;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.5;
            text-align: center;
        }
    </style>
</head>

<body>
    <main class="login-card">
        <div class="brand-label">Dineflow</div>

        <h1>Administrator Login</h1>

        <p class="subtitle">
            Sign in with an authorised Administrator account.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <input asp-for="ReturnUrl"
                   type="hidden" />

            <label asp-for="Input.Email">
                Email
            </label>

            <input asp-for="Input.Email"
                   type="email"
                   autocomplete="username"
                   placeholder="admin@example.com" />

            <span asp-validation-for="Input.Email"
                  class="field-error">
            </span>

            <label asp-for="Input.Password">
                Password
            </label>

            <input asp-for="Input.Password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Enter Administrator password" />

            <span asp-validation-for="Input.Password"
                  class="field-error">
            </span>

            <button type="submit">
                Sign in
            </button>
        </form>

        <div class="portal-note">
            This page is restricted to authorised RROMS
            Administrators.
        </div>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>