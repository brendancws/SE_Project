@page
@model RROMS.Pages.Admin.Reservations.IndexModel
@{
    ViewData["Title"] = "Reservations Monitor";
    Layout = "_AdminLayout";
}

<style>
    .reservation-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .reservation-summary-card {
        margin-bottom: 0;
        padding: 16px 20px;
    }

    .reservation-summary-label {
        color: #64748b;
        font-size: 13px;
    }

    .reservation-summary-value {
        color: #0f172a;
        font-size: 24px;
        font-weight: 700;
    }

    .reservation-summary-value.warning {
        color: #f59e0b;
    }

    .reservation-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .reservation-search-form {
        display: flex;
        align-items: end;
        gap: 8px;
        width: min(100%, 490px);
    }

    .reservation-search-field {
        flex: 1;
    }

    .reservation-search-field label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .reservation-search-field input {
        width: 100%;
        padding: 9px 11px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        color: #0f172a;
        font: inherit;
        font-size: 13px;
        outline: none;
    }

    .reservation-search-field input:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .reservation-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 37px;
        padding: 8px 14px;
        border: 0;
        border-radius: 8px;
        background: #f59e0b;
        color: #ffffff;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .reservation-button:hover {
        background: #d97706;
    }

    .reservation-button.secondary {
        background: #e2e8f0;
        color: #334155;
    }

    .reservation-button.secondary:hover {
        background: #cbd5e1;
    }

    .reservation-result-count {
        color: #64748b;
        font-size: 13px;
        white-space: nowrap;
    }

    .reservation-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
    }

    .reservation-filter {
        padding: 8px 14px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .reservation-filter:hover {
        background: #e2e8f0;
    }

    .reservation-filter.active {
        background: #f59e0b;
        color: #ffffff;
    }

    .reservation-table-wrapper {
        overflow-x: auto;
    }

    .reservation-table {
        width: 100%;
        min-width: 820px;
        border-collapse: collapse;
    }

    .reservation-table th {
        padding: 10px 8px;
        border-bottom: 2px solid #e2e8f0;
        color: #475569;
        font-size: 13px;
        text-align: left;
    }

    .reservation-table td {
        padding: 12px 8px;
        border-bottom: 1px solid #f1f5f9;
    }

    .reservation-table tbody tr:hover {
        background: #f8fafc;
    }

    .reservation-empty {
        padding: 28px 12px;
        color: #64748b;
        text-align: center;
    }

    .reservation-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }

    .reservation-page-status {
        color: #64748b;
        font-size: 13px;
    }

    .reservation-page-links {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .reservation-page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 8px 13px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .reservation-page-link:hover {
        background: #e2e8f0;
    }

    .reservation-page-link.disabled {
        color: #94a3b8;
        cursor: not-allowed;
        opacity: 0.65;
    }

    @@media (max-width: 850px) {
        .reservation-toolbar,
        .reservation-pagination {
            align-items: stretch;
            flex-direction: column;
        }

        .reservation-search-form {
            width: 100%;
        }

        .reservation-result-count {
            white-space: normal;
        }
    }

    @@media (max-width: 600px) {
        .reservation-summary {
            grid-template-columns: 1fr;
        }

        .reservation-search-form {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<h1>Reservations</h1>
<p class="subtitle">
    Monitor all reservations across the restaurant.
</p>

<div class="reservation-summary">
    <div class="card reservation-summary-card">
        <div class="reservation-summary-label">
            Today's Reservations
        </div>

        <div class="reservation-summary-value">
            @Model.TodayCount
        </div>
    </div>

    <div class="card reservation-summary-card">
        <div class="reservation-summary-label">
            Pending
        </div>

        <div class="reservation-summary-value warning">
            @Model.PendingCount
        </div>
    </div>
</div>

<div class="card">
    <div class="reservation-toolbar">
        <form method="get" class="reservation-search-form">
            <input type="hidden"
                   name="filter"
                   value="@Model.Filter" />

            <div class="reservation-search-field">
                <label for="reservation-search">
                    Search by customer or phone
                </label>

                <input id="reservation-search"
                       type="search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Enter customer name or phone"
                       autocomplete="off" />
            </div>

            <button type="submit" class="reservation-button">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="./Index"
                   asp-route-filter="@Model.Filter"
                   class="reservation-button secondary">
                    Clear
                </a>
            }
        </form>

        <div class="reservation-result-count">
            @if (Model.TotalResults == 0)
            {
                <span>No matching reservations</span>
            }
            else
            {
                <span>
                    Showing @Model.FirstResultNumber–@Model.LastResultNumber
                    of @Model.TotalResults
                </span>
            }
        </div>
    </div>

    <nav class="reservation-filters"
         aria-label="Reservation filters">
        <a asp-page="./Index"
           asp-route-filter="all"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "all" ? "active" : "")">
            All
        </a>

        <a asp-page="./Index"
           asp-route-filter="today"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "today" ? "active" : "")">
            Today
        </a>

        <a asp-page="./Index"
           asp-route-filter="upcoming"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "upcoming" ? "active" : "")">
            Upcoming
        </a>

        <a asp-page="./Index"
           asp-route-filter="pending"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "pending" ? "active" : "")">
            Pending
        </a>

        <a asp-page="./Index"
           asp-route-filter="confirmed"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "confirmed" ? "active" : "")">
            Confirmed
        </a>

        <a asp-page="./Index"
           asp-route-filter="completed"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "completed" ? "active" : "")">
            Completed
        </a>

        <a asp-page="./Index"
           asp-route-filter="cancelled"
           asp-route-search="@Model.Search"
           class="reservation-filter @(Model.Filter == "cancelled" ? "active" : "")">
            Cancelled
        </a>
    </nav>

    @if (Model.Reservations.Count == 0)
    {
        <div class="reservation-empty">
            No reservations match the selected filters.
        </div>
    }
    else
    {
        <div class="reservation-table-wrapper">
            <table class="reservation-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Party</th>
                        <th>Table</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Reservations)
                    {
                        <tr>
                            <td style="font-weight:600;">
                                @reservation.ReservationDate.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>
                                @reservation.CustomerName
                            </td>

                            <td style="color:#475569;">
                                @(string.IsNullOrWhiteSpace(reservation.CustomerPhone)
                                    ? "Not provided"
                                    : reservation.CustomerPhone)
                            </td>

                            <td>
                                @reservation.PartySize
                            </td>

                            <td style="color:#475569;">
                                @(reservation.Table?.TableNumber ?? "—")
                            </td>

                            <td>
                                @{
                                    var badge = reservation.Status switch
                                    {
                                        "Confirmed" => "background:#dcfce7; color:#166534;",
                                        "Cancelled" => "background:#fee2e2; color:#991b1b;",
                                        "Completed" => "background:#e0e7ff; color:#3730a3;",
                                        _ => "background:#fef3c7; color:#92400e;"
                                    };
                                }

                                <span style="@badge padding:3px 10px; border-radius:20px; font-size:12px;">
                                    @reservation.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalResults > 0)
    {
        <div class="reservation-pagination">
            <div class="reservation-page-status">
                Page @Model.PageNumber of @Model.TotalPages
            </div>

            <div class="reservation-page-links">
                @if (Model.HasPreviousPage)
                {
                    <a asp-page="./Index"
                       asp-route-filter="@Model.Filter"
                       asp-route-search="@Model.Search"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       class="reservation-page-link">
                        ← Previous
                    </a>
                }
                else
                {
                    <span class="reservation-page-link disabled"
                          aria-disabled="true">
                        ← Previous
                    </span>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-page="./Index"
                       asp-route-filter="@Model.Filter"
                       asp-route-search="@Model.Search"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       class="reservation-page-link">
                        Next →
                    </a>
                }
                else
                {
                    <span class="reservation-page-link disabled"
                          aria-disabled="true">
                        Next →
                    </span>
                }
            </div>
        </div>
    }
</div>