@page
@model RROMS.Pages.Admin.Reports.ReservationsModel

@{
    ViewData["Title"] = "Reservations Report";
    Layout = "_AdminLayout";
}

<link rel="stylesheet"
      href="~/css/admin-reports-print.css"
      asp-append-version="true" />

<div class="screen-only">
    <h1>Reservations Report</h1>

    <p class="subtitle">
        Filter and analyse reservation data.
    </p>
</div>

<header class="print-only print-report-header">
    <div class="print-report-brand">
        RROMS · Restaurant Reservation and Ordering Management System
    </div>

    <h1 class="print-report-title">
        Reservations Report
    </h1>

    <p class="print-report-description">
        Reservation activity and guest summary for the selected reporting period.
    </p>
</header>

<section class="print-only print-report-meta">
    <div>
        <span class="print-meta-label">
            Reporting Period
        </span>

        <span class="print-meta-value">
            @(Model.From?.ToString("dd MMM yyyy")
                ?? "Not specified")
            to
            @(Model.To?.ToString("dd MMM yyyy")
                ?? "Not specified")
        </span>
    </div>

    <div>
        <span class="print-meta-label">
            Status Filter
        </span>

        <span class="print-meta-value">
            @(string.Equals(
                Model.Status,
                "all",
                StringComparison.OrdinalIgnoreCase)
                ? "All statuses"
                : Model.Status)
        </span>
    </div>

    <div>
        <span class="print-meta-label">
            Generated
        </span>

        <span class="print-meta-value">
            @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
        </span>
    </div>
</section>

<div class="card screen-only">
    <form method="get"
          style="display:flex; gap:16px; align-items:flex-end; flex-wrap:wrap;">

        <div>
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">
                From Date
            </label>

            <input type="date"
                   name="From"
                   value="@Model.From?.ToString("yyyy-MM-dd")"
                   style="padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
        </div>

        <div>
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">
                To Date
            </label>

            <input type="date"
                   name="To"
                   value="@Model.To?.ToString("yyyy-MM-dd")"
                   style="padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
        </div>

        <div>
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">
                Status
            </label>

            <select name="Status"
                    style="padding:10px; border:1px solid #cbd5e1; border-radius:8px;">

                <option value="all"
                        selected="@(Model.Status == "all")">
                    All
                </option>

                <option value="Pending"
                        selected="@(Model.Status == "Pending")">
                    Pending
                </option>

                <option value="Confirmed"
                        selected="@(Model.Status == "Confirmed")">
                    Confirmed
                </option>

                <option value="Completed"
                        selected="@(Model.Status == "Completed")">
                    Completed
                </option>

                <option value="Cancelled"
                        selected="@(Model.Status == "Cancelled")">
                    Cancelled
                </option>
            </select>
        </div>

        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <button type="submit"
                    style="background:#f59e0b; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                Apply Filters
            </button>

            <a asp-page="/Admin/Reports/Reservations"
               style="color:#64748b; text-decoration:none;">
                Reset
            </a>

            <a asp-page="/Admin/Reports/Reservations"
               asp-page-handler="Export"
               asp-route-From="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
               asp-route-Status="@Model.Status"
               style="background:#166534; color:#fff; padding:10px 20px; border-radius:8px; font-weight:600; text-decoration:none; display:inline-block;">
                Export CSV
            </a>

            <button type="button"
                    onclick="window.print()"
                    style="background:#64748b; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                Print
            </button>
        </div>
    </form>
</div>

<div class="report-summary-grid reservations-summary-grid">
    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Total
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#0f172a;">
            @Model.TotalCount
        </div>
    </div>

    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Total Guests
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#0f172a;">
            @Model.TotalGuests
        </div>
    </div>

    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Pending
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#92400e;">
            @Model.PendingCount
        </div>
    </div>

    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Confirmed
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#166534;">
            @Model.ConfirmedCount
        </div>
    </div>

    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Completed
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#3730a3;">
            @Model.CompletedCount
        </div>
    </div>

    <div class="report-summary-card">
        <div class="report-summary-label"
             style="font-size:12px; color:#64748b;">
            Cancelled
        </div>

        <div class="report-summary-value"
             style="font-size:22px; font-weight:700; color:#991b1b;">
            @Model.CancelledCount
        </div>
    </div>
</div>

<div class="card report-results">
    <div class="report-results-summary"
         style="margin-bottom:12px; color:#64748b; font-size:13px;">
        Showing @Model.Results.Count result(s) from
        @(Model.From?.ToString("dd MMM yyyy") ?? "Not specified")
        to
        @(Model.To?.ToString("dd MMM yyyy") ?? "Not specified")
    </div>

    @if (Model.Results.Count == 0)
    {
        <p style="color:#64748b;">
            No reservations match the selected filters.
        </p>
    }
    else
    {
        <div class="report-table-wrapper">
            <table class="report-table reservations-report-table">
                <thead>
                    <tr style="text-align:left; border-bottom:2px solid #e2e8f0; color:#475569; font-size:13px;">
                        <th style="padding:10px 8px;">
                            Date
                        </th>

                        <th style="padding:10px 8px;">
                            Customer
                        </th>

                        <th style="padding:10px 8px;">
                            Phone
                        </th>

                        <th style="padding:10px 8px;">
                            Party
                        </th>

                        <th style="padding:10px 8px;">
                            Table
                        </th>

                        <th style="padding:10px 8px;">
                            Status
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.Results)
                    {
                        var badge = reservation.Status switch
                        {
                            "Confirmed" =>
                                "background:#dcfce7; color:#166534;",

                            "Cancelled" =>
                                "background:#fee2e2; color:#991b1b;",

                            "Completed" =>
                                "background:#e0e7ff; color:#3730a3;",

                            _ =>
                                "background:#fef3c7; color:#92400e;"
                        };

                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td class="date-column"
                                style="padding:10px 8px;">
                                @reservation.ReservationDate.ToString(
                                    "yyyy-MM-dd HH:mm")
                            </td>

                            <td style="padding:10px 8px;">
                                @reservation.CustomerName
                            </td>

                            <td style="padding:10px 8px; color:#475569;">
                                @(string.IsNullOrWhiteSpace(
                                    reservation.CustomerPhone)
                                    ? "Not provided"
                                    : reservation.CustomerPhone)
                            </td>

                            <td style="padding:10px 8px;">
                                @reservation.PartySize
                            </td>

                            <td style="padding:10px 8px;">
                                @(reservation.Table?.TableNumber ?? "—")
                            </td>

                            <td style="padding:10px 8px;">
                                <span class="report-status"
                                      style="@badge padding:3px 10px; border-radius:20px; font-size:12px;">
                                    @reservation.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<footer class="print-only print-report-footer">
    RROMS Reservations Report ·
    @Model.TotalCount reservation(s) ·
    @Model.TotalGuests guest(s) included ·
    Generated by the Dineflow Administrator portal
</footer>