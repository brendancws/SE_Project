@page
@model RROMS.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<h1>Admin Dashboard</h1>
<p class="subtitle">Overview of your restaurant operations.</p>

<div class="card">
    <p>Welcome, <strong>@User.Identity?.Name</strong></p>
    <p>You are signed in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></p>
</div>