@page
@model RROMS.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<h1>Admin Dashboard</h1>
<p class="subtitle">Overview of restaurant operations.</p>

<!-- Summary cards -->
<div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:16px; margin-bottom:24px;">
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Today's Reservations</div>
        <div style="font-size:28px; font-weight:700; color:#0f172a;">@Model.TodayReservations</div>
        <div style="font-size:12px; color:#94a3b8; margin-top:4px;">Total: @Model.TotalReservations</div>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Pending Orders</div>
        <div style="font-size:28px; font-weight:700; color:#f59e0b;">@Model.PendingOrders</div>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Total Revenue (Served)</div>
        <div style="font-size:28px; font-weight:700; color:#166534;">RM @Model.TotalRevenue.ToString("F2")</div>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Menu Items</div>
        <div style="font-size:28px; font-weight:700; color:#0f172a;">@Model.TotalMenuItems</div>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Staff</div>
        <div style="font-size:28px; font-weight:700; color:#0f172a;">@Model.TotalStaff</div>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:13px; color:#64748b;">Customers</div>
        <div style="font-size:28px; font-weight:700; color:#0f172a;">@Model.TotalCustomers</div>
    </div>
</div>

<!-- Charts row 1 -->
<div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:20px;">
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:16px;">Reservations — Last 14 Days</div>
        <canvas id="reservationsChart" height="90"></canvas>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:16px;">Orders by Status</div>
        <canvas id="orderStatusChart" height="180"></canvas>
    </div>
</div>

<!-- Charts row 2 -->
<div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px;">
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:16px;">Revenue — Last 7 Days (RM)</div>
        <canvas id="revenueChart" height="90"></canvas>
    </div>
    <div class="card" style="margin-bottom:0;">
        <div style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:16px;">Items per Category</div>
        <canvas id="categoriesChart" height="180"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ----- Reservations Line Chart -----
        new Chart(document.getElementById('reservationsChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.ReservationDatesJson),
                datasets: [{
                    label: 'Reservations',
                    data: @Html.Raw(Model.ReservationCountsJson),
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245, 158, 11, 0.15)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#f59e0b'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        // ----- Orders Doughnut Chart -----
        new Chart(document.getElementById('orderStatusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Model.OrderStatusLabelsJson),
                datasets: [{
                    data: @Html.Raw(Model.OrderStatusCountsJson),
                    backgroundColor: ['#f59e0b', '#3b82f6', '#22c55e', '#ef4444', '#8b5cf6', '#64748b'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { font: { size: 12 } } } }
            }
        });

        // ----- Revenue Bar Chart -----
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.RevenueDatesJson),
                datasets: [{
                    label: 'Revenue (RM)',
                    data: @Html.Raw(Model.RevenueAmountsJson),
                    backgroundColor: '#22c55e',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // ----- Categories Horizontal Bar -----
        new Chart(document.getElementById('categoriesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.CategoryLabelsJson),
                datasets: [{
                    label: 'Items',
                    data: @Html.Raw(Model.CategoryCountsJson),
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}