@page
@model RROMS.Pages.Admin.DashboardModel

@{
    ViewData["Title"] = "Restaurant Operations";
    Layout = "_AdminLayout";

    string ReservationBadge(string? status)
    {
        return status switch
        {
            "Confirmed" => "dashboard-status confirmed",
            "Completed" => "dashboard-status completed",
            "Cancelled" => "dashboard-status cancelled",
            _ => "dashboard-status pending"
        };
    }

    string OrderBadge(string? status)
    {
        return status switch
        {
            "Preparing" => "dashboard-status preparing",
            "Ready to Serve" => "dashboard-status ready",
            "Served" => "dashboard-status completed",
            "Cancelled" => "dashboard-status cancelled",
            _ => "dashboard-status pending"
        };
    }
}

@section Styles {
    <style>
        .dashboard-page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 24px;
        }

        .dashboard-page-header h1 {
    margin: 0 0 5px;
}

        .dashboard-page-header .subtitle {
            max-width: 720px;
            margin-bottom: 0;
        }

           .dashboard-page-date {
            min-width: 210px;
            padding: 11px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 11px;
            background: #ffffff;
            box-shadow: var(--admin-shadow-sm);
            color: #0f172a;
            font-size: 12px;
            text-align: right;
        }

        .dashboard-page-date-label {
            display: block;
            margin-bottom: 2px;
            color: #94a3b8;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .dashboard-section-heading {
            margin: 24px 0 12px;
        }

        .dashboard-section-kicker {
            color: #d97706;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        .dashboard-section-title {
            margin-top: 3px;
            color: #0f172a;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.015em;
        }

        /* Operational cards */

        .operations-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .operations-card {
            display: flex;
            min-width: 0;
            min-height: 136px;
            flex-direction: column;
            justify-content: space-between;
            margin: 0;
            padding: 18px;
            color: inherit;
            text-decoration: none;
            transition:
                transform 0.16s ease,
                border-color 0.16s ease,
                box-shadow 0.16s ease;
        }

        .operations-card:hover {
            transform: translateY(-3px);
            border-color: rgba(245, 158, 11, 0.42);
            box-shadow: 0 13px 26px rgba(15, 23, 42, 0.10);
        }

        .operations-card:focus-visible {
            outline: none;
            box-shadow: var(--admin-focus);
        }

        .operations-card.attention {
            border-color: #fde68a;
            background:
                linear-gradient(
                    145deg,
                    #ffffff 0%,
                    #fffaf0 100%
                );
        }

        .operations-card.revenue {
            border-color: #bbf7d0;
            background:
                linear-gradient(
                    145deg,
                    #ffffff 0%,
                    #f0fdf4 100%
                );
        }

        .operations-card.tables {
            border-color: #bae6fd;
            background:
                linear-gradient(
                    145deg,
                    #ffffff 0%,
                    #f0f9ff 100%
                );
        }

        .operations-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .operations-card-label {
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .operations-card-value {
            margin-top: 10px;
            color: #0f172a;
            font-size: 27px;
            font-weight: 850;
            letter-spacing: -0.035em;
            line-height: 1;
        }

        .operations-card.attention .operations-card-value {
            color: #b45309;
        }

        .operations-card.revenue .operations-card-value {
            color: #166534;
        }

        .operations-card.tables .operations-card-value {
            color: #075985;
        }

        .operations-icon {
            display: grid;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            place-items: center;
            border-radius: 11px;
            background: #fff7ed;
            color: #d97706;
        }

        .operations-icon svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
        }

        .operations-card.attention .operations-icon {
            background: #fef3c7;
            color: #b45309;
        }

        .operations-card.revenue .operations-icon {
            background: #dcfce7;
            color: #15803d;
        }

        .operations-card.tables .operations-icon {
            background: #e0f2fe;
            color: #0369a1;
        }

        .operations-card-detail {
            display: flex;
            flex-wrap: wrap;
            gap: 5px 10px;
            margin-top: 9px;
            color: #64748b;
            font-size: 11px;
        }

        .operations-card-link {
            margin-top: 13px;
            color: #475569;
            font-size: 11px;
            font-weight: 800;
        }

        /* Live operations */

        .live-grid {
    display: grid;
    grid-template-columns:
        minmax(320px, 0.8fr)
        minmax(520px, 1.2fr);
    align-items: start;
    gap: 18px;
}

        .dashboard-panel {
            min-width: 0;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .dashboard-panel-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            padding: 17px 20px 14px;
            border-bottom: 1px solid #e2e8f0;
        }

        .dashboard-panel-title {
            color: #0f172a;
            font-size: 15px;
            font-weight: 800;
        }

        .dashboard-panel-subtitle {
            margin-top: 3px;
            color: #64748b;
            font-size: 11px;
        }

        .dashboard-panel-link {
            flex-shrink: 0;
            color: #d97706;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
        }

        .dashboard-panel-link:hover {
            color: #b45309;
            text-decoration: underline;
        }

        .schedule-list,
        .queue-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .schedule-row,
        .queue-row {
            display: grid;
            align-items: center;
            gap: 13px;
            padding: 13px 20px;
            border-bottom: 1px solid #edf2f7;
        }

        .schedule-row {
            grid-template-columns: 67px minmax(0, 1fr) auto auto;
        }

        .queue-row {
            grid-template-columns: 58px minmax(0, 1fr) auto auto;
        }

        .schedule-row:last-child,
        .queue-row:last-child {
            border-bottom: 0;
        }

        .schedule-row:hover,
        .queue-row:hover {
            background: #f8fafc;
        }

        .schedule-time {
            color: #0f172a;
            font-size: 13px;
            font-weight: 850;
        }

        .schedule-customer,
        .queue-customer {
            min-width: 0;
        }

        .schedule-customer-name,
        .queue-customer-name {
            overflow: hidden;
            color: #0f172a;
            font-size: 12px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .schedule-meta,
        .queue-meta {
            margin-top: 3px;
            color: #64748b;
            font-size: 10px;
        }

        .schedule-table {
            color: #475569;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .queue-order-number {
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
        }

        .queue-amount {
            color: #0f172a;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .dashboard-status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 24px;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 0.025em;
            white-space: nowrap;
        }

        .dashboard-status.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .dashboard-status.confirmed,
        .dashboard-status.ready {
            background: #dcfce7;
            color: #166534;
        }

        .dashboard-status.preparing {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .dashboard-status.completed {
            background: #e0e7ff;
            color: #3730a3;
        }

        .dashboard-status.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        .dashboard-empty {
            display: grid;
            min-height: 150px;
            place-items: center;
            padding: 24px 20px;
            text-align: center;
        }

        .dashboard-empty-icon {
            display: grid;
            width: 46px;
            height: 46px;
            margin: 0 auto 10px;
            place-items: center;
            border-radius: 14px;
            background: #f1f5f9;
            color: #64748b;
        }

        .dashboard-empty-icon svg {
            width: 22px;
            height: 22px;
            stroke: currentColor;
        }

        .dashboard-empty-title {
            color: #334155;
            font-size: 13px;
            font-weight: 800;
        }

        .dashboard-empty-copy {
            margin-top: 4px;
            color: #94a3b8;
            font-size: 11px;
        }

        /* Analytics */

        .analytics-grid {
            display: grid;
            grid-template-columns:
                minmax(0, 1.65fr)
                minmax(300px, 0.85fr);
            gap: 18px;
            margin-bottom: 18px;
        }

        .analytics-grid:last-child {
            margin-bottom: 0;
        }

        .analytics-card {
            min-width: 0;
            margin: 0;
            padding: 19px;
        }

        .analytics-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 14px;
        }

        .analytics-title {
            color: #0f172a;
            font-size: 14px;
            font-weight: 800;
        }

        .analytics-subtitle {
            margin-top: 3px;
            color: #94a3b8;
            font-size: 10px;
        }

        .analytics-badge {
            padding: 5px 8px;
            border-radius: 999px;
            background: #f1f5f9;
            color: #64748b;
            font-size: 9px;
            font-weight: 800;
            white-space: nowrap;
        }

        .analytics-chart,
        .analytics-chart.compact {
            position: relative;
            height: 215px;
        }

        /* Responsive behavior */

        @@media (max-width: 1250px) {
            .operations-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .live-grid,
            .analytics-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 750px) {
            .dashboard-page-header {
                flex-direction: column;
            }

            .dashboard-page-date {
                width: 100%;
                text-align: left;
            }

            .operations-grid {
                grid-template-columns: 1fr;
            }

            .schedule-row {
                grid-template-columns: 60px minmax(0, 1fr) auto;
            }

            .schedule-row .dashboard-status {
                display: none;
            }

            .queue-row {
                grid-template-columns: 52px minmax(0, 1fr) auto;
            }

            .queue-row .queue-amount {
                display: none;
            }

            .analytics-chart,
            .analytics-chart.compact {
                height: 200px;
            }
        }

        @@media (max-width: 450px) {
            .schedule-row {
                grid-template-columns: 55px minmax(0, 1fr);
            }

            .schedule-table {
                display: none;
            }

            .queue-row {
                grid-template-columns: 48px minmax(0, 1fr);
            }

            .queue-row .dashboard-status {
                grid-column: 2;
                justify-self: start;
            }
        }
    </style>
}

<header class="dashboard-page-header">
    <div>

        <h1>Operations Dashboard</h1>

        <p class="subtitle">
            Monitor today's reservations, active orders,
            served revenue, and table readiness.
        </p>
    </div>

    <div class="dashboard-page-date">
        <span class="dashboard-page-date-label">
            Service date
        </span>

        <strong>
            @DateTime.Today.ToString("dddd, dd MMM yyyy")
        </strong>
    </div>
</header>

<div class="dashboard-section-heading">
    <div class="dashboard-section-kicker">
        Today at a glance
    </div>

    <div class="dashboard-section-title">
        Operational workload
    </div>
</div>

<section class="operations-grid"
         aria-label="Today's operational overview">
    <a href="/Admin/Reservations"
       class="card operations-card">
        <div>
            <div class="operations-card-top">
                <div>
                    <div class="operations-card-label">
                        Today's reservations
                    </div>

                    <div class="operations-card-value">
                        @Model.TodayReservations
                    </div>
                </div>

                <div class="operations-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                        <path d="M8 14h3M8 17h5" />
                    </svg>
                </div>
            </div>

            <div class="operations-card-detail">
                <span>@Model.TodayGuests expected guests</span>
            </div>
        </div>

        <div class="operations-card-link">
            Open reservation schedule →
        </div>
    </a>

    <a href="/Admin/Orders"
       class="card operations-card attention">
        <div>
            <div class="operations-card-top">
                <div>
                    <div class="operations-card-label">
                        Active orders
                    </div>

                    <div class="operations-card-value">
                        @(Model.PendingOrders +
                          Model.PreparingOrders +
                          Model.ReadyOrders)
                    </div>
                </div>

                <div class="operations-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" />
                        <path d="M9 8h6M9 12h6M9 16h3" />
                    </svg>
                </div>
            </div>

            <div class="operations-card-detail">
                <span>@Model.PendingOrders pending</span>
                <span>@Model.PreparingOrders preparing</span>
                <span>@Model.ReadyOrders ready</span>
            </div>
        </div>

        <div class="operations-card-link">
            Review active orders →
        </div>
    </a>

    <a href="/Admin/Reports/Sales"
       class="card operations-card revenue">
        <div>
            <div class="operations-card-top">
                <div>
                    <div class="operations-card-label">
                        Today's served revenue
                    </div>

                    <div class="operations-card-value">
                        RM @Model.TodayRevenue.ToString("F2")
                    </div>
                </div>

                <div class="operations-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M4 19V9M10 19V5M16 19v-7M22 19H2" />
                        <path d="m4 7 6-4 6 6 6-5" />
                    </svg>
                </div>
            </div>

            <div class="operations-card-detail">
                <span>
                    RM @Model.TotalRevenue.ToString("F2")
                    all-time served
                </span>
            </div>
        </div>

        <div class="operations-card-link">
            Open sales analytics →
        </div>
    </a>

    <a href="/Admin/Tables"
       class="card operations-card tables">
        <div>
            <div class="operations-card-top">
                <div>
                    <div class="operations-card-label">
                        Table readiness
                    </div>

                    <div class="operations-card-value">
                        @Model.AvailableTables/@Model.TotalTables
                    </div>
                </div>

                <div class="operations-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M4 8h16M7 8v12M17 8v12M3 5h18v3H3z" />
                        <path d="M5 20h4M15 20h4" />
                    </svg>
                </div>
            </div>

            <div class="operations-card-detail">
                <span>@Model.AvailableTables available</span>
                <span>
                    @(Model.TotalTables - Model.AvailableTables)
                    unavailable
                </span>
            </div>
        </div>

        <div class="operations-card-link">
            Manage restaurant tables →
        </div>
    </a>
</section>

<div class="dashboard-section-heading">
    <div class="dashboard-section-kicker">
        Live service
    </div>

    <div class="dashboard-section-title">
        Current activity
    </div>
</div>

<section class="live-grid">
    <article class="card dashboard-panel">
        <header class="dashboard-panel-header">
            <div>
                <div class="dashboard-panel-title">
                    Today's upcoming reservations
                </div>

                <div class="dashboard-panel-subtitle">
                    Next five bookings scheduled for today
                </div>
            </div>

            <a href="/Admin/Reservations"
               class="dashboard-panel-link">
                View all →
            </a>
        </header>

        @if (Model.UpcomingReservations.Count == 0)
        {
            <div class="dashboard-empty">
                <div>
                    <div class="dashboard-empty-icon"
                         aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 10h18" />
                            <path d="m9 16 2 2 4-4" />
                        </svg>
                    </div>

                    <div class="dashboard-empty-title">
                        No upcoming reservations today
                    </div>

                    <div class="dashboard-empty-copy">
                        Later bookings will appear here.
                    </div>
                </div>
            </div>
        }
        else
        {
            <ul class="schedule-list">
                @foreach (var reservation in Model.UpcomingReservations)
                {
                    <li class="schedule-row">
                        <div class="schedule-time">
                            @DateTime.Today
                                .Add(reservation.Time)
                                .ToString("h:mm tt")
                        </div>

                        <div class="schedule-customer">
                            <div class="schedule-customer-name">
                                @reservation.CustomerName
                            </div>

                            <div class="schedule-meta">
                                @reservation.NumberOfGuests guest(s)
                            </div>
                        </div>

                        <div class="schedule-table">
                            Table @reservation.TableNumber
                        </div>

                        <span class="@ReservationBadge(reservation.Status)">
                            @reservation.Status
                        </span>
                    </li>
                }
            </ul>
        }
    </article>

    <article class="card dashboard-panel">
        <header class="dashboard-panel-header">
            <div>
                <div class="dashboard-panel-title">
                    Active order queue
                </div>

                <div class="dashboard-panel-subtitle">
                    Five oldest orders still in progress
                </div>
            </div>

            <a href="/Admin/Orders"
               class="dashboard-panel-link">
                View all →
            </a>
        </header>

        @if (Model.ActiveOrders.Count == 0)
        {
            <div class="dashboard-empty">
                <div>
                    <div class="dashboard-empty-icon"
                         aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z" />
                            <path d="m9 12 2 2 4-5" />
                        </svg>
                    </div>

                    <div class="dashboard-empty-title">
                        No active orders
                    </div>

                    <div class="dashboard-empty-copy">
                        New active orders will appear here.
                    </div>
                </div>
            </div>
        }
        else
        {
            <ul class="queue-list">
                @foreach (var order in Model.ActiveOrders)
                {
                    <li class="queue-row">
                        <div class="queue-order-number">
                            #@order.OrderID
                        </div>

                        <div class="queue-customer">
                            <div class="queue-customer-name">
                                @order.CustomerName
                            </div>

                            <div class="queue-meta">
                                @if (order.OrderDate.HasValue)
                                {
                                    @order.OrderDate.Value.ToString(
                                        "dd MMM, h:mm tt")
                                }
                                else
                                {
                                    <span>Time not recorded</span>
                                }
                            </div>
                        </div>

                        <div class="queue-amount">
                            RM @order.TotalAmount.ToString("F2")
                        </div>

                        <span class="@OrderBadge(order.Status)">
                            @order.Status
                        </span>
                    </li>
                }
            </ul>
        }
    </article>
</section>

<div class="dashboard-section-heading">
    <div class="dashboard-section-kicker">
        Analytics
    </div>

    <div class="dashboard-section-title">
        Restaurant performance
    </div>
</div>

<section class="analytics-grid">
    <article class="card analytics-card">
        <header class="analytics-card-header">
            <div>
                <div class="analytics-title">
                    Reservation activity
                </div>

                <div class="analytics-subtitle">
                    Daily reservations during the last 14 days
                </div>
            </div>

            <span class="analytics-badge">
                14 days
            </span>
        </header>

        <div class="analytics-chart">
            <canvas id="reservationsChart"></canvas>
        </div>
    </article>

    <article class="card analytics-card">
        <header class="analytics-card-header">
            <div>
                <div class="analytics-title">
                    Order status mix
                </div>

                <div class="analytics-subtitle">
                    Distribution across all recorded orders
                </div>
            </div>

            <span class="analytics-badge">
                All orders
            </span>
        </header>

        <div class="analytics-chart compact">
            <canvas id="orderStatusChart"></canvas>
        </div>
    </article>
</section>

<section class="analytics-grid">
    <article class="card analytics-card">
        <header class="analytics-card-header">
            <div>
                <div class="analytics-title">
                    Served revenue
                </div>

                <div class="analytics-subtitle">
                    Revenue recorded over the last seven days
                </div>
            </div>

            <span class="analytics-badge">
                RM
            </span>
        </header>

        <div class="analytics-chart">
            <canvas id="revenueChart"></canvas>
        </div>
    </article>

    <article class="card analytics-card">
        <header class="analytics-card-header">
            <div>
                <div class="analytics-title">
                    Menu composition
                </div>

                <div class="analytics-subtitle">
                    Number of items in each category
                </div>
            </div>

            <span class="analytics-badge">
                @Model.TotalMenuItems items
            </span>
        </header>

        <div class="analytics-chart compact">
            <canvas id="categoriesChart"></canvas>
        </div>
    </article>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js">
    </script>

    <script>
        const chartGridColor =
            "rgba(148, 163, 184, 0.20)";

        const chartTickColor =
            "#64748b";

        Chart.defaults.font.family =
            '"Segoe UI", Inter, system-ui, sans-serif';

        Chart.defaults.color =
            chartTickColor;

        new Chart(
            document.getElementById("reservationsChart"),
            {
                type: "line",

                data: {
                    labels:
                        @Html.Raw(Model.ReservationDatesJson),

                    datasets: [{
                        label: "Reservations",

                        data:
                            @Html.Raw(Model.ReservationCountsJson),

                        borderColor:
                            "#f59e0b",

                        backgroundColor:
                            "rgba(245, 158, 11, 0.12)",

                        pointBackgroundColor:
                            "#f59e0b",

                        pointBorderColor:
                            "#ffffff",

                        pointBorderWidth:
                            2,

                        pointRadius:
                            4,

                        pointHoverRadius:
                            6,

                        borderWidth:
                            2.5,

                        fill:
                            true,

                        tension:
                            0.34
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {
                        mode: "index",
                        intersect: false
                    },

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            backgroundColor: "#111827",
                            padding: 11,
                            cornerRadius: 8
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            border: {
                                display: false
                            }
                        },

                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0,
                                stepSize: 1
                            },

                            grid: {
                                color: chartGridColor
                            },

                            border: {
                                display: false
                            }
                        }
                    }
                }
            });

        new Chart(
            document.getElementById("orderStatusChart"),
            {
                type: "doughnut",

                data: {
                    labels:
                        @Html.Raw(Model.OrderStatusLabelsJson),

                    datasets: [{
                        data:
                            @Html.Raw(Model.OrderStatusCountsJson),

                        backgroundColor: [
                            "#f59e0b",
                            "#3b82f6",
                            "#22c55e",
                            "#ef4444",
                            "#8b5cf6",
                            "#64748b"
                        ],

                        borderColor:
                            "#ffffff",

                        borderWidth:
                            3,

                        hoverOffset:
                            7
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "66%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                boxWidth: 7,
                                boxHeight: 7,
                                padding: 14,

                                font: {
                                    size: 10,
                                    weight: "600"
                                }
                            }
                        },

                        tooltip: {
                            backgroundColor: "#111827",
                            padding: 11,
                            cornerRadius: 8
                        }
                    }
                }
            });

        new Chart(
            document.getElementById("revenueChart"),
            {
                type: "bar",

                data: {
                    labels:
                        @Html.Raw(Model.RevenueDatesJson),

                    datasets: [{
                        label: "Revenue (RM)",

                        data:
                            @Html.Raw(Model.RevenueAmountsJson),

                        backgroundColor:
                            "#16a34a",

                        hoverBackgroundColor:
                            "#15803d",

                        borderRadius:
                            7,

                        maxBarThickness:
                            42
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            backgroundColor: "#111827",
                            padding: 11,
                            cornerRadius: 8,

                            callbacks: {
                                label: (context) =>
                                    ` RM ${Number(
                                        context.raw
                                    ).toFixed(2)}`
                            }
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            border: {
                                display: false
                            }
                        },

                        y: {
                            beginAtZero: true,

                            grid: {
                                color: chartGridColor
                            },

                            border: {
                                display: false
                            },

                            ticks: {
                                callback: (value) =>
                                    `RM ${value}`
                            }
                        }
                    }
                }
            });

        new Chart(
            document.getElementById("categoriesChart"),
            {
                type: "bar",

                data: {
                    labels:
                        @Html.Raw(Model.CategoryLabelsJson),

                    datasets: [{
                        label: "Items",

                        data:
                            @Html.Raw(Model.CategoryCountsJson),

                        backgroundColor: [
                            "#f59e0b",
                            "#3b82f6",
                            "#8b5cf6",
                            "#14b8a6",
                            "#ef4444",
                            "#64748b"
                        ],

                        borderRadius:
                            7,

                        maxBarThickness:
                            30
                    }]
                },

                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            backgroundColor: "#111827",
                            padding: 11,
                            cornerRadius: 8
                        }
                    },

                    scales: {
                        x: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0,
                                stepSize: 1
                            },

                            grid: {
                                color: chartGridColor
                            },

                            border: {
                                display: false
                            }
                        },

                        y: {
                            grid: {
                                display: false
                            },

                            border: {
                                display: false
                            }
                        }
                    }
                }
            });
    </script>
}