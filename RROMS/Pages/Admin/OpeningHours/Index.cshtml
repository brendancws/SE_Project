@page
@model RROMS.Pages.Admin.OpeningHours.IndexModel

@{
    ViewData["Title"] = "Opening Hours";
    Layout = "_AdminLayout";
}

<header class="admin-page-header">
    <div>
        <h1>Opening Hours</h1>

        <p class="subtitle">
            Configure the restaurant's weekly service schedule.
        </p>
    </div>
</header>

<section class="card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Opening Time</th>
                    <th>Closing Time</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var hour in Model.Hours)
                {
                    <tr>
                        <td>
                            <strong>@hour.Day</strong>
                        </td>

                        <td>
                            @(hour.IsClosed
                                ? "—"
                                : DateTime.Today
                                    .Add(hour.OpenTime)
                                    .ToString("h:mm tt"))
                        </td>

                        <td>
                            @(hour.IsClosed
                                ? "—"
                                : DateTime.Today
                                    .Add(hour.CloseTime)
                                    .ToString("h:mm tt"))
                        </td>

                        <td>
                            @if (hour.IsClosed)
                            {
                                <span class="admin-badge admin-badge-danger">
                                    Closed
                                </span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-success">
                                    Open
                                </span>
                            }
                        </td>

                        <td>
                            <div class="admin-row-actions">
                                <a asp-page="./Edit"
                                   asp-route-id="@hour.Id"
                                   class="admin-action-button admin-action-button-edit">
                                    Edit
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>