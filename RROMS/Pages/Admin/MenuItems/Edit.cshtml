@page
@model RROMS.Pages.Admin.MenuItems.EditModel

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "_AdminLayout";
}

<h1>Edit Menu Item</h1>

<p class="subtitle">
    Update menu details, image, pricing, and availability.
</p>

<section class="card menu-form-card">
    <form method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="Item.MenuItemID" />

        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="menu-form-section">
            <div class="menu-form-section-title">
                Item details
            </div>

            <div class="menu-form-section-copy">
                Update the information displayed to customers.
            </div>

            <div class="admin-form-group">
                <label asp-for="Item.Name"
                       class="admin-label">
                    Name *
                </label>

                <input asp-for="Item.Name"
                       class="admin-input"
                       maxlength="150"
                       autocomplete="off" />

                <span asp-validation-for="Item.Name"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Item.Description"
                       class="admin-label">
                    Description
                </label>

                <textarea asp-for="Item.Description"
                          class="admin-textarea"
                          rows="4"
                          maxlength="1000"></textarea>

                <span asp-validation-for="Item.Description"
                      class="admin-validation">
                </span>
            </div>

            <div class="menu-form-grid">
                <div class="admin-form-group">
                    <label asp-for="Item.CategoryID"
                           class="admin-label">
                        Category *
                    </label>

                    <select asp-for="Item.CategoryID"
                            asp-items="Model.CategoryOptions"
                            class="admin-select">
                        <option value="">
                            Select a category
                        </option>
                    </select>

                    <span asp-validation-for="Item.CategoryID"
                          class="admin-validation">
                    </span>
                </div>

                <div class="admin-form-group">
                    <label asp-for="Item.Price"
                           class="admin-label">
                        Price (RM) *
                    </label>

                    <input asp-for="Item.Price"
                           class="admin-input menu-price-input"
                           type="number"
                           step="0.01"
                           min="0.01"
                           max="9999.99" />

                    <span asp-validation-for="Item.Price"
                          class="admin-validation">
                    </span>
                </div>
            </div>
        </div>

        <div class="menu-form-section">
            <div class="menu-form-section-title">
                Item image
            </div>

            <div class="menu-form-section-copy">
                Upload a replacement image. Leave the file field empty
                to keep the current photo.
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Item.ImageURL))
            {
                <div class="admin-form-group">
                    <label class="admin-label">
                        Current Photo
                    </label>

                    <img src="@Model.Item.ImageURL"
                         alt="@Model.Item.Name"
                         class="menu-current-image" />
                </div>
            }
            else
            {
                <div class="admin-alert admin-alert-warning">
                    This menu item does not currently have an image.
                </div>
            }

            <div class="admin-form-group">
                <label for="imageInput"
                       class="admin-label">
                    Replace Photo
                </label>

                <div class="menu-upload-box">
                    <input asp-for="ImageFile"
                           id="imageInput"
                           type="file"
                           accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" />

                    <div class="menu-upload-help">
                        JPG, JPEG, PNG, GIF, or WEBP. Maximum file size:
                        2 MB.
                    </div>

                    <img id="preview"
                         class="menu-image-preview"
                         src=""
                         alt="Replacement menu item preview" />
                </div>

                <span asp-validation-for="ImageFile"
                      class="admin-validation">
                </span>
            </div>
        </div>

        <div class="menu-form-section">
            <div class="menu-form-section-title">
                Availability
            </div>

            <div class="menu-form-section-copy">
                Control whether customers can currently order this item.
            </div>

            <label class="admin-checkbox-row">
                <input asp-for="Item.IsAvailable"
       type="checkbox" />

                <span class="admin-checkbox-copy">
                    <span class="admin-checkbox-title">
                        Available for ordering
                    </span>

                    <span class="admin-checkbox-help">
                        Clear this option instead of deleting an item that
                        is temporarily unavailable.
                    </span>
                </span>
            </label>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Save Changes
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const input =
                document.getElementById("imageInput");

            const preview =
                document.getElementById("preview");

            let previewUrl = null;

            const clearPreview = () => {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                preview?.removeAttribute("src");
                preview?.classList.remove("visible");
            };

            input?.addEventListener("change", () => {
                clearPreview();

                const file = input.files?.[0];

                if (!file || !preview) {
                    return;
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                preview.classList.add("visible");
            });

            window.addEventListener("beforeunload", () => {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }
            });
        })();
    </script>
}