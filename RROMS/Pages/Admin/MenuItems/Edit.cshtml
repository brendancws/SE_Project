@page
@model RROMS.Pages.Admin.MenuItems.EditModel
@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "_AdminLayout";
}

<h1>Edit Menu Item</h1>
<p class="subtitle">Update item details.</p>

<div class="card" style="max-width:560px;">
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Item.Id" />
        <input type="hidden" asp-for="Item.ImageUrl" />

        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Name *</label>
            <input asp-for="Item.Name" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Item.Name" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Description</label>
            <textarea asp-for="Item.Description" rows="3" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;"></textarea>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Price (RM) *</label>
            <input asp-for="Item.Price" type="number" step="0.01" min="0.01" style="width:140px; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Item.Price" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Category *</label>
            <select asp-for="Item.MenuCategoryId" asp-items="Model.CategoryOptions" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;">
                <option value="">-- Select a category --</option>
            </select>
            <span asp-validation-for="Item.MenuCategoryId" style="color:#dc2626; font-size:12px;"></span>
        </div>

        <!-- Current image -->
        @if (!string.IsNullOrEmpty(Model.Item.ImageUrl))
        {
            <div style="margin-bottom:16px;">
                <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Current Photo</label>
                <img src="@Model.Item.ImageUrl" alt="current" style="max-width:200px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);" />
            </div>
        }

        <!-- Upload new image -->
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Replace Photo</label>
            <input asp-for="ImageFile" type="file" accept="image/*" id="imageInput"
                   style="width:100%; padding:8px; border:1px dashed #cbd5e1; border-radius:8px; background:#f8fafc;" />
            <span asp-validation-for="ImageFile" style="color:#dc2626; font-size:12px;"></span>
            <div style="font-size:12px; color:#94a3b8; margin-top:4px;">JPG, PNG, GIF, or WEBP. Max 2MB. Leave empty to keep current photo.</div>
            <img id="preview" src="" alt="" style="display:none; margin-top:12px; max-width:200px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);" />
        </div>

        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Available</label>
            <input asp-for="Item.IsAvailable" type="checkbox" />
        </div>

        <button type="submit" style="background:#f59e0b; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Save Changes</button>
        <a href="/Admin/MenuItems" style="margin-left:10px; color:#64748b; text-decoration:none;">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            const preview = document.getElementById('preview');
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            }
        });
    </script>
}