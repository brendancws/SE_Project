@page
@model RROMS.Pages.Admin.MenuItems.DeleteModel
@{
    ViewData["Title"] = "Delete Menu Item";
    Layout = "_AdminLayout";
}

<h1>Delete Menu Item</h1>
<p class="subtitle">
    Review the menu item before continuing.
</p>

<div class="card" style="max-width:560px;">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div style="margin-bottom:20px; padding:12px 14px; border-radius:8px; background:#fee2e2; color:#991b1b;">
            @Model.ErrorMessage
        </div>
    }

    <p style="margin-bottom:10px;">
        <strong>Name:</strong> @Model.Item.Name
    </p>

    <p style="margin-bottom:10px;">
        <strong>Category:</strong>
        @(Model.Item.Category?.CategoryName ?? "—")
    </p>

    <p style="margin-bottom:10px;">
        <strong>Price:</strong>
        RM @Model.Item.Price.ToString("F2")
    </p>

    @if (Model.HasOrderHistory)
    {
        <div style="margin-top:20px; padding:14px; border-radius:8px; background:#fef3c7; color:#92400e;">
            <strong>This item has order history.</strong>
            <div style="margin-top:5px; line-height:1.5;">
                Deleting it would damage historical order records.
                Edit the item and mark it as unavailable instead.
            </div>
        </div>

        <div style="margin-top:20px;">
            <a asp-page="./Edit"
               asp-route-id="@Model.Item.MenuItemID"
               style="display:inline-block; padding:10px 18px; border-radius:8px; background:#f59e0b; color:#fff; font-weight:600; text-decoration:none;">
                Edit Item
            </a>

            <a asp-page="./Index"
               style="margin-left:10px; color:#64748b; text-decoration:none;">
                Back to Menu Items
            </a>
        </div>
    }
    else
    {
        <div style="margin-top:20px; padding:14px; border-radius:8px; background:#fee2e2; color:#991b1b;">
            This action permanently deletes the menu item and cannot be undone.
        </div>

        <form method="post" style="margin-top:20px;">
            <input type="hidden"
                   asp-for="Item.MenuItemID" />

            <button type="submit"
                    style="padding:10px 20px; border:none; border-radius:8px; background:#dc2626; color:#fff; cursor:pointer; font-weight:600;">
                Yes, Delete
            </button>

            <a asp-page="./Index"
               style="margin-left:10px; color:#64748b; text-decoration:none;">
                Cancel
            </a>
        </form>
    }
</div>