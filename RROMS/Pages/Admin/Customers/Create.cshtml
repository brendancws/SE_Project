@page
@model RROMS.Pages.Admin.Customers.CreateModel

@{
    ViewData["Title"] = "Add Customer";
    Layout = "_AdminLayout";
}

<h1>Add Customer</h1>

<p class="subtitle">
    Register a new customer account.
</p>

<section class="card admin-form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Customer details
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Name"
                       class="admin-label">
                    Full Name *
                </label>

                <input asp-for="Customer.Name"
                       class="admin-input"
                       maxlength="100"
                       autocomplete="name" />

                <span asp-validation-for="Customer.Name"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Email"
                       class="admin-label">
                    Email *
                </label>

                <input asp-for="Customer.Email"
                       class="admin-input"
                       type="email"
                       maxlength="150"
                       placeholder="name@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Customer.Email"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Phone"
                       class="admin-label">
                    Phone *
                </label>

                <input asp-for="Customer.Phone"
                       class="admin-input"
                       maxlength="30"
                       placeholder="012-3456789"
                       autocomplete="tel" />

                <span asp-validation-for="Customer.Phone"
                      class="admin-validation">
                </span>
            </div>
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Account access
            </div>

            <div class="admin-form-group">
                <label asp-for="Password"
                       class="admin-label">
                    Password *
                </label>

                <input asp-for="Password"
                       class="admin-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="At least 8 characters" />

                <div class="admin-help-text">
                    Must include uppercase, lowercase, and a number.
                </div>

                <span asp-validation-for="Password"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label class="admin-label">
                    Account Status
                </label>

                <label class="admin-checkbox-row">
                    <input asp-for="Customer.IsActive"
                           type="checkbox"
                           checked />

                    <span class="admin-checkbox-copy">
                        <span class="admin-checkbox-title">
                            Active customer account
                        </span>

                        <span class="admin-checkbox-help">
                            Active customers can access the customer portal.
                        </span>
                    </span>
                </label>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Create Customer Account
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}