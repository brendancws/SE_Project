@page
@model RROMS.Pages.Admin.Customers.EditModel
@{
    ViewData["Title"] = "Edit Customer";
    Layout = "_AdminLayout";
}

<h1>Edit Customer</h1>
<p class="subtitle">Update customer details.</p>

<div class="card" style="max-width:560px;">
    <form method="post">
        <input type="hidden" asp-for="Customer.Id" />
        <input type="hidden" asp-for="Customer.PasswordHash" />
        <input type="hidden" asp-for="Customer.CreatedAt" />

        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Full Name *</label>
            <input asp-for="Customer.FullName" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Customer.FullName" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Email *</label>
            <input asp-for="Customer.Email" type="email" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Customer.Email" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Phone *</label>
            <input asp-for="Customer.Phone" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Customer.Phone" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Active</label>
            <input asp-for="Customer.IsActive" type="checkbox" />
        </div>

        <button type="submit" style="background:#f59e0b; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Save Changes</button>
        <a href="/Admin/Customers" style="margin-left:10px; color:#64748b; text-decoration:none;">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}