@page
@model RROMS.Pages.Admin.Customers.EditModel

@{
    ViewData["Title"] = "Edit Customer";
    Layout = "_AdminLayout";
}

<h1>Edit Customer</h1>

<p class="subtitle">
    Update customer contact information and account access.
</p>

<section class="card admin-form-card">
    <form method="post">
        <input type="hidden"
               asp-for="Customer.CustomerID" />

        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Customer details
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Name"
                       class="admin-label">
                    Full Name *
                </label>

                <input asp-for="Customer.Name"
                       class="admin-input"
                       maxlength="100"
                       autocomplete="name" />

                <span asp-validation-for="Customer.Name"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Email"
                       class="admin-label">
                    Email *
                </label>

                <input asp-for="Customer.Email"
                       class="admin-input"
                       type="email"
                       maxlength="150"
                       autocomplete="email" />

                <span asp-validation-for="Customer.Email"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Customer.Phone"
                       class="admin-label">
                    Phone *
                </label>

                <input asp-for="Customer.Phone"
                       class="admin-input"
                       maxlength="30"
                       autocomplete="tel" />

                <span asp-validation-for="Customer.Phone"
                      class="admin-validation">
                </span>
            </div>
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Account access
            </div>

            <div class="admin-form-group">
                <label class="admin-label">
                    Account Status
                </label>

                <label class="admin-checkbox-row">
                    <input asp-for="Customer.IsActive"
                           type="checkbox" />

                    <span class="admin-checkbox-copy">
                        <span class="admin-checkbox-title">
                            Active customer account
                        </span>

                        <span class="admin-checkbox-help">
                            Clear this option to prevent customer portal access.
                        </span>
                    </span>
                </label>
            </div>

            <div class="admin-alert admin-alert-warning">
                The customer password is not changed from this form.
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Save Changes
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}