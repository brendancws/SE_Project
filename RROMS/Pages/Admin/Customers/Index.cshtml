@page
@model RROMS.Pages.Admin.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
    Layout = "_AdminLayout";
}

<h1>Customer Accounts</h1>
<p class="subtitle">Manage customer accounts and access.</p>

<div class="card">
    <a href="/Admin/Customers/Create" style="display:inline-block; background:#f59e0b; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:600; margin-bottom:20px;">+ Add Customer</a>

    @if (Model.Customers.Count == 0)
    {
        <p style="color:#64748b;">No customers yet.</p>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="text-align:left; border-bottom:2px solid #e2e8f0; color:#475569; font-size:13px;">
                    <th style="padding:10px 8px;">Name</th>
                    <th style="padding:10px 8px;">Email</th>
                    <th style="padding:10px 8px;">Phone</th>
                    <th style="padding:10px 8px;">Status</th>
                    <th style="padding:10px 8px;">Joined</th>
                    <th style="padding:10px 8px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 8px; font-weight:600;">@c.FullName</td>
                        <td style="padding:12px 8px; color:#475569;">@c.Email</td>
                        <td style="padding:12px 8px; color:#475569;">@c.Phone</td>
                        <td style="padding:12px 8px;">
                            @if (c.IsActive)
                            {
                                <span style="background:#dcfce7; color:#166534; padding:3px 10px; border-radius:20px; font-size:12px;">Active</span>
                            }
                            else
                            {
                                <span style="background:#fee2e2; color:#991b1b; padding:3px 10px; border-radius:20px; font-size:12px;">Inactive</span>
                            }
                        </td>
                        <td style="padding:12px 8px; color:#475569; font-size:13px;">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td style="padding:12px 8px; text-align:right;">
                            <a href="/Admin/Customers/Edit?id=@c.Id" style="color:#0284c7; text-decoration:none; margin-right:10px;">Edit</a>
                            <a href="/Admin/Customers/Delete?id=@c.Id" style="color:#dc2626; text-decoration:none;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>