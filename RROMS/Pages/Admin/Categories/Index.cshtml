@page
@model RROMS.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Menu Categories";
    Layout = "_AdminLayout";
}

<style>
    .category-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .category-add-button,
    .category-search-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 9px 16px;
        border: 0;
        border-radius: 8px;
        background: #f59e0b;
        color: #ffffff;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .category-add-button:hover,
    .category-search-button:hover {
        background: #d97706;
    }

    .category-result-count {
        color: #64748b;
        font-size: 13px;
    }

    .category-search-form {
        display: flex;
        align-items: end;
        gap: 8px;
        max-width: 600px;
        margin-bottom: 20px;
        padding: 16px;
        border-radius: 10px;
        background: #f8fafc;
    }

    .category-search-field {
        flex: 1;
    }

    .category-search-field label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .category-search-field input {
        width: 100%;
        min-height: 38px;
        padding: 8px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        color: #0f172a;
        font: inherit;
        font-size: 13px;
        outline: none;
    }

    .category-search-field input:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .category-reset-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 9px 16px;
        border-radius: 8px;
        background: #e2e8f0;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .category-reset-button:hover {
        background: #cbd5e1;
    }

    .category-table-wrapper {
        overflow-x: auto;
    }

    .category-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

    .category-table th {
        padding: 10px 8px;
        border-bottom: 2px solid #e2e8f0;
        color: #475569;
        font-size: 13px;
        text-align: left;
    }

    .category-table td {
        padding: 12px 8px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .category-table tbody tr:hover {
        background: #f8fafc;
    }

    .category-name {
        color: #0f172a;
        font-weight: 700;
    }

    .category-description {
        color: #475569;
    }

    .category-count {
        display: inline-flex;
        min-width: 34px;
        justify-content: center;
        padding: 3px 10px;
        border-radius: 20px;
        background: #e0f2fe;
        color: #075985;
        font-size: 12px;
        font-weight: 700;
    }


    .category-empty {
        padding: 32px 12px;
        color: #64748b;
        text-align: center;
    }

    .category-empty strong {
        display: block;
        margin-bottom: 5px;
        color: #334155;
    }

    @@media (max-width: 650px) {
        .category-toolbar,
        .category-search-form {
            align-items: stretch;
            flex-direction: column;
        }

        .category-add-button,
        .category-search-button,
        .category-reset-button {
            width: 100%;
        }
    }
</style>

<h1>Menu Categories</h1>

<p class="subtitle">
    Organize menu items into clear customer-facing categories.
</p>

<div class="card">
    <div class="category-toolbar">
        <a asp-page="./Create"
           class="category-add-button">
            + Add Category
        </a>

        <div class="category-result-count">
            @if (Model.TotalResults == 1)
            {
                <span>1 category</span>
            }
            else
            {
                <span>@Model.TotalResults categories</span>
            }
        </div>
    </div>

    <form method="get" class="category-search-form">
        <div class="category-search-field">
            <label for="category-search">
                Search
            </label>

            <input id="category-search"
                   type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Search name or description"
                   autocomplete="off" />
        </div>

        <button type="submit"
                class="category-search-button">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="./Index"
               class="category-reset-button">
                Clear
            </a>
        }
    </form>

    @if (Model.Categories.Count == 0)
    {
        <div class="category-empty">
            <strong>No categories found.</strong>
            Try changing the search text.
        </div>
    }
    else
    {
        <div class="category-table-wrapper">
            <table class="category-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Menu Items</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td class="category-name">
                                @category.CategoryName
                            </td>

                            <td class="category-description">
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "No description"
                                    : category.Description)
                            </td>

                            <td>
                                <span class="category-count">
                                    @category.MenuItemCount
                                </span>
                            </td>

                            <td>
    <div class="admin-row-actions">
        <a asp-page="./Edit"
           asp-route-id="@category.CategoryID"
           class="admin-action-button admin-action-button-edit">
            Edit
        </a>

        <a asp-page="./Delete"
           asp-route-id="@category.CategoryID"
           class="admin-action-button admin-action-button-delete">
            Delete
        </a>
    </div>
</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>