@page
@model RROMS.Pages.Admin.Categories.CreateModel

@{
    ViewData["Title"] = "Add Category";
    Layout = "_AdminLayout";
}

<h1>Add Menu Category</h1>

<p class="subtitle">
    Create a new category for your menu.
</p>

<section class="card admin-form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="admin-form-group">
            <label asp-for="Category.CategoryName"
                   class="admin-label">
                Name *
            </label>

            <input asp-for="Category.CategoryName"
                   class="admin-input"
                   required
                   maxlength="100"
                   autocomplete="off"
                   placeholder="e.g. Desserts" />

            <span asp-validation-for="Category.CategoryName"
                  class="admin-validation">
            </span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Category.Description"
                   class="admin-label">
                Description
            </label>

            <textarea asp-for="Category.Description"
                      class="admin-textarea"
                      rows="4"
                      maxlength="500"
                      placeholder="Briefly describe the types of menu items in this category."></textarea>

            <span asp-validation-for="Category.Description"
                  class="admin-validation">
            </span>

            <div class="admin-help-text">
                Maximum 500 characters.
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Create Category
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}