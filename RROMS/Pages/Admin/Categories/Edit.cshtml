@page
@model RROMS.Pages.Admin.Categories.EditModel

@{
    ViewData["Title"] = "Edit Category";
    Layout = "_AdminLayout";
}

<h1>Edit Menu Category</h1>

<p class="subtitle">
    Update the category name and description.
</p>

<section class="card admin-form-card">
    <form method="post">
        <input type="hidden"
               asp-for="Category.CategoryID" />

        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="admin-form-group">
            <label asp-for="Category.CategoryName"
                   class="admin-label">
                Name *
            </label>

            <input asp-for="Category.CategoryName"
                   class="admin-input"
                   required
                   maxlength="100"
                   autocomplete="off" />

            <span asp-validation-for="Category.CategoryName"
                  class="admin-validation">
            </span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Category.Description"
                   class="admin-label">
                Description
            </label>

            <textarea asp-for="Category.Description"
                      class="admin-textarea"
                      rows="4"
                      maxlength="500"></textarea>

            <span asp-validation-for="Category.Description"
                  class="admin-validation">
            </span>

            <div class="admin-help-text">
                Maximum 500 characters.
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Save Changes
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}