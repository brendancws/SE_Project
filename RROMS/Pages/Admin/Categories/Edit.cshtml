@page
@model RROMS.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
    Layout = "_AdminLayout";
}

<h1>Edit Menu Category</h1>

<p class="subtitle">
    Update the category name and description.
</p>

<div class="card" style="max-width:560px;">
    <form method="post">
        <input type="hidden"
               asp-for="Category.CategoryID" />

        <div asp-validation-summary="ModelOnly"
             style="margin-bottom:16px; color:#b91c1c;">
        </div>

        <div style="margin-bottom:16px;">
            <label asp-for="Category.CategoryName"
                   style="display:block; margin-bottom:6px; color:#334155; font-size:13px; font-weight:600;">
                Name *
            </label>

            <input asp-for="Category.CategoryName"
                   required
                   maxlength="100"
                   autocomplete="off"
                   style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />

            <span asp-validation-for="Category.CategoryName"
                  style="display:block; margin-top:5px; color:#b91c1c; font-size:12px;">
            </span>
        </div>

        <div style="margin-bottom:20px;">
            <label asp-for="Category.Description"
                   style="display:block; margin-bottom:6px; color:#334155; font-size:13px; font-weight:600;">
                Description
            </label>

            <textarea asp-for="Category.Description"
                      rows="3"
                      maxlength="500"
                      style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px; resize:vertical;"></textarea>

            <span asp-validation-for="Category.Description"
                  style="display:block; margin-top:5px; color:#b91c1c; font-size:12px;">
            </span>
        </div>

        <button type="submit"
                style="padding:10px 20px; border:none; border-radius:8px; background:#f59e0b; color:#fff; cursor:pointer; font-weight:600;">
            Save Changes
        </button>

        <a asp-page="./Index"
           style="margin-left:10px; color:#64748b; text-decoration:none;">
            Cancel
        </a>
    </form>
</div>