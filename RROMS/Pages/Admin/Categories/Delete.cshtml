@page
@model RROMS.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    Layout = "_AdminLayout";
}

<h1>Delete Menu Category</h1>
<p class="subtitle">Are you sure you want to delete this category?</p>

<div class="card" style="max-width:560px;">
    <p><strong>Name:</strong> @Model.Category.Name</p>
    <p><strong>Description:</strong> @Model.Category.Description</p>

    <form method="post" style="margin-top:20px;">
        <input type="hidden" asp-for="Category.Id" />
        <button type="submit" style="background:#dc2626; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Yes, Delete</button>
        <a href="/Admin/Categories" style="margin-left:10px; color:#64748b; text-decoration:none;">Cancel</a>
    </form>
</div>