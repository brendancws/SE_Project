@page
@model RROMS.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    Layout = "_AdminLayout";
}

<h1>Delete Menu Category</h1>

<p class="subtitle">
    Review the category before continuing.
</p>

<div class="card" style="max-width:560px;">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div style="margin-bottom:20px; padding:12px 14px; border-radius:8px; background:#fee2e2; color:#991b1b;">
            @Model.ErrorMessage
        </div>
    }

    <p style="margin-bottom:10px;">
        <strong>Name:</strong>
        @Model.Category.CategoryName
    </p>

    <p style="margin-bottom:10px;">
        <strong>Description:</strong>
        @(string.IsNullOrWhiteSpace(Model.Category.Description)
            ? "No description"
            : Model.Category.Description)
    </p>

    <p style="margin-bottom:10px;">
        <strong>Menu Items:</strong>
        @Model.MenuItemCount
    </p>

    @if (Model.MenuItemCount > 0)
    {
        <div style="margin-top:20px; padding:14px; border-radius:8px; background:#fef3c7; color:#92400e;">
            <strong>This category is currently in use.</strong>

            <div style="margin-top:5px; line-height:1.5;">
                Move or delete its @Model.MenuItemCount menu item(s)
                before deleting this category.
            </div>
        </div>

        <div style="margin-top:20px;">
            <a asp-page="./Index"
               style="color:#64748b; text-decoration:none;">
                Back to Menu Categories
            </a>
        </div>
    }
    else
    {
        <div style="margin-top:20px; padding:14px; border-radius:8px; background:#fee2e2; color:#991b1b;">
            This action permanently deletes the category and cannot be undone.
        </div>

        <form method="post" style="margin-top:20px;">
            <input type="hidden"
                   asp-for="Category.CategoryID" />

            <button type="submit"
                    style="padding:10px 20px; border:none; border-radius:8px; background:#dc2626; color:#fff; cursor:pointer; font-weight:600;">
                Yes, Delete
            </button>

            <a asp-page="./Index"
               style="margin-left:10px; color:#64748b; text-decoration:none;">
                Cancel
            </a>
        </form>
    }
</div>