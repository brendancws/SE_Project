@page
@model RROMS.Pages.Admin.Tables.DeleteModel

@{
    ViewData["Title"] = "Delete Table";
    Layout = "_AdminLayout";
}

<h1>Delete Restaurant Table</h1>

<p class="subtitle">
    Review the table and its reservation history before continuing.
</p>

<section class="card admin-form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="admin-alert admin-alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <div class="admin-record-details">
        <div class="admin-record-detail">
            <div class="admin-record-label">Table</div>
            <div>@Model.Table.TableNumber</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Capacity</div>
            <div>@Model.Table.Capacity seat(s)</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Location</div>
            <div>
                @(string.IsNullOrWhiteSpace(Model.Table.Location)
                    ? "Not specified"
                    : Model.Table.Location)
            </div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Reservations</div>
            <div>@Model.ReservationCount record(s)</div>
        </div>
    </div>

    @if (Model.ReservationCount > 0)
    {
        <div class="admin-warning-zone">
            <strong>This table is referenced by reservation history.</strong>

            <div style="margin-top:5px;">
                Deleting the table would damage existing reservation
                records. Edit the table and mark it unavailable instead.
            </div>
        </div>

        <div class="admin-form-actions">
            <a asp-page="./Edit"
               asp-route-id="@Model.Table.TableID"
               class="admin-button admin-button-primary">
                Edit Table
            </a>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Back to Tables
            </a>
        </div>
    }
    else
    {
        <div class="admin-danger-zone">
            This action permanently deletes the restaurant table and
            cannot be undone.
        </div>

        <form method="post">
            <input type="hidden"
                   asp-for="Table.TableID" />

            <div class="admin-form-actions">
                <button type="submit"
                        class="admin-button admin-button-danger">
                    Yes, Delete
                </button>

                <a asp-page="./Index"
                   class="admin-button admin-button-secondary">
                    Cancel
                </a>
            </div>
        </form>
    }
</section>