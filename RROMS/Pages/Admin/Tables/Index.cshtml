@page
@model RROMS.Pages.Admin.Tables.IndexModel
@{
    ViewData["Title"] = "Tables";
    Layout = "_AdminLayout";
}

<h1>Restaurant Tables</h1>
<p class="subtitle">Manage your dining tables and their capacities.</p>

<div class="card">
    <a href="/Admin/Tables/Create" style="display:inline-block; background:#f59e0b; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:600; margin-bottom:20px;">+ Add Table</a>

    @if (Model.Tables.Count == 0)
    {
        <p style="color:#64748b;">No tables yet. Add your first one.</p>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="text-align:left; border-bottom:2px solid #e2e8f0; color:#475569; font-size:13px;">
                    <th style="padding:10px 8px;">Table #</th>
                    <th style="padding:10px 8px;">Capacity</th>
                    <th style="padding:10px 8px;">Location</th>
                    <th style="padding:10px 8px;">Status</th>
                    <th style="padding:10px 8px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tables)
                {
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 8px; font-weight:600;">@t.TableNumber</td>
                        <td style="padding:12px 8px;">@t.Capacity seats</td>
                        <td style="padding:12px 8px; color:#475569;">@t.Location</td>
                        <td style="padding:12px 8px;">
                            @if (t.IsAvailable)
                            {
                                <span style="background:#dcfce7; color:#166534; padding:3px 10px; border-radius:20px; font-size:12px;">Available</span>
                            }
                            else
                            {
                                <span style="background:#fee2e2; color:#991b1b; padding:3px 10px; border-radius:20px; font-size:12px;">Unavailable</span>
                            }
                        </td>
                        <td style="padding:12px 8px; text-align:right;">
                            <a href="/Admin/Tables/Edit?id=@t.Id" style="color:#0284c7; text-decoration:none; margin-right:10px;">Edit</a>
                            <a href="/Admin/Tables/Delete?id=@t.Id" style="color:#dc2626; text-decoration:none;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>