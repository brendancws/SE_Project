@page
@model RROMS.Pages.Admin.Tables.IndexModel

@{
    ViewData["Title"] = "Tables";
    Layout = "_AdminLayout";
}

<header class="admin-page-header">
    <div>
        <h1>Restaurant Tables</h1>

        <p class="subtitle">
            Manage dining capacity, location, and table availability.
        </p>
    </div>

    <a asp-page="./Create"
       class="admin-button admin-button-primary">
        + Add Table
    </a>
</header>

<section class="admin-summary-grid"
         aria-label="Restaurant table summary">
    <div class="card admin-summary-card">
        <div class="admin-summary-label">
            Total Tables
        </div>

        <div class="admin-summary-value">
            @Model.TotalTables
        </div>
    </div>

    <div class="card admin-summary-card">
        <div class="admin-summary-label">
            Available
        </div>

        <div class="admin-summary-value success">
            @Model.AvailableTables
        </div>
    </div>

    <div class="card admin-summary-card">
        <div class="admin-summary-label">
            Unavailable
        </div>

        <div class="admin-summary-value danger">
            @Model.UnavailableTables
        </div>
    </div>

    <div class="card admin-summary-card">
        <div class="admin-summary-label">
            Total Seating Capacity
        </div>

        <div class="admin-summary-value">
            @Model.TotalSeats
        </div>
    </div>
</section>

<section class="card">
    @if (Model.Tables.Count == 0)
    {
        <div class="admin-empty-state">
            <div class="admin-empty-title">
                No restaurant tables found
            </div>

            <div>
                Add the first table to begin managing dining capacity.
            </div>
        </div>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Table</th>
                        <th>Capacity</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var table in Model.Tables)
                    {
                        <tr>
                            <td>
                                <strong>@table.TableNumber</strong>
                            </td>

                            <td>
                                @table.Capacity seat(s)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(table.Location)
                                    ? "Not specified"
                                    : table.Location)
                            </td>

                            <td>
                                @if (table.IsAvailable)
                                {
                                    <span class="admin-badge admin-badge-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-danger">
                                        Unavailable
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="admin-row-actions">
                                    <a asp-page="./Edit"
                                       asp-route-id="@table.TableID"
                                       class="admin-action-button admin-action-button-edit">
                                        Edit
                                    </a>

                                    <a asp-page="./Delete"
                                       asp-route-id="@table.TableID"
                                       class="admin-action-button admin-action-button-delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>