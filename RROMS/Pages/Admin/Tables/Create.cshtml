@page
@model RROMS.Pages.Admin.Tables.CreateModel

@{
    ViewData["Title"] = "Add Table";
    Layout = "_AdminLayout";
}

<h1>Add Restaurant Table</h1>

<p class="subtitle">
    Register a dining table and its seating details.
</p>

<section class="card admin-form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="admin-form-group">
            <label asp-for="Table.TableNumber"
                   class="admin-label">
                Table Number *
            </label>

            <input asp-for="Table.TableNumber"
                   class="admin-input"
                   maxlength="20"
                   placeholder="e.g. T1, A5 or VIP-1"
                   autocomplete="off" />

            <span asp-validation-for="Table.TableNumber"
                  class="admin-validation">
            </span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Table.Capacity"
                   class="admin-label">
                Capacity *
            </label>

            <input asp-for="Table.Capacity"
                   class="admin-input"
                   type="number"
                   min="1"
                   max="50"
                   style="max-width:180px;" />

            <div class="admin-help-text">
                Enter a seating capacity between 1 and 50.
            </div>

            <span asp-validation-for="Table.Capacity"
                  class="admin-validation">
            </span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Table.Location"
                   class="admin-label">
                Location
            </label>

            <input asp-for="Table.Location"
                   class="admin-input"
                   maxlength="100"
                   placeholder="e.g. Indoor, Window, Patio or Private room" />

            <span asp-validation-for="Table.Location"
                  class="admin-validation">
            </span>
        </div>

        <div class="admin-form-group">
            <label class="admin-label">
                Availability
            </label>

            <label class="admin-checkbox-row">
                <input asp-for="Table.IsAvailable"
                       type="checkbox" />

                <span class="admin-checkbox-copy">
                    <span class="admin-checkbox-title">
                        Available for reservations
                    </span>

                    <span class="admin-checkbox-help">
                        Clear this option when the table is temporarily
                        unavailable.
                    </span>
                </span>
            </label>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Save Table
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>