@page
@model RROMS.Pages.Admin.Staff.EditModel

@{
    ViewData["Title"] = "Edit Staff";
    Layout = "_AdminLayout";
}

<h1>Edit Staff Member</h1>

<p class="subtitle">
    Update Staff contact information and account access.
</p>

<section class="card admin-form-card">
    <form method="post">
        <input asp-for="Input.StaffID"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Contact details
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Name"
                       class="admin-label">
                    Full Name *
                </label>

                <input asp-for="Input.Name"
                       class="admin-input"
                       maxlength="100"
                       autocomplete="name" />

                <span asp-validation-for="Input.Name"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Email"
                       class="admin-label">
                    Email *
                </label>

                <input asp-for="Input.Email"
                       class="admin-input"
                       type="email"
                       maxlength="150"
                       autocomplete="email" />

                <span asp-validation-for="Input.Email"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Phone"
                       class="admin-label">
                    Phone
                </label>

                <input asp-for="Input.Phone"
                       class="admin-input"
                       maxlength="30"
                       autocomplete="tel" />

                <span asp-validation-for="Input.Phone"
                      class="admin-validation">
                </span>
            </div>
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Account access
            </div>

            <div class="admin-form-group">
                <label class="admin-label">
                    Role
                </label>

                <input type="text"
                       value="Staff"
                       class="admin-input admin-readonly"
                       disabled />

                <input asp-for="Input.Role"
                       type="hidden"
                       value="Staff" />
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Status"
                       class="admin-label">
                    Account Status
                </label>

                <select asp-for="Input.Status"
                        class="admin-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                <div class="admin-help-text">
                    Inactive Staff accounts should not be permitted to sign in.
                </div>
            </div>

            <div class="admin-alert admin-alert-warning">
                The Staff password is not changed from this form.
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Save Changes
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}