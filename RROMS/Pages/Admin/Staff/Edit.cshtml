@page
@model RROMS.Pages.Admin.Staff.EditModel
@{
    ViewData["Title"] = "Edit Staff";
    Layout = "_AdminLayout";
}

<h1>Edit Staff Member</h1>
<p class="subtitle">Update staff details or role.</p>

<div class="card" style="max-width:560px;">
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.PasswordHash" />
        <input type="hidden" asp-for="Input.CreatedAt" />

        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Full Name *</label>
            <input asp-for="Input.FullName" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Input.FullName" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Username *</label>
            <input asp-for="Input.Username" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Input.Username" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Email *</label>
            <input asp-for="Input.Email" type="email" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Input.Email" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Phone *</label>
            <input asp-for="Input.Phone" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;" />
            <span asp-validation-for="Input.Phone" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Role *</label>
            <select asp-for="Input.Role" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:8px;">
                <option value="Staff">Staff</option>
                <option value="Manager">Manager</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; color:#334155; margin-bottom:6px; font-weight:600;">Active</label>
            <input asp-for="Input.IsActive" type="checkbox" />
        </div>

        <button type="submit" style="background:#f59e0b; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Save Changes</button>
        <a href="/Admin/Staff" style="margin-left:10px; color:#64748b; text-decoration:none;">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}