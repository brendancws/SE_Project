@page
@model RROMS.Pages.Admin.Staff.IndexModel

@{
    ViewData["Title"] = "Staff";
    Layout = "_AdminLayout";
}

<header class="admin-page-header">
    <div>
        <h1>Staff Accounts</h1>

        <p class="subtitle">
            Manage restaurant Staff accounts and access status.
        </p>
    </div>

    <a asp-page="./Create"
       class="admin-button admin-button-primary">
        + Add Staff
    </a>
</header>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="admin-alert admin-alert-success">
        @statusMessage
    </div>
}

<section class="account-summary-grid"
         aria-label="Staff account summary">
    <div class="card account-summary-card">
        <div class="account-summary-label">
            Total Staff
        </div>

        <div class="account-summary-value">
            @(Model.ActiveCount + Model.InactiveCount)
        </div>
    </div>

    <div class="card account-summary-card">
        <div class="account-summary-label">
            Active
        </div>

        <div class="account-summary-value success">
            @Model.ActiveCount
        </div>
    </div>

    <div class="card account-summary-card">
        <div class="account-summary-label">
            Inactive
        </div>

        <div class="account-summary-value danger">
            @Model.InactiveCount
        </div>
    </div>
</section>

<section class="card">
    <form method="get" class="account-filter-form">
        <div class="account-filter-field">
            <label for="staff-search">
                Search
            </label>

            <input id="staff-search"
                   class="admin-input"
                   type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Name, email, or phone"
                   autocomplete="off" />
        </div>

        <div class="account-filter-field">
            <label for="staff-status">
                Account Status
            </label>

            <select id="staff-status"
                    class="admin-select"
                    name="status">
                <option value="all"
                        selected="@(Model.Status == "all")">
                    All statuses
                </option>

                <option value="active"
                        selected="@(Model.Status == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(Model.Status == "inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <button type="submit"
                class="admin-button admin-button-primary">
            Apply
        </button>

        <a asp-page="./Index"
           class="admin-button admin-button-secondary">
            Reset
        </a>
    </form>

    <div class="admin-toolbar">
        <div class="account-result-count">
            @if (Model.TotalResults == 1)
            {
                <span>1 Staff account found</span>
            }
            else
            {
                <span>@Model.TotalResults Staff accounts found</span>
            }
        </div>
    </div>

    @if (Model.StaffMembers.Count == 0)
    {
        <div class="admin-empty-state">
            <div class="admin-empty-title">
                No Staff accounts found
            </div>

            <div>
                Try changing the search text or status filter.
            </div>
        </div>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var staff in Model.StaffMembers)
                    {
                        bool isActive = string.Equals(
                            staff.Status,
                            "Active",
                            StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <strong>@staff.Name</strong>
                            </td>

                            <td class="account-contact">
                                @staff.Email
                            </td>

                            <td class="account-contact">
                                @(string.IsNullOrWhiteSpace(staff.Phone)
                                    ? "Not provided"
                                    : staff.Phone)
                            </td>

                            <td>
                                <span class="admin-badge admin-badge-info">
                                    @(staff.Role ?? "Staff")
                                </span>
                            </td>

                            <td>
                                @if (isActive)
                                {
                                    <span class="admin-badge admin-badge-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-danger">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="admin-row-actions">
                                    <a asp-page="./Edit"
                                       asp-route-id="@staff.StaffID"
                                       class="admin-action-button admin-action-button-edit">
                                        Edit
                                    </a>

                                    <a asp-page="./Delete"
                                       asp-route-id="@staff.StaffID"
                                       class="admin-action-button admin-action-button-delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>