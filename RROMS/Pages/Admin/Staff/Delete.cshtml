@page
@model RROMS.Pages.Admin.Staff.DeleteModel

@{
    ViewData["Title"] = "Delete Staff";
    Layout = "_AdminLayout";
}

<h1>Delete Staff Member</h1>

<p class="subtitle">
    Review the account and its order history before continuing.
</p>

<section class="card admin-form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="admin-alert admin-alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <div class="admin-record-details">
        <div class="admin-record-detail">
            <div class="admin-record-label">Name</div>
            <div>@Model.Input.Name</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Email</div>
            <div>@Model.Input.Email</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Phone</div>
            <div>
                @(string.IsNullOrWhiteSpace(Model.Input.Phone)
                    ? "Not provided"
                    : Model.Input.Phone)
            </div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Role</div>
            <div>@(Model.Input.Role ?? "Staff")</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Status</div>
            <div>@(Model.Input.Status ?? "Unknown")</div>
        </div>

        <div class="admin-record-detail">
            <div class="admin-record-label">Assigned Orders</div>
            <div>@Model.AssignedOrderCount record(s)</div>
        </div>
    </div>

    @if (Model.AssignedOrderCount > 0)
    {
        <div class="admin-warning-zone">
            <strong>This Staff account has order history.</strong>

            <div style="margin-top:5px;">
                Deleting the account would damage historical order records.
                Edit the account and set the status to Inactive instead.
            </div>
        </div>

        <div class="admin-form-actions">
            <a asp-page="./Edit"
               asp-route-id="@Model.Input.StaffID"
               class="admin-button admin-button-primary">
                Edit Staff Account
            </a>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Back to Staff
            </a>
        </div>
    }
    else
    {
        <div class="admin-danger-zone">
            This action permanently deletes the Staff account and cannot
            be undone. Use Inactive status when access only needs to be
            disabled.
        </div>

        <form method="post">
            <input asp-for="Input.StaffID"
                   type="hidden" />

            <div class="admin-form-actions">
                <button type="submit"
                        class="admin-button admin-button-danger">
                    Yes, Delete
                </button>

                <a asp-page="./Index"
                   class="admin-button admin-button-secondary">
                    Cancel
                </a>
            </div>
        </form>
    }
</section>