@page
@model RROMS.Pages.Admin.Staff.DeleteModel
@{
    ViewData["Title"] = "Delete Staff";
    Layout = "_AdminLayout";
}

<h1>Delete Staff Member</h1>
<p class="subtitle">Are you sure you want to delete this staff account?</p>

<div class="card" style="max-width:560px;">
    <p><strong>Name:</strong> @Model.Staff.FullName</p>
    <p><strong>Username:</strong> @Model.Staff.Username</p>
    <p><strong>Role:</strong> @Model.Staff.Role</p>

    <form method="post" style="margin-top:20px;">
        <input type="hidden" asp-for="Staff.Id" />
        <button type="submit" style="background:#dc2626; color:#fff; padding:10px 20px; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Yes, Delete</button>
        <a href="/Admin/Staff" style="margin-left:10px; color:#64748b; text-decoration:none;">Cancel</a>
    </form>
</div>