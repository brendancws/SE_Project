@page
@model RROMS.Pages.Admin.Staff.CreateModel

@{
    ViewData["Title"] = "Add Staff";
    Layout = "_AdminLayout";
}

<h1>Add Staff Member</h1>

<p class="subtitle">
    Create a Staff account for restaurant operations.
</p>

<section class="card admin-form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger">
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Contact details
            </div>

            <div class="account-form-section-copy">
                Enter the Staff member's identity and contact information.
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Name"
                       class="admin-label">
                    Full Name *
                </label>

                <input asp-for="Input.Name"
                       class="admin-input"
                       maxlength="100"
                       placeholder="e.g. John Doe"
                       autocomplete="name" />

                <span asp-validation-for="Input.Name"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Email"
                       class="admin-label">
                    Email *
                </label>

                <input asp-for="Input.Email"
                       class="admin-input"
                       type="email"
                       maxlength="150"
                       placeholder="name@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Input.Email"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Phone"
                       class="admin-label">
                    Phone
                </label>

                <input asp-for="Input.Phone"
                       class="admin-input"
                       maxlength="30"
                       placeholder="012-3456789"
                       autocomplete="tel" />

                <span asp-validation-for="Input.Phone"
                      class="admin-validation">
                </span>
            </div>
        </div>

        <div class="account-form-section">
            <div class="account-form-section-title">
                Account access
            </div>

            <div class="account-form-section-copy">
                Configure login credentials and account availability.
            </div>

            <div class="admin-form-group">
                <label asp-for="Password"
                       class="admin-label">
                    Password *
                </label>

                <input asp-for="Password"
                       class="admin-input"
                       type="password"
                       autocomplete="new-password"
                       placeholder="At least 8 characters" />

                <div class="admin-help-text">
                    Must include uppercase, lowercase, and a number.
                </div>

                <span asp-validation-for="Password"
                      class="admin-validation">
                </span>
            </div>

            <div class="admin-form-group">
                <label class="admin-label">
                    Role
                </label>

                <input type="text"
                       value="Staff"
                       class="admin-input admin-readonly"
                       disabled />

                <input asp-for="Input.Role"
                       type="hidden"
                       value="Staff" />

                <div class="admin-help-text">
                    Staff accounts are assigned the fixed Staff role.
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="Input.Status"
                       class="admin-label">
                    Account Status
                </label>

                <select asp-for="Input.Status"
                        class="admin-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit"
                    class="admin-button admin-button-primary">
                Create Staff Account
            </button>

            <a asp-page="./Index"
               class="admin-button admin-button-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
